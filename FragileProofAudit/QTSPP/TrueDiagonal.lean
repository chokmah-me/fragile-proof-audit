import FragileProofAudit.QTSPP.KoutschanOperator

/-!
# Identity (3.2): the true diagonal B(n,n) = 1

arXiv:0906.1018 §3: the true sequence `B(n,j)` is the normalized cofactor —
the cofactor of the `(n,j)` entry of the `n×n` Okada matrix, divided by the
`(n−1)×(n−1)` determinant — "normalized in a way such that the last entry
`B(n,n)` is 1". For the diagonal the sign `(-1)^{2n}` is `1`, so

  `B(n,n) = det(minor(n,n)) / det(A_{n-1}) = det(A_{n-1}) / det(A_{n-1}) = 1`,

since deleting the last row and column of `A_n` gives `A_{n-1}`
definitionally (`diagMinor_eq`). This module formalizes that argument:

* `trueDiag n` — the paper's `B(n+1,n+1)`, via the `(n+1,n+1)` minor;
* `trueDiag_eq_one_of_det_ne` — the normalization argument;
* `trueDiag_hinit` — the seven initial values `B(1,1) = … = B(7,7) = 1`,
  from seven inverse-matrix certificates verified by `decide`
  (certificates generated by exact rational arithmetic;
  see `~/workspace/qtspp/gen_inverse_certs.py`);
* `cert_hrec_of_diag_one` — hrec reduced: with the diagonal constantly `1`,
  any certified order-7 operator annihilates it by the right-factor telescope
  (`cert_annihilates_one`).

Position (2026-09-24): hinit is CLOSED in Lean. hrec for the true diagonal is
exactly `∀ n, (tsppMatrix n).det ≠ 0` — the content the norm identity
(3.3) delivers (`det = Nice(n)²`). The ∂-finite-substitution route for the
*guessed* sequence `B'` remains the multi-week infrastructure item
(`docs/blueprint/qtspp-q1.md` §6c); the finite-range computational replay
of hrec lives in `scripts/gates/qtspp_diagonal.py`.
-/

namespace FragileProofAudit.QTSPP

/-- The `(n+1,n+1)` minor of the `(n+1)×(n+1)` Okada matrix: delete the
    last row and column. -/
def diagMinor (n : ℕ) : Matrix (Fin n) (Fin n) ℚ :=
  (tsppMatrix (n + 1)).submatrix Fin.castSucc Fin.castSucc

/-- Deleting the last row/column of `A_{n+1}` recovers `A_n` — the entries
    line up definitionally via `tsppEntry`. -/
theorem diagMinor_eq (n : ℕ) : diagMinor n = tsppMatrix n := by
  ext i j
  simp [diagMinor, tsppMatrix, Matrix.submatrix_apply, Fin.coe_castSucc]

/-- The true diagonal: the paper's `B(n+1,n+1)`, the `(n+1,n+1)` cofactor
    normalized by `det(A_n)`. The sign `(-1)^{2(n+1)}` is `1`. -/
def trueDiag (n : ℕ) : ℚ :=
  (diagMinor n).det / (tsppMatrix n).det

/-- The normalization argument (§3): the diagonal is `1` wherever the
    denominator determinant is nonzero. -/
theorem trueDiag_eq_one_of_det_ne (n : ℕ) (h : (tsppMatrix n).det ≠ 0) :
    trueDiag n = 1 := by
  show (diagMinor n).det / (tsppMatrix n).det = 1
  rw [diagMinor_eq n, div_self h]

/-- An explicit inverse certifies `det ≠ 0`:
    `det(A) * det(B) = det(A*B) = det(1) = 1`. -/
theorem det_ne_zero_of_mul_eq_one {n : ℕ} (B : Matrix (Fin n) (Fin n) ℚ)
    (h : tsppMatrix n * B = 1) : (tsppMatrix n).det ≠ 0 := by
  intro hz
  have hdet := congrArg Matrix.det h
  rw [Matrix.det_mul, Matrix.det_one, hz, zero_mul] at hdet
  exact zero_ne_one hdet

/-- Inverse certificates `B_k` with `A_k * B_k = 1`, generated by
