theorem det_tsppMatrix_zero_ne : (tsppMatrix 0).det ≠ 0 := by
  rw [Matrix.det_fin_zero]
  exact one_ne_zero

/-- hinit: the seven initial values `B(1,1) = … = B(7,7) = 1`
    (paper §5.3: "Comparing initial values … establishes identity (3.2)"). -/
theorem trueDiag_hinit : ∀ i < 7, trueDiag i = 1 := by
  intro i hi
  interval_cases i
  · exact trueDiag_eq_one_of_det_ne 0 det_tsppMatrix_zero_ne
  · exact trueDiag_eq_one_of_det_ne 1 det_tsppMatrix_one_ne
  · exact trueDiag_eq_one_of_det_ne 2 det_tsppMatrix_two_ne
  · exact trueDiag_eq_one_of_det_ne 3 det_tsppMatrix_three_ne
  · exact trueDiag_eq_one_of_det_ne 4 det_tsppMatrix_four_ne
  · exact trueDiag_eq_one_of_det_ne 5 det_tsppMatrix_five_ne
  · exact trueDiag_eq_one_of_det_ne 6 det_tsppMatrix_six_ne

/-- hrec, reduced to its exact content: if the diagonal is constantly `1`,
    any certified order-7 operator annihilates it, by the right-factor
    telescope. For the true diagonal this makes hrec equivalent to
    `∀ n, det(A_n) ≠ 0`. -/
theorem cert_hrec_of_diag_one (cert : DiagonalCertificate) (d : ℕ → ℚ)
    (h1 : ∀ n, d n = 1) :
    ∀ nn, ∑ i ∈ Finset.range (7 + 1), cert.p i nn * d (nn + i) = 0 := by
  intro nn
  simp_rw [h1]
  exact cert_annihilates_one cert nn

/-- hrec for the true diagonal and Koutschan's operator, conditional on the
    determinant nonvanishing that (3.3) provides. -/
theorem trueDiag_hrec_of_det_ne (hdet : ∀ n, (tsppMatrix n).det ≠ 0) :
    ∀ nn, ∑ i ∈ Finset.range (7 + 1), koutschanP i nn * trueDiag (nn + i) = 0 :=
  cert_hrec_of_diag_one koutschanCertificate trueDiag
    (fun n => trueDiag_eq_one_of_det_ne n (hdet n))

/-- The full `B(n,n) = 1` for the true diagonal, conditional on the
    determinant nonvanishing. -/
theorem true_diagonal_of_det_ne (hdet : ∀ n, (tsppMatrix n).det ≠ 0) :
    trueDiag = fun _ => 1 :=
  funext fun n => trueDiag_eq_one_of_det_ne n (hdet n)

