module

public import CFSGCorollary.CFSGIndex
import CFSG.Certified.Classification

/-!
# Every finite simple group is generated by two elements

This file proves the statements of `Comparator/Challenge.lean`.

The `CFSGCorollary` library proves that every group on TauCeti's list of finite simple groups is
generated by two elements (`CFSGCorollary.twoGenerated_cfsgIndex`). Assuming the classification,
stated as TauCeti's `TauCeti.ClassificationStatement`, every finite simple group is isomorphic to
one of them, and two-generation transfers along the isomorphism. AxiomMath/CFSG's proof of the
classification, `CFSG.Certified.classification_finite_simple_groups`, then removes the hypothesis.
This file is the only place where that proof is imported, and `Checks.ImportBoundary` checks that
the conditional theorem does not use it.

The classification is assumed only in universe `0`; `TauCeti.classificationStatement_of_zero`
transfers it to every universe.

## Main results

* `CFSGCorollary.exists_closure_pair_eq_top_of_classification`: assuming the classification,
  every finite simple group is generated by two elements.
* `CFSGCorollary.exists_closure_pair_eq_top`: every finite simple group is generated by two
  elements.
-/

public section

universe u

namespace CFSGCorollary

/-- Assuming the classification of finite simple groups, every finite simple group is generated by
two elements. -/
theorem exists_closure_pair_eq_top_of_classification
    (hCFSG : TauCeti.ClassificationStatement.{0}) (G : Type u) [Group G] [Finite G]
    [IsSimpleGroup G] : ∃ a b : G, Subgroup.closure {a, b} = ⊤ := by
  obtain ⟨i, ⟨e⟩⟩ :=
    TauCeti.classificationStatement_iff.1 (TauCeti.classificationStatement_of_zero hCFSG) G
  have : Finite i.Group := Finite.of_equiv G e.toEquiv
  have : IsSimpleGroup i.Group := MulEquiv.isSimpleGroup e.symm
  exact twoGenerated_of_mulEquiv e (twoGenerated_cfsgIndex i)

/-- Every finite simple group is generated by two elements. -/
theorem exists_closure_pair_eq_top (G : Type u) [Group G] [Finite G] [IsSimpleGroup G] :
    ∃ a b : G, Subgroup.closure {a, b} = ⊤ :=
  exists_closure_pair_eq_top_of_classification
    (TauCeti.classificationStatement_iff.2 fun G _ _ _ ↦
      CFSG.Certified.classification_finite_simple_groups G) G

end CFSGCorollary

#print axioms CFSGCorollary.exists_closure_pair_eq_top_of_classification
#print axioms CFSGCorollary.exists_closure_pair_eq_top
