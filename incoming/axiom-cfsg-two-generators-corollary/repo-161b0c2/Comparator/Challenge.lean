module

public import TauCeti.GroupTheory.SpecificGroups.CFSG.Classification

/-!
# Finite simple groups are two-generated: statements to be proved

* `CFSGCorollary.exists_closure_pair_eq_top`: every finite simple group is generated by two
  elements.
* `CFSGCorollary.exists_closure_pair_eq_top_of_classification`: the same, assuming the
  classification of finite simple groups in the form of TauCeti's `ClassificationStatement`: every
  finite simple group is isomorphic to a group on TauCeti's list (cyclic of prime order,
  alternating, of Lie type, or sporadic).

`Comparator/Solution.lean` proves both.
-/

public section

universe u

namespace CFSGCorollary

/-- Every finite simple group is generated by two elements. -/
theorem exists_closure_pair_eq_top (G : Type u) [Group G] [Finite G] [IsSimpleGroup G] :
    ∃ a b : G, Subgroup.closure {a, b} = ⊤ :=
  sorry

/-- Assuming the classification of finite simple groups, every finite simple group is generated by
two elements. -/
theorem exists_closure_pair_eq_top_of_classification
    (hCFSG : TauCeti.ClassificationStatement.{0}) (G : Type u) [Group G] [Finite G]
    [IsSimpleGroup G] : ∃ a b : G, Subgroup.closure {a, b} = ⊤ :=
  sorry

end CFSGCorollary
