module

public import CFSGCorollary.TwoGenerated.Basic
public import TauCeti.GroupTheory.SpecificGroups.CFSG.Assembly.LieType
import CFSG.RankThree.PartOne.CTP.SeitzExcModels
import CFSG.Sporadic.Schreier.TitsOuter

/-!
# The Tits group is two-generated

`AxiomMath/CFSG` identifies TauCeti's Tits group `²F₄(2)′` with the permutation group
`CFSG.Sporadic.Schreier.Tits.titsD` on `1755` points, which is defined as the subgroup generated by
two explicit permutations. Hence it is two-generated.

## Main results

* `CFSGCorollary.twoGenerated_tits`: the Tits group is two-generated.
-/

@[expose] public section

open TauCeti CFSG.Sporadic.Schreier.Tits

namespace CFSGCorollary

/-- The Tits group `²F₄(2)′` is two-generated. -/
theorem twoGenerated_tits (hv : LieTypeIndex.tits.Valid)
    [Finite (ValidLieTypeIndex.Group ⟨LieTypeIndex.tits, hv⟩)]
    [IsSimpleGroup (ValidLieTypeIndex.Group ⟨LieTypeIndex.tits, hv⟩)] :
    TwoGenerated (ValidLieTypeIndex.Group ⟨LieTypeIndex.tits, hv⟩) := by
  have hiso : CFSG.RankThree.PartOne.Census3.IsoLie
      (ValidLieTypeIndex.Group ⟨LieTypeIndex.tits, hv⟩) LieTypeIndex.tits :=
    ⟨hv, ⟨MulEquiv.refl _⟩⟩
  obtain ⟨e⟩ := titsModelEquiv _ 2 1 (CFSG.RankThree.PartOne.CTP.reeTitsModel_tits hiso)
  refine twoGenerated_of_mulEquiv e <| twoGenerated_subgroup_of_closure_pair_eq titsD
    (titsDGen 0) (titsDGen 1) (Subgroup.subset_closure ⟨0, rfl⟩)
    (Subgroup.subset_closure ⟨1, rfl⟩) ?_
  change _ = Subgroup.closure (Set.range fun j : Fin 2 ↦ titsDGen j)
  congr 1
  ext x
  simp [Fin.exists_fin_two, eq_comm]

end CFSGCorollary
