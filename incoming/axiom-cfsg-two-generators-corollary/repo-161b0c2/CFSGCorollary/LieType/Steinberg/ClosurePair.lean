module

public import CFSGCorollary.LieType.Steinberg.Diagonal
public import CFSGCorollary.LieType.Steinberg.SimpleRootGroups
import CFSGCorollary.LieType.Steinberg.Commutator
import CFSGCorollary.LieType.Steinberg.GeneratingScalar

/-!
# Generating pairs from diagonal elements

This file proves Lemmas 3.9, 3.10 and 3.12 of [Steinberg1962], which produce a root group (and an
element `g`) inside the subgroup generated by a diagonal element `d` and a product of root
elements with `g`. These are the key steps in showing that groups of Lie type are generated by
two elements.

## Main results

* `CFSGCorollary.SteinbergSystem.rootElement_mem_of_isGeneratingScalar_of_rootScaling`:
  Lemma 3.9.
* `CFSGCorollary.SteinbergSystem.rootElement_mem_and_mem_closure_pair`: Lemma 3.10.
* `CFSGCorollary.SteinbergSystem.rootElement_mem_and_mem_closure_pair_of_commuting`: Lemma 3.12.
* `CFSGCorollary.SteinbergSystem.rootGroupIn_closure_diagonal_mul`,
  `CFSGCorollary.SteinbergSystem.rootGroupIn_closure_diagonal_mul_pair`: Lemmas 3.10 and 3.12
  for `⟨h_μ(k), x_γ(1) ω(L)⟩` and `⟨h_μ(k), x_r(1) x_s(1) ω(L)⟩`, in terms of cocharacter
  pairings.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary

namespace SteinbergSystem

open CFSG.LieType.RootSystem (roots)

private theorem one_sub_mul_one_sub_ne_zero {K : Type*} [Field K] {k l : Kˣ} (hk : k ≠ 1)
    (hl : l ≠ 1) : ((1 : K) - l) * (1 - k) ≠ 0 :=
  mul_ne_zero (sub_ne_zero.2 fun h ↦ hl (Units.val_eq_one.1 h.symm))
    (sub_ne_zero.2 fun h ↦ hk (Units.val_eq_one.1 h.symm))

variable {rank : ℕ} {cartan : Matrix (Fin rank) (Fin rank) ℤ}
  {finiteType : TauCeti.IsFiniteType cartan} {K G : Type*} [Field K] [Finite K] [Group G]

/-- [Steinberg1962, 3.9]: if `d ∈ F` acts on the root group `X_γ` by a generating scalar `k`
(a generator of `Kˣ` or the square of one) and `x γ l ∈ F` with `l ≠ 0`, then the whole root
group `X_γ` lies in `F`. -/
theorem rootElement_mem_of_isGeneratingScalar_of_rootScaling
    (system : SteinbergSystem cartan finiteType K G) (F : Subgroup G)
    {γ : Fin rank → ℤ} (hγ : γ ∈ roots finiteType ∅)
    {d : G} (hd : d ∈ F) {k : Kˣ} (hk : IsGeneratingScalar k)
    (hdk : RootScaling system.rootElement γ d (k : K))
    {l : K} (hl : l ≠ 0) (hxl : system.rootElement γ l ∈ F) (c : K) :
    system.rootElement γ c ∈ F := by
  let S : AddSubgroup K :=
    { carrier := {c | system.rootElement γ c ∈ F}
      zero_mem' := by
        change system.rootElement γ 0 ∈ F
        rw [system.rootElement_zero hγ]
        exact F.one_mem
      add_mem' := by
        intro a b ha hb
        change system.rootElement γ (a + b) ∈ F
        rw [system.rootElement_add γ hγ]
        exact F.mul_mem ha hb
      neg_mem' := by
        intro a ha
        change system.rootElement γ (-a) ∈ F
        rw [← system.rootElement_inv hγ]
        exact F.inv_mem ha }
  have key : ∀ j : ℕ, system.rootElement γ ((k : K) ^ j * l) ∈ F := by
    intro j
    induction j with
    | zero => simpa using hxl
    | succ j ih =>
      rw [pow_succ, mul_comm _ (k : K), mul_assoc, ← hdk]
      exact F.mul_mem (F.mul_mem hd ih) (F.inv_mem hd)
  exact hk.mem_of_pow_mul_mem S hl key c

/-- [Steinberg1962, 3.10]: let `d` and `d₁ = g d g⁻¹` be commuting diagonal elements acting on
`X_γ` by scalars `k ≠ 1` and `l ≠ 1`, where `k` is a generating scalar. Then the subgroup
generated by `d` and `x γ 1 * g` contains `X_γ` and `g`. -/
theorem rootElement_mem_and_mem_closure_pair
    (system : SteinbergSystem cartan finiteType K G)
    {γ : Fin rank → ℤ} (hγ : γ ∈ roots finiteType ∅)
    {g d d₁ : G} (hd₁ : g * d * g⁻¹ = d₁) (hcomm : Commute d d₁)
    {k l : Kˣ} (hk : IsGeneratingScalar k) (hk1 : k ≠ 1) (hl1 : l ≠ 1)
    (hdk : RootScaling system.rootElement γ d (k : K))
    (hdl : RootScaling system.rootElement γ d₁ (l : K)) :
    (∀ c : K, system.rootElement γ c ∈ Subgroup.closure {d, system.rootElement γ 1 * g}) ∧
      g ∈ Subgroup.closure {d, system.rootElement γ 1 * g} := by
  set F : Subgroup G := Subgroup.closure {d, system.rootElement γ 1 * g}
  have hdF : d ∈ F := Subgroup.subset_closure (by simp)
  have hyF : system.rootElement γ 1 * g ∈ F := Subgroup.subset_closure (by simp)
  have hcom := commutator_conj_rootElement_eq (system.rootElement_add γ hγ) (h := g) (d := d)
    (d₁ := d₁) (d' := d) hd₁ hcomm.symm hdl hdk
  have hmem : system.rootElement γ (((1 : K) - l) * (1 - k)) ∈ F := by
    rw [← hcom]
    have hw := F.mul_mem (F.mul_mem hyF hdF) (F.inv_mem hyF)
    exact F.mul_mem (F.mul_mem (F.mul_mem hw hdF) (F.inv_mem hw)) (F.inv_mem hdF)
  have hX := system.rootElement_mem_of_isGeneratingScalar_of_rootScaling F hγ hdF hk hdk
    (one_sub_mul_one_sub_ne_zero hk1 hl1) hmem
  refine ⟨hX, ?_⟩
  have e : system.rootElement γ (-1) * (system.rootElement γ 1 * g) = g := by
    rw [← mul_assoc, ← system.rootElement_add γ hγ, neg_add_cancel, system.rootElement_zero hγ,
      one_mul]
  exact e ▸ F.mul_mem (hX (-1)) hyF

/-- [Steinberg1962, 3.12]: let `x r c` and `x s c'` commute for all `c, c'`, and let `g` map
`X_γ` to `X_{vγ}` with signs `ε γ = ±1` for all roots `γ`, where `v` is a permutation of the
roots. Let `d` be a diagonal element (with `g d g⁻¹` commuting with `d` and with `g⁻¹ d g`) acting
on `X_r` by `1`, on `X_s` by `k`, on `X_{v⁻¹ r}` by `l`, on `X_{v⁻¹ s}` by `m` and on `X_{v r}`
by `n`, where `k, l, m, n ≠ 1` and `k`, `n` are generating scalars. Then the subgroup generated
by `d` and `x r 1 * x s 1 * g` contains `X_r`, `X_s` and `g`. -/
theorem rootElement_mem_and_mem_closure_pair_of_commuting
    (system : SteinbergSystem cartan finiteType K G)
    {r s : Fin rank → ℤ} (hr : r ∈ roots finiteType ∅) (hs : s ∈ roots finiteType ∅)
    (hrs : ∀ c c' : K, Commute (system.rootElement r c) (system.rootElement s c'))
    {g d : G} {v : Equiv.Perm (Fin rank → ℤ)}
    (hv : ∀ γ, v γ ∈ roots finiteType ∅ ↔ γ ∈ roots finiteType ∅)
    {ε : (Fin rank → ℤ) → ℤ} (hε : ∀ γ ∈ roots finiteType ∅, ε γ = 1 ∨ ε γ = -1)
    (hg : ∀ γ ∈ roots finiteType ∅, ∀ u : K,
      g * system.rootElement γ u * g⁻¹ = system.rootElement (v γ) ((ε γ : K) * u))
    {k l m n : Kˣ} (hk : IsGeneratingScalar k) (hn : IsGeneratingScalar n)
    (hk1 : k ≠ 1) (hl1 : l ≠ 1) (hm1 : m ≠ 1) (hn1 : n ≠ 1)
    (hdr : RootScaling system.rootElement r d 1)
    (hds : RootScaling system.rootElement s d (k : K))
    (hdl : RootScaling system.rootElement (v.symm r) d (l : K))
    (hdm : RootScaling system.rootElement (v.symm s) d (m : K))
    (hdn : RootScaling system.rootElement (v r) d (n : K))
    (hc1 : Commute d (g * d * g⁻¹)) (hc3 : Commute (g * d * g⁻¹) (g⁻¹ * d * g)) :
    (∀ c : K, system.rootElement r c ∈
        Subgroup.closure {d, system.rootElement r 1 * system.rootElement s 1 * g}) ∧
      (∀ c : K, system.rootElement s c ∈
        Subgroup.closure {d, system.rootElement r 1 * system.rootElement s 1 * g}) ∧
      g ∈ Subgroup.closure {d, system.rootElement r 1 * system.rootElement s 1 * g} := by
  set F : Subgroup G :=
    Subgroup.closure {d, system.rootElement r 1 * system.rootElement s 1 * g}
  have hdF : d ∈ F := Subgroup.subset_closure (by simp)
  have hyF : system.rootElement r 1 * system.rootElement s 1 * g ∈ F :=
    Subgroup.subset_closure (by simp)
  have hεε : ∀ γ ∈ roots finiteType ∅, (ε γ : K) * (ε γ : K) = 1 := by
    intro γ hγ
    rcases hε γ hγ with h | h <;> simp [h]
  have hrmem : v.symm r ∈ roots finiteType ∅ := (hv _).1 (by simpa using hr)
  have hsmem : v.symm s ∈ roots finiteType ∅ := (hv _).1 (by simpa using hs)
  have hd₁r : RootScaling system.rootElement r (g * d * g⁻¹) (l : K) :=
    RootScaling.conj (hεε _ hrmem) (fun u ↦ by simpa using hg _ hrmem u) hdl
  have hd₁s : RootScaling system.rootElement s (g * d * g⁻¹) (m : K) :=
    RootScaling.conj (hεε _ hsmem) (fun u ↦ by simpa using hg _ hsmem u) hdm
  have hd₂r : RootScaling system.rootElement r (g⁻¹ * d * g) (n : K) :=
    RootScaling.conj_inv (hεε _ hr) (hg r hr) hdn
  have hdr' : ∀ p, d * system.rootElement r p * d⁻¹ = system.rootElement r p := by
    intro p; simpa using hdr p
  -- Step 1: `X_s ⊆ F`.
  have hcom := commutator_conj_rootElement_pair_eq (system.rootElement_add r hr)
    (system.rootElement_add s hs) hrs (h := g) (d := d) (d₁ := g * d * g⁻¹) rfl hc1.symm hdr'
    hds hd₁r hd₁s
  have hmems : system.rootElement s (((1 : K) - m) * (1 - k)) ∈ F := by
    rw [← hcom]
    have hw := F.mul_mem (F.mul_mem hyF hdF) (F.inv_mem hyF)
    exact F.mul_mem (F.mul_mem (F.mul_mem hw hdF) (F.inv_mem hw)) (F.inv_mem hdF)
  have hXs := system.rootElement_mem_of_isGeneratingScalar_of_rootScaling F hs hdF hk hds
    (one_sub_mul_one_sub_ne_zero hk1 hm1) hmems
  -- Step 2: `x r 1 * g ∈ F`.
  have htF : system.rootElement r 1 * g ∈ F := by
    have e : system.rootElement s (-1) *
        (system.rootElement r 1 * system.rootElement s 1 * g) = system.rootElement r 1 * g := by
      calc system.rootElement s (-1) * (system.rootElement r 1 * system.rootElement s 1 * g)
          = (system.rootElement s (-1) * system.rootElement r 1) * system.rootElement s 1 * g := by
            group
        _ = system.rootElement r 1 * (system.rootElement s (-1) * system.rootElement s 1) * g := by
            rw [← (hrs 1 (-1)).eq]; group
        _ = system.rootElement r 1 * g := by
            rw [← system.rootElement_add s hs, neg_add_cancel, system.rootElement_zero hs]; group
    rw [← e]
    exact F.mul_mem (hXs (-1)) hyF
  have hd₂F : g⁻¹ * d * g ∈ F := by
    have hd' : d * system.rootElement r 1 = system.rootElement r 1 * d := by
      have := hdr' 1
      rwa [mul_inv_eq_iff_eq_mul] at this
    have e : (system.rootElement r 1 * g)⁻¹ * d * (system.rootElement r 1 * g) =
        g⁻¹ * d * g := by
      calc (system.rootElement r 1 * g)⁻¹ * d * (system.rootElement r 1 * g)
          = g⁻¹ * (system.rootElement r 1)⁻¹ * (d * system.rootElement r 1) * g := by group
        _ = g⁻¹ * d * g := by rw [hd']; group
    rw [← e]
    exact F.mul_mem (F.mul_mem (F.inv_mem htF) hdF) htF
  -- Step 3: `X_r ⊆ F`.
  have hcom2 := commutator_conj_rootElement_eq (system.rootElement_add r hr) (h := g) (d := d)
    (d₁ := g * d * g⁻¹) (d' := g⁻¹ * d * g) rfl hc3 hd₁r hd₂r
  have hmemr : system.rootElement r (((1 : K) - l) * (1 - n)) ∈ F := by
    rw [← hcom2]
    have hw := F.mul_mem (F.mul_mem htF hdF) (F.inv_mem htF)
    exact F.mul_mem (F.mul_mem (F.mul_mem hw hd₂F) (F.inv_mem hw)) (F.inv_mem hd₂F)
  have hXr := system.rootElement_mem_of_isGeneratingScalar_of_rootScaling F hr hd₂F hn hd₂r
    (one_sub_mul_one_sub_ne_zero hn1 hl1) hmemr
  refine ⟨hXr, hXs, ?_⟩
  have e : system.rootElement r (-1) * (system.rootElement r 1 * g) = g := by
    rw [← mul_assoc, ← system.rootElement_add r hr, neg_add_cancel, system.rootElement_zero hr,
      one_mul]
  exact e ▸ F.mul_mem (hXr (-1)) htF

/-- Steinberg's criterion [Steinberg1962, §3.10] for `⟨h_μ(k), x_γ(1) ω(L)⟩`: if `h_μ(k)` acts on
`X_γ` by a generating scalar `≠ 1` and on `X_{w_L⁻¹ γ}` by a scalar `≠ 1`, the subgroup contains
the root group `X_γ` and `ω(L)`. -/
theorem rootGroupIn_closure_diagonal_mul (x : SteinbergSystem cartan finiteType K G)
    (L : List (Fin rank)) (μ : Fin rank → ℤ) (k : Kˣ) {γ : Fin rank → ℤ}
    (hγ : γ ∈ roots finiteType ∅) {n n' : ℤ} (hn : cocharacterPairing cartan μ γ = n)
    (hn' : cocharacterPairing cartan μ (weylWordRootInv cartan L γ) = n')
    (hk : IsGeneratingScalar (k ^ n)) (hk1 : k ^ n ≠ 1) (hl1 : k ^ n' ≠ 1) :
    x.RootGroupIn (Subgroup.closure {cocharacterElement x.rootElement μ k,
      x.rootElement γ 1 * weylWordElement x.rootElement L}) γ ∧
    weylWordElement x.rootElement L ∈ Subgroup.closure
      {cocharacterElement x.rootElement μ k,
        x.rootElement γ 1 * weylWordElement x.rootElement L} := by
  obtain ⟨hdiag, -⟩ := x.cocharacterElement_isDiagonal μ k
  have hd1 := x.rootScaling_conj_weylWordElement L hγ
    (x.rootScaling_cocharacterElement μ k (weylWordRootInv_mem_roots finiteType L hγ) hn')
  obtain ⟨h1, h2⟩ := x.rootElement_mem_and_mem_closure_pair hγ rfl
    (hdiag.commute x (x.isDiagonal_conj_weylWordElement L hdiag).1) hk hk1 hl1
    (x.rootScaling_cocharacterElement μ k hγ hn) hd1
  exact ⟨⟨hγ, h1⟩, h2⟩

/-- Steinberg's criterion [Steinberg1962, §3.12] for `⟨h_μ(k), x_r(1) x_s(1) ω(L)⟩` with
commuting `X_r`, `X_s` and `h_μ(k)` trivial on `X_r`: under the stated weight conditions, the
subgroup contains `X_r`, `X_s` and `ω(L)`. -/
theorem rootGroupIn_closure_diagonal_mul_pair (x : SteinbergSystem cartan finiteType K G)
    (L : List (Fin rank)) (μ : Fin rank → ℤ) (k : Kˣ) {r s : Fin rank → ℤ}
    (hr : r ∈ roots finiteType ∅) (hs : s ∈ roots finiteType ∅)
    (hrs : ∀ c c' : K, Commute (x.rootElement r c) (x.rootElement s c'))
    {n₁ n₂ n₃ n₄ : ℤ}
    (h₀ : cocharacterPairing cartan μ r = 0)
    (h₁ : cocharacterPairing cartan μ s = n₁)
    (h₂ : cocharacterPairing cartan μ (weylWordRootInv cartan L r) = n₂)
    (h₃ : cocharacterPairing cartan μ (weylWordRootInv cartan L s) = n₃)
    (h₄ : cocharacterPairing cartan μ (weylWordRoot cartan L r) = n₄)
    (hk₁ : IsGeneratingScalar (k ^ n₁)) (hk₄ : IsGeneratingScalar (k ^ n₄))
    (hn₁ : k ^ n₁ ≠ 1) (hn₂ : k ^ n₂ ≠ 1) (hn₃ : k ^ n₃ ≠ 1) (hn₄ : k ^ n₄ ≠ 1) :
    x.RootGroupIn (Subgroup.closure {cocharacterElement x.rootElement μ k,
      x.rootElement r 1 * x.rootElement s 1 * weylWordElement x.rootElement L}) r ∧
    x.RootGroupIn (Subgroup.closure {cocharacterElement x.rootElement μ k,
      x.rootElement r 1 * x.rootElement s 1 * weylWordElement x.rootElement L}) s ∧
    weylWordElement x.rootElement L ∈ Subgroup.closure {cocharacterElement x.rootElement μ k,
      x.rootElement r 1 * x.rootElement s 1 * weylWordElement x.rootElement L} := by
  obtain ⟨ε, -, hε1, -, hg1, -⟩ := x.exists_signs_weylWordElement_conj L
  obtain ⟨hdiag, -⟩ := x.cocharacterElement_isDiagonal μ k
  obtain ⟨hdiag1, hdiag2⟩ := x.isDiagonal_conj_weylWordElement L hdiag
  have hdr : RootScaling x.rootElement r (cocharacterElement x.rootElement μ k) 1 := by
    simpa using x.rootScaling_cocharacterElement μ k hr h₀
  obtain ⟨h1, h2, h3⟩ := x.rootElement_mem_and_mem_closure_pair_of_commuting hr hs hrs
    (v := weylWordPerm finiteType L) (fun γ ↦ weylWordPerm_mem_iff finiteType L γ) hε1 hg1
    hk₁ hk₄ hn₁ hn₂ hn₃ hn₄ hdr
    (x.rootScaling_cocharacterElement μ k hs h₁)
    (x.rootScaling_cocharacterElement μ k
      ((weylWordPerm_symm_mem_iff finiteType L r).2 hr) h₂)
    (x.rootScaling_cocharacterElement μ k
      ((weylWordPerm_symm_mem_iff finiteType L s).2 hs) h₃)
    (x.rootScaling_cocharacterElement μ k ((weylWordPerm_mem_iff finiteType L r).2 hr) h₄)
    (hdiag.commute x hdiag1) (hdiag1.commute x hdiag2)
  exact ⟨⟨hr, h1⟩, ⟨hs, h2⟩, h3⟩

end SteinbergSystem

end CFSGCorollary
