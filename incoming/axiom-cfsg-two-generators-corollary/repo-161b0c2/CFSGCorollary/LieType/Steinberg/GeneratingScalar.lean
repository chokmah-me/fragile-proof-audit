module

public import CFSGCorollary.LieType.Steinberg.Basic

/-!
# Generating scalars

A unit `k` of a finite field `K` is a *generating scalar* (`CFSGCorollary.IsGeneratingScalar`) if
it generates `Kˣ` or is the square of a generator. This file shows that such a `k` generates `K`
as a ring, so that an additive subgroup containing all `kʲ l` (`l ≠ 0`) is all of `K`; this is the
field-theoretic input to Lemma 3.9 of [Steinberg1962]. It also shows that over a prime field a
root group is generated by a single nontrivial root element, and records the facts about
generators of `Kˣ` used in the generation proofs.

## Main results

* `CFSGCorollary.ne_one_of_zpowers_eq_top`, `CFSGCorollary.sq_ne_one_of_zpowers_eq_top`
* `CFSGCorollary.IsGeneratingScalar.subring_closure_eq_top`
* `CFSGCorollary.IsGeneratingScalar.mem_of_pow_mul_mem`
* `CFSGCorollary.range_subset_zpowers_of_card_eq_prime`

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary

/-! ### Generators of `Kˣ` -/

section Generator

variable {K : Type*} [Field K] {k : Kˣ}

theorem IsGeneratingScalar.of_zpowers_eq_top (hk : Subgroup.zpowers k = ⊤) :
    IsGeneratingScalar k :=
  ⟨k, hk, Or.inl rfl⟩

theorem IsGeneratingScalar.inv_of_zpowers_eq_top (hk : Subgroup.zpowers k = ⊤) :
    IsGeneratingScalar k⁻¹ :=
  ⟨k⁻¹, by rw [Subgroup.zpowers_inv]; exact hk, Or.inl rfl⟩

theorem IsGeneratingScalar.zpow_of_zpowers_eq_top (hk : Subgroup.zpowers k = ⊤) {e : ℤ}
    (he : e = 1 ∨ e = -1) : IsGeneratingScalar (k ^ e) := by
  rcases he with rfl | rfl
  · simpa using IsGeneratingScalar.of_zpowers_eq_top hk
  · simpa using IsGeneratingScalar.inv_of_zpowers_eq_top hk

/-- A generator of `Kˣ` is not `1` when `|K| ≥ 3`. -/
theorem ne_one_of_zpowers_eq_top (hK : 3 ≤ Nat.card K) (hk : Subgroup.zpowers k = ⊤) :
    k ≠ 1 := by
  rintro rfl
  have := orderOf_eq_card_of_zpowers_eq_top hk
  rw [orderOf_one, Nat.card_units] at this
  omega

/-- The square of a generator of `Kˣ` is not `1` when `|K| ≥ 4`. -/
theorem sq_ne_one_of_zpowers_eq_top (hK : 4 ≤ Nat.card K) (hk : Subgroup.zpowers k = ⊤) :
    k ^ 2 ≠ 1 := by
  intro h
  have h1 := orderOf_eq_card_of_zpowers_eq_top hk
  have h2 := Nat.le_of_dvd (by norm_num) (orderOf_dvd_of_pow_eq_one h)
  rw [Nat.card_units] at h1
  omega

end Generator

/-- The subring generated by a generating scalar (a generator of `Kˣ` or the square of one)
is the whole finite field. -/
theorem IsGeneratingScalar.subring_closure_eq_top {K : Type*} [Field K] [Finite K]
    {k : Kˣ} (hk : IsGeneratingScalar k) :
    Subring.closure {(k : K)} = ⊤ := by
  classical
  obtain ⟨g, hg, hkg⟩ := hk
  have := Fintype.ofFinite K
  set R : Subring K := Subring.closure {(k : K)} with hR
  by_contra hne
  have hkR : (k : K) ∈ R := Subring.subset_closure rfl
  -- `R` is a finite domain, hence a field.
  let : Fintype R := Fintype.ofFinite R
  let : Field R := Fintype.fieldOfDomain R
  have hkne : (⟨(k : K), hkR⟩ : R) ≠ 0 := by
    intro h
    have := congrArg Subtype.val h
    simp at this
  have hpow : (⟨(k : K), hkR⟩ : R) ^ (Fintype.card R - 1) = 1 :=
    FiniteField.pow_card_sub_one_eq_one _ hkne
  have hpowK : (k : K) ^ (Fintype.card R - 1) = 1 := by
    simpa using congrArg Subtype.val hpow
  have hkpow : k ^ (Fintype.card R - 1) = 1 := Units.ext (by simpa using hpowK)
  have hgord : orderOf g = Fintype.card K - 1 := by
    rw [orderOf_eq_card_of_zpowers_eq_top hg, Nat.card_units]
    simp [Nat.card_eq_fintype_card]
  have hdvd : Fintype.card K - 1 ∣ 2 * (Fintype.card R - 1) := by
    rw [← hgord]
    apply orderOf_dvd_of_pow_eq_one
    rcases hkg with h | h
    · rw [mul_comm, pow_mul, ← h, hkpow]
      simp
    · rw [pow_mul, ← h]
      exact hkpow
  have hR1 : 1 < Fintype.card R := Fintype.one_lt_card
  have hK1 : 1 < Fintype.card K := Fintype.one_lt_card
  have hle : Fintype.card K - 1 ≤ 2 * (Fintype.card R - 1) :=
    Nat.le_of_dvd (by omega) hdvd
  have hRdvd : Fintype.card R ∣ Fintype.card K := by
    simpa [Nat.card_eq_fintype_card] using
      AddSubgroup.card_addSubgroup_dvd_card R.toAddSubgroup
  have hlt : Fintype.card R < Fintype.card K := by
    obtain ⟨x, hx⟩ : ∃ x : K, x ∉ R := by
      by_contra hcon
      push Not at hcon
      exact hne ((Subring.eq_top_iff' R).mpr hcon)
    exact Fintype.card_lt_of_injective_of_notMem (Subtype.val : R → K) Subtype.val_injective
      (b := x) (by simpa using hx)
  obtain ⟨m, hm⟩ := hRdvd
  have : 2 ≤ m := by
    by_contra h
    interval_cases m <;> omega
  have h2 : 2 * Fintype.card R ≤ Fintype.card R * m := by nlinarith
  omega

/-- If an additive subgroup of a finite field contains all `kʲ * l` with `l ≠ 0` and `k` a
generating scalar, then it is the whole field. -/
theorem IsGeneratingScalar.mem_of_pow_mul_mem {K : Type*} [Field K] [Finite K]
    {k : Kˣ} (hk : IsGeneratingScalar k) (S : AddSubgroup K) {l : K} (hl : l ≠ 0)
    (h : ∀ j : ℕ, (k : K) ^ j * l ∈ S) (c : K) : c ∈ S := by
  have hc : c / l ∈ Subring.closure {(k : K)} := by
    rw [hk.subring_closure_eq_top]; trivial
  have key : ∀ r ∈ Subring.closure {(k : K)}, ∀ a : K,
      (∀ j : ℕ, (k : K) ^ j * a * l ∈ S) → ∀ j : ℕ, (k : K) ^ j * (r * a) * l ∈ S := by
    intro r hr
    induction hr using Subring.closure_induction with
    | mem x hx =>
      intro a ha j
      rw [Set.mem_singleton_iff] at hx
      subst hx
      convert ha (j + 1) using 1
      ring
    | zero => intro a ha j; simp
    | one => intro a ha j; simpa using ha j
    | add x y _ _ hx hy =>
      intro a ha j
      convert S.add_mem (hx a ha j) (hy a ha j) using 1
      ring
    | neg x _ hx =>
      intro a ha j
      convert S.neg_mem (hx a ha j) using 1
      ring
    | mul x y _ _ hx hy =>
      intro a ha j
      convert hx (y * a) (hy a ha) j using 2
      ring
  simpa [div_mul_cancel₀ _ hl] using key _ hc 1 (fun j ↦ by simpa using h j) 0

/-- The additive span of `l • kʲ` is the whole finite field when `k` is a generating scalar. -/
theorem addSubgroup_closure_mul_pow_eq_top {K : Type*} [Field K] [Finite K]
    (l : K) (hl : l ≠ 0) (k : Kˣ)
    (hk : ∃ g : Kˣ, Subgroup.zpowers g = ⊤ ∧ (k = g ∨ k = g ^ (2 : ℕ))) :
    AddSubgroup.closure {x : K | ∃ j : ℕ, x = l * ((k ^ j : Kˣ) : K)} = ⊤ := by
  refine eq_top_iff.2 fun c _ ↦ IsGeneratingScalar.mem_of_pow_mul_mem hk _ hl (fun j ↦ ?_) c
  exact AddSubgroup.subset_closure ⟨j, by rw [Units.val_pow_eq_pow_val, mul_comm]⟩

/-- Over a prime field, a root group `y(K)` is generated by `y 1`. -/
theorem range_subset_zpowers_of_card_eq_prime {G K : Type*} [Group G] [Field K]
    (p : ℕ) (hp : p.Prime) (hK : Nat.card K = p) (y : K → G)
    (hy : ∀ c d : K, y (c + d) = y c * y d) :
    Set.range y ⊆ (Subgroup.zpowers (y 1) : Set G) := by
  have : Finite K := Nat.finite_of_card_ne_zero (by rw [hK]; exact hp.ne_zero)
  let f : Multiplicative K →* G :=
    ⟨⟨fun c ↦ y c.toAdd, map_zero_eq_one_of_additive hy⟩, fun a b ↦ hy a.toAdd b.toAdd⟩
  have hdvd : Nat.card (AddSubgroup.zmultiples (1 : K)) ∣ p :=
    hK ▸ AddSubgroup.card_addSubgroup_dvd_card _
  have hne : AddSubgroup.zmultiples (1 : K) ≠ ⊥ := by
    intro h
    have : (1 : K) ∈ AddSubgroup.zmultiples (1 : K) := AddSubgroup.mem_zmultiples _
    rw [h] at this
    exact one_ne_zero (AddSubgroup.mem_bot.1 this)
  have htop : AddSubgroup.zmultiples (1 : K) = ⊤ := by
    rcases (Nat.dvd_prime hp).1 hdvd with h | h
    · exact absurd ((AddSubgroup.eq_bot_iff_card _).2 h) hne
    · rw [← AddSubgroup.card_eq_iff_eq_top, h, hK]
  rintro _ ⟨c, rfl⟩
  obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 (htop ▸ AddSubgroup.mem_top c)
  have : y (n • (1 : K)) = (y 1) ^ n := by
    simpa [f] using map_zpow f (Multiplicative.ofAdd (1 : K)) n
  rw [this]
  exact Subgroup.zpow_mem_zpowers _ _

/-- Over a prime field, a subgroup containing `y 1` contains the whole root group `y(K)`. -/
theorem range_subset_of_card_eq_prime_of_mem {G K : Type*} [Group G] [Field K]
    (p : ℕ) (hp : p.Prime) (hK : Nat.card K = p) (y : K → G)
    (hy : ∀ c d : K, y (c + d) = y c * y d) (H : Subgroup G) (h1 : y 1 ∈ H) :
    Set.range y ⊆ (H : Set G) :=
  (range_subset_zpowers_of_card_eq_prime p hp hK y hy).trans
    (by exact_mod_cast (Subgroup.zpowers_le.mpr h1))

end CFSGCorollary
