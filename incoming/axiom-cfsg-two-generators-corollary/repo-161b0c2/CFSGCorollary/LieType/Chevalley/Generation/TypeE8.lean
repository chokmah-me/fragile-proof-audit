module

public import CFSGCorollary.LieType.Chevalley.Roots.TypeE8
public import CFSGCorollary.TwoGenerated.Basic
public import CFSGCorollary.LieType.Steinberg.Diagonal
import CFSGCorollary.LieType.Steinberg.ClosurePair
import CFSGCorollary.LieType.Steinberg.GeneratingScalar

/-!
# Two-generation of Chevalley groups of type `E₈`

Steinberg's theorem 3.11 for type `E₈`: a group `G` with a Steinberg system of type `E₈` over a
finite field `K` is generated by two elements. With `a = α₇`, `L` as in `TypeE8.coxeterList` and
`ω(L)` the corresponding product of Weyl elements:

* if `|K| ≥ 4` and `k` generates `Kˣ`, then `G = ⟨h_a(k), x_a(1) ω(L)⟩`;
* if `|K| ≤ 3`, then `G = ⟨x_a(1), ω(L)⟩`.

In both cases one first shows that the generated subgroup contains `X_a` and `ω(L)`. Since
`w¹⁵ = -1`, conjugation by `ω(L)¹⁵` then gives `X_{-a}`, and every root group `X_{±αᵢ}` is
recovered from the root identities of `Roots.TypeE8`.

## Main results

* `TypeE8.closure_diagonal_mul_eq_top`: the case `|K| ≥ 4`.
* `TypeE8.closure_pair_eq_top_of_card_le_three`: the case `|K| ≤ 3`.
* `TypeE8.twoGenerated`: `G` is two-generated.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TypeE8

variable {K G : Type*} [Field K] [Finite K] [Group G]

/-- If `X_{±αᵢ} ≤ F`, then the Weyl element `ω([i])` lies in `F`. -/
theorem weylWordElement_singleton_mem (system : SteinbergSystem cartan isFiniteType K G)
    (F : Subgroup G) (i : Fin 8)
    (hpos : ∀ u, system.rootElement (Pi.single i 1) u ∈ F)
    (hneg : ∀ u, system.rootElement (-Pi.single i 1) u ∈ F) :
    weylWordElement system.rootElement [i] ∈ F := by
  have : weylWordElement system.rootElement [i] =
      CFSG.LieType.Steinberg.weylElement system.rootElement i (1 : Kˣ) := by
    simp [weylWordElement]
  rw [this]
  unfold CFSG.LieType.Steinberg.weylElement
  exact mul_mem (mul_mem (hpos _) (hneg _)) (hpos _)

theorem simpleRoot_seven_mem : simpleRoot 7 ∈ rootSet := Or.inl ⟨1, 7, by simp⟩

/-- A subgroup of `G` containing `ω(L)` and the root group `X_a` is the whole group. -/
theorem eq_top_of_weylWordElement_mem_of_rootElement_mem
    (system : SteinbergSystem cartan isFiniteType K G) (F : Subgroup G)
    (hω : weylWordElement system.rootElement coxeterList ∈ F)
    (ha : ∀ u, system.rootElement (simpleRoot 7) u ∈ F) : F = ⊤ := by
  have ha7 := simpleRoot_seven_mem
  let S : (Fin 8 → ℤ) → Prop := fun γ ↦ γ ∈ rootSet ∧ ∀ u, system.rootElement γ u ∈ F
  have hW : ∀ γ, S γ → S (coxeterElement γ) := by
    intro γ hγ
    have := (system.rootGroupIn_weylWordRoot F coxeterList hω hγ).1
    rwa [← reflectionWord_apply] at this
  have hWi : ∀ γ, S γ → S (coxeterElementInv γ) := by
    intro γ hγ
    have := (system.rootGroupIn_weylWordRoot F coxeterList hω hγ).2
    rwa [← reflectionWord_reverse_apply] at this
  have hs : ∀ j : Fin 8, weylWordElement system.rootElement [j] ∈ F → ∀ γ, S γ →
      S (simpleReflection j γ) := by
    intro j hj γ hγ
    have := (system.rootGroupIn_weylWordRoot F [j] hj hγ).1
    exact this
  have hpow : ∀ n : ℕ, ∀ γ, S γ → S ((coxeterElement ^ n) γ) := by
    intro n
    induction n with
    | zero => intro γ hγ; simpa using hγ
    | succ n ih =>
      intro γ hγ
      rw [pow_succ', Module.End.mul_apply]
      exact hW _ (ih γ hγ)
  have hpowi : ∀ n : ℕ, ∀ γ, S γ → S ((coxeterElementInv ^ n) γ) := by
    intro n
    induction n with
    | zero => intro γ hγ; simpa using hγ
    | succ n ih =>
      intro γ hγ
      rw [pow_succ', Module.End.mul_apply]
      exact hWi _ (ih γ hγ)
  have hneg : S (-simpleRoot 7) := by
    have := hpow 15 (simpleRoot 7) ⟨ha7, ha⟩
    rwa [coxeterElement_pow_apply_eq_neg] at this
  have hsign : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 7) := by
    intro ε hε
    rcases hε with rfl | rfl
    · simpa using (⟨ha7, ha⟩ : S (simpleRoot 7))
    · simpa using hneg
  have h6 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 6) := by
    intro ε hε
    rw [smul_simpleRoot_six ε hε]
    exact hW _ (hsign ε hε)
  have h5 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 5) := by
    intro ε hε
    rw [smul_simpleRoot_five ε hε]
    exact hpow 2 _ (hsign ε hε)
  have h4 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 4) := by
    intro ε hε
    rw [smul_simpleRoot_four ε hε]
    exact hpow 3 _ (hsign ε hε)
  have h3 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 3) := by
    intro ε hε
    rw [smul_simpleRoot_three ε hε]
    exact hpow 4 _ (hsign ε hε)
  have hneg1 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → (-ε = 1 ∨ -ε = -1) := by
    intro ε hε
    rcases hε with rfl | rfl <;> simp
  have hω : ∀ (j : Fin 8), (∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot j)) →
      weylWordElement system.rootElement [j] ∈ F := by
    intro j hj
    refine weylWordElement_singleton_mem system F j ?_ ?_
    · intro u
      simpa using (hj 1 (Or.inl rfl)).2 u
    · intro u
      simpa using (hj (-1) (Or.inr rfl)).2 u
  have hω3 := hω 3 h3
  have hω4 := hω 4 h4
  have h2 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 2) := by
    intro ε hε
    rw [smul_simpleRoot_two ε hε]
    exact hs 3 hω3 _ (hpowi 2 _ (hsign _ (hneg1 ε hε)))
  have h0 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 0) := by
    intro ε hε
    rw [smul_simpleRoot_zero ε hε]
    exact hW _ (hs 3 hω3 _ (hpowi 2 _ (hsign _ (hneg1 ε hε))))
  have h1 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot 1) := by
    intro ε hε
    rw [smul_simpleRoot_one ε hε]
    exact hs 3 hω3 _ (hs 4 hω4 _ (hpowi 3 _ (hsign _ (hneg1 ε hε))))
  have hall : ∀ i : Fin 8, ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → S (ε • simpleRoot i) := by
    intro i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
    · exact h3
    · exact h4
    · exact h5
    · exact h6
    · exact hsign
  refine system.eq_top_of_simple_root_groups F (fun i u ↦ ?_) (fun i u ↦ ?_)
  · simpa using (hall i 1 (Or.inl rfl)).2 u
  · simpa using (hall i (-1) (Or.inr rfl)).2 u

theorem sum_simpleRoot_mul (γ : Fin 8 → ℤ) :
    (∑ i, simpleRoot 7 i * ∑ j, cartan i j * γ j) = ∑ j, cartan 7 j * γ j := by
  rw [Finset.sum_eq_single (7 : Fin 8)]
  · simp [simpleRoot]
  · intro b _ hb
    simp [simpleRoot, hb]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- [Steinberg1962] 3.11 for `E₈`, `|K| ≥ 4`: `G` is generated by `h_a(k)` and `x_a(1) ω(L)`,
where `a = α₇` and `k` generates `Kˣ`. -/
theorem closure_diagonal_mul_eq_top (system : SteinbergSystem cartan isFiniteType K G)
    (hK : 4 ≤ Nat.card K) {k : Kˣ} (hk : Subgroup.zpowers k = ⊤) :
    Subgroup.closure
      {cocharacterElement system.rootElement (simpleRoot 7) k,
        system.rootElement (simpleRoot 7) 1 * weylWordElement system.rootElement coxeterList} =
      ⊤ := by
  have ha := simpleRoot_seven_mem
  have hk1 := ne_one_of_zpowers_eq_top (by omega) hk
  have hk2 := sq_ne_one_of_zpowers_eq_top hK hk
  obtain ⟨h1, h2⟩ := system.rootGroupIn_closure_diagonal_mul coxeterList (simpleRoot 7) k ha
    (n := 2) (n' := -1) (by rw [cocharacterPairing, sum_simpleRoot_mul, pairing_simpleRoot_last])
    (by
      rw [cocharacterPairing, sum_simpleRoot_mul, ← reflectionWord_reverse_apply]
      exact pairing_coxeterElementInv_simpleRoot_last)
    ⟨k, hk, Or.inr (by simp)⟩ (by simpa using hk2) (by simpa using hk1)
  exact eq_top_of_weylWordElement_mem_of_rootElement_mem system _ h2 h1.2

/-- [Steinberg1962] 3.11 for `E₈`, `|K| ≤ 3`: `G` is generated by `x_a(1)` and `ω(L)`. -/
theorem closure_pair_eq_top_of_card_le_three (system : SteinbergSystem cartan isFiniteType K G)
    (hK : Nat.card K ≤ 3) :
    Subgroup.closure
      {system.rootElement (simpleRoot 7) 1, weylWordElement system.rootElement coxeterList} =
      ⊤ := by
  have ha := simpleRoot_seven_mem
  have h1 : 1 < Nat.card K := Finite.one_lt_card
  have hp : (Nat.card K).Prime := by
    obtain h | h : Nat.card K = 2 ∨ Nat.card K = 3 := by omega
    · rw [h]; exact Nat.prime_two
    · rw [h]; exact Nat.prime_three
  have hmem := range_subset_of_card_eq_prime_of_mem (Nat.card K) hp rfl
    (system.rootElement (simpleRoot 7)) (system.rootElement_add _ ha)
    (Subgroup.closure
      {system.rootElement (simpleRoot 7) 1, weylWordElement system.rootElement coxeterList})
    (Subgroup.subset_closure (Set.mem_insert _ _))
  exact eq_top_of_weylWordElement_mem_of_rootElement_mem system _
    (Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton_iff.2 rfl)))
    (fun u ↦ hmem ⟨u, rfl⟩)

/-- [Steinberg1962] 3.11 for `E₈`: `G` is two-generated. -/
theorem twoGenerated (system : SteinbergSystem cartan isFiniteType K G) : TwoGenerated G := by
  by_cases hK : 4 ≤ Nat.card K
  · obtain ⟨k, hk⟩ := IsCyclic.exists_generator (α := Kˣ)
    exact ⟨_, _, closure_diagonal_mul_eq_top system hK
      (k := k) (Subgroup.eq_top_iff' _ |>.mpr hk)⟩
  · exact ⟨_, _, closure_pair_eq_top_of_card_le_three system (by omega)⟩

end CFSGCorollary.TypeE8
