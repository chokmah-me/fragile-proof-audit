module

public import CFSGCorollary.LieType.Chevalley.Roots.TypeE6
public import CFSGCorollary.TwoGenerated.Basic
import CFSGCorollary.LieType.Steinberg.ClosurePair
public import CFSGCorollary.LieType.Steinberg.Diagonal
import CFSGCorollary.LieType.Steinberg.GeneratingScalar
public import CFSGCorollary.LieType.Steinberg.SimpleRootGroups

/-!
# Two-generation of Chevalley groups of type `E₆`

Steinberg's theorem 3.11 for type `E₆`: a group `G` with a Steinberg system of type `E₆` over a
finite field `K` (with unit commutator constants) is generated by two elements. With `a = α₅`,
`L` as in `TypeE6.coxeterList` and `ω(L)` the corresponding product of Weyl elements:

* if `|K| ≥ 4` and `k` generates `Kˣ`, then `G = ⟨h_a(k), x_a(1) ω(L)⟩`;
* if `|K| ≤ 3`, then `G = ⟨x_a(1), ω(L)⟩`.

In both cases one first shows that the generated subgroup contains `X_a` and `ω(L)`, and then
recovers every root group `X_{±αᵢ}` from the root identities of `Roots.TypeE6`.

## Main results

* `TypeE6.closure_diagonal_mul_eq_top`: the case `|K| ≥ 4`.
* `TypeE6.closure_pair_eq_top_of_card_le_three`: the case `|K| ≤ 3`.
* `TypeE6.twoGenerated`: `G` is two-generated.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TypeE6

variable {K G : Type*} [Field K] [Finite K] [Group G]

theorem rootGroupIn_reflectionWord (system : SteinbergSystem cartan isFiniteType K G)
    (F : Subgroup G) (L : List (Fin 6)) (hg : weylWordElement system.rootElement L ∈ F)
    {γ : Fin 6 → ℤ} (h : system.RootGroupIn F γ) :
    system.RootGroupIn F (reflectionWord cartan L γ) ∧
      system.RootGroupIn F (reflectionWord cartan L.reverse γ) := by
  rw [reflectionWord_apply, reflectionWord_reverse_apply]
  exact system.rootGroupIn_weylWordRoot F L hg h

theorem rootGroupIn_word_pow (system : SteinbergSystem cartan isFiniteType K G)
    (F : Subgroup G) (hg : weylWordElement system.rootElement coxeterList ∈ F)
    {γ : Fin 6 → ℤ} (h : system.RootGroupIn F γ) (n : ℕ) :
    system.RootGroupIn F ((coxeterElement ^ n) γ) ∧
      system.RootGroupIn F ((coxeterElementInv ^ n) γ) := by
  induction n with
  | zero => simpa using And.intro h h
  | succ n ih =>
    rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply]
    exact ⟨(rootGroupIn_reflectionWord system F coxeterList hg ih.1).1,
      (rootGroupIn_reflectionWord system F coxeterList hg ih.2).2⟩

/-- A subgroup containing the root group `X_a` and `ω(L)` is the whole group. -/
theorem eq_top_of_rootElement_mem_of_weylWordElement_mem
    (system : SteinbergSystem cartan isFiniteType K G)
    (hunit : system.HasUnitCommutatorConstants) (F : Subgroup G)
    (ha : ∀ u : K, system.rootElement (simpleRoot 5) u ∈ F)
    (hg : weylWordElement system.rootElement coxeterList ∈ F) : F = ⊤ := by
  have haR : system.RootGroupIn F (simpleRoot 5) :=
    ⟨Or.inl ⟨1, 5, by simp⟩, ha⟩
  have hpow := fun n ↦ rootGroupIn_word_pow system F hg haR n
  -- the root group `X_{-a}`
  have hneg : system.RootGroupIn F (-simpleRoot 5) := by
    obtain ⟨ht, htmem, hall⟩ := onlyPositiveCombination_coxeterElement_pow_simpleRoot_last
    have hu := (hpow 4).1
    have hv := (hpow 8).1
    obtain ⟨c, hc⟩ := hunit _ hu.1 _ hv.1 (by rw [← ht]; exact htmem) hall
    refine ⟨htmem, fun u ↦ ?_⟩
    have := hc 1 ((c : K)⁻¹ * u)
    rw [← ht] at this
    have e : (c : K) * 1 * ((c : K)⁻¹ * u) = u := by
      have : (c : K) ≠ 0 := c.ne_zero
      field_simp
    rw [e] at this
    rw [← this]
    have h1 := hu.2 1
    have h2 := hv.2 ((c : K)⁻¹ * u)
    exact F.mul_mem (F.mul_mem (F.mul_mem h1 h2) (F.inv_mem h1)) (F.inv_mem h2)
  have hQ : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → system.RootGroupIn F (ε • simpleRoot 5) := by
    rintro ε (rfl | rfl)
    · simpa using haR
    · simpa using hneg
  have hω : ∀ i : Fin 6, system.RootGroupIn F (simpleRoot i) →
      system.RootGroupIn F (-simpleRoot i) →
      CFSG.LieType.Steinberg.weylElement system.rootElement i (1 : Kˣ) ∈ F := by
    intro i h1 h2
    unfold CFSG.LieType.Steinberg.weylElement
    exact mul_mem (mul_mem (h1.2 _) (h2.2 _)) (h1.2 _)
  have hw : ∀ γ, system.RootGroupIn F γ → system.RootGroupIn F (coxeterElement γ) :=
    fun γ h ↦ (rootGroupIn_reflectionWord system F coxeterList hg h).1
  have hwi : ∀ γ, system.RootGroupIn F γ → system.RootGroupIn F (coxeterElementInv γ) :=
    fun γ h ↦ (rootGroupIn_reflectionWord system F coxeterList hg h).2
  have hr4 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → system.RootGroupIn F (ε • simpleRoot 4) := by
    intro ε hε
    rw [smul_simpleRoot_four ε hε]
    exact hw _ (hQ ε hε)
  have hr3 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → system.RootGroupIn F (ε • simpleRoot 3) := by
    intro ε hε
    rw [smul_simpleRoot_three ε hε]
    exact (rootGroupIn_word_pow system F hg (hQ ε hε) 2).1
  have hneg' : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → (-ε = 1 ∨ -ε = -1) := by
    rintro ε (rfl | rfl) <;> simp
  have hω3 := hω 3 (by simpa using hr3 1 (Or.inl rfl)) (by simpa using hr3 (-1) (Or.inr rfl))
  have hr2 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → system.RootGroupIn F (ε • simpleRoot 2) := by
    intro ε hε
    rw [smul_simpleRoot_two ε hε]
    exact system.rootGroupIn_reflection F 3 hω3
      ((rootGroupIn_word_pow system F hg (hQ (-ε) (hneg' ε hε)) 2).2)
  have hr0 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → system.RootGroupIn F (ε • simpleRoot 0) := by
    intro ε hε
    rw [smul_simpleRoot_zero ε hε]
    exact hw _ (system.rootGroupIn_reflection F 3 hω3
      ((rootGroupIn_word_pow system F hg (hQ (-ε) (hneg' ε hε)) 2).2))
  have hω5 := hω 5 (by simpa using hQ 1 (Or.inl rfl)) (by simpa using hQ (-1) (Or.inr rfl))
  have hω2 := hω 2 (by simpa using hr2 1 (Or.inl rfl)) (by simpa using hr2 (-1) (Or.inr rfl))
  have hr1p : system.RootGroupIn F (simpleRoot 1) := by
    rw [simpleRoot_one]
    exact hwi _ (system.rootGroupIn_reflection F 5 hω5
      ((rootGroupIn_word_pow system F hg haR 3).2))
  have hr1n : system.RootGroupIn F (-simpleRoot 1) := by
    rw [neg_simpleRoot_one]
    exact hwi _ (system.rootGroupIn_reflection F 2 hω2
      ((rootGroupIn_word_pow system F hg haR 3).1))
  refine system.eq_top_of_simple_root_groups F ?_ ?_
  · intro i u
    fin_cases i
    · simpa using (hr0 1 (Or.inl rfl)).2 u
    · exact hr1p.2 u
    · simpa using (hr2 1 (Or.inl rfl)).2 u
    · simpa using (hr3 1 (Or.inl rfl)).2 u
    · simpa using (hr4 1 (Or.inl rfl)).2 u
    · exact ha u
  · intro i u
    fin_cases i
    · simpa using (hr0 (-1) (Or.inr rfl)).2 u
    · exact hr1n.2 u
    · simpa using (hr2 (-1) (Or.inr rfl)).2 u
    · simpa using (hr3 (-1) (Or.inr rfl)).2 u
    · simpa using (hr4 (-1) (Or.inr rfl)).2 u
    · exact hneg.2 u

theorem rootElement_mem_and_weylWordElement_mem_closure
    (system : SteinbergSystem cartan isFiniteType K G)
    (hK : 4 ≤ Nat.card K) {k : Kˣ} (hk : Subgroup.zpowers k = ⊤) :
    (∀ c : K, system.rootElement (simpleRoot 5) c ∈ Subgroup.closure
      {cocharacterElement system.rootElement (simpleRoot 5) k,
        system.rootElement (simpleRoot 5) 1 * weylWordElement system.rootElement coxeterList}) ∧
      weylWordElement system.rootElement coxeterList ∈ Subgroup.closure
      {cocharacterElement system.rootElement (simpleRoot 5) k,
        system.rootElement (simpleRoot 5) 1 * weylWordElement system.rootElement coxeterList} := by
  have haR : simpleRoot 5 ∈ rootSet := Or.inl ⟨1, 5, by simp⟩
  have hk1 := ne_one_of_zpowers_eq_top (by omega) hk
  have hk2 := sq_ne_one_of_zpowers_eq_top hK hk
  have hsum : ∀ γ : Fin 6 → ℤ, (∑ i, (simpleRoot 5) i * ∑ j, cartan i j * γ j) =
      ∑ j, cartan 5 j * γ j := by
    intro γ
    rw [Finset.sum_eq_single (5 : Fin 6)]
    · simp
    · intro b _ hb; simp [hb]
    · simp
  obtain ⟨h1, h2⟩ := system.rootGroupIn_closure_diagonal_mul coxeterList (simpleRoot 5) k haR
    (n := 2) (n' := -1) (by rw [cocharacterPairing, hsum, pairing_simpleRoot_last])
    (by
      rw [cocharacterPairing, hsum, ← reflectionWord_reverse_apply]
      exact pairing_coxeterElementInv_simpleRoot_last)
    ⟨k, hk, Or.inr (by simp)⟩ (by simpa using hk2) (by simpa using hk1)
  exact ⟨h1.2, h2⟩

/-- [Steinberg1962] 3.11 for `E₆`, `|K| ≥ 4`: `G` is generated by `h_a(k)` and `x_a(1) ω(L)`,
where `a = α₅` and `k` generates `Kˣ`. -/
theorem closure_diagonal_mul_eq_top
    (system : SteinbergSystem cartan isFiniteType K G) (hunit : system.HasUnitCommutatorConstants)
    (hK : 4 ≤ Nat.card K) {k : Kˣ} (hk : Subgroup.zpowers k = ⊤) :
    Subgroup.closure
      {cocharacterElement system.rootElement (simpleRoot 5) k,
        system.rootElement (simpleRoot 5) 1 * weylWordElement system.rootElement coxeterList} =
      ⊤ :=
  eq_top_of_rootElement_mem_of_weylWordElement_mem system hunit _
    (rootElement_mem_and_weylWordElement_mem_closure system hK hk).1
    (rootElement_mem_and_weylWordElement_mem_closure system hK hk).2

/-- [Steinberg1962] 3.11 for `E₆`, `|K| ≤ 3`: `G` is generated by `x_a(1)` and `ω(L)`. -/
theorem closure_pair_eq_top_of_card_le_three
    (system : SteinbergSystem cartan isFiniteType K G) (hunit : system.HasUnitCommutatorConstants)
    (hK : Nat.card K ≤ 3) :
    Subgroup.closure
      {system.rootElement (simpleRoot 5) 1, weylWordElement system.rootElement coxeterList} =
      ⊤ := by
  have hp : (Nat.card K).Prime := by
    have h2 : 1 < Nat.card K := Finite.one_lt_card
    interval_cases h : Nat.card K
    · exact Nat.prime_two
    · exact Nat.prime_three
  have h1 : system.rootElement (simpleRoot 5) 1 ∈ Subgroup.closure
      {system.rootElement (simpleRoot 5) 1, weylWordElement system.rootElement coxeterList} :=
    Subgroup.subset_closure (by simp)
  refine eq_top_of_rootElement_mem_of_weylWordElement_mem system hunit _ ?_
    (Subgroup.subset_closure (Or.inr rfl))
  intro u
  exact range_subset_of_card_eq_prime_of_mem _ hp rfl (system.rootElement (simpleRoot 5))
    (system.rootElement_add _ (Or.inl ⟨1, 5, by simp⟩)) _ h1 ⟨u, rfl⟩

/-- [Steinberg1962] 3.11 for `E₆`: `G` is two-generated. -/
theorem twoGenerated (system : SteinbergSystem cartan isFiniteType K G)
    (hunit : system.HasUnitCommutatorConstants) : TwoGenerated G := by
  by_cases hK : 4 ≤ Nat.card K
  · obtain ⟨k, hk⟩ := IsCyclic.exists_generator (α := Kˣ)
    exact ⟨_, _, closure_diagonal_mul_eq_top system hunit hK
      (k := k) (Subgroup.eq_top_iff' _ |>.mpr hk)⟩
  · exact ⟨_, _, closure_pair_eq_top_of_card_le_three system hunit (by omega)⟩

end CFSGCorollary.TypeE6
