module

public import CFSGCorollary.TwoGenerated.Basic
public import CFSGCorollary.LieType.Steinberg.WeylWord
import CFSGCorollary.LieType.Steinberg.GeneratingScalar
public import CFSG.LieType.Universal.SymplecticRoots
import CFSGCorollary.LieType.Chevalley.Roots.TypeCCardThree
import CFSGCorollary.LieType.Steinberg.SimpleRootGroups

/-!
# Two-generation of Chevalley groups of type `C_m` over `𝔽₃`

Let `x` be a Steinberg system of type `C_m` (`m ≥ 3`) over a field `K` with `|K| = 3` whose
commutator constants are units, and let `L = [0, …, m-1]`. Following Steinberg (3.11), we show
`G = ⟨x α₀ 1, ω(L)⟩`: since `|K|` is prime, `x α₀ 1` generates `X_{α₀}`; conjugating by `ω(L)`
gives `X_{αᵢ}` for `i ≤ m - 2`, single commutators give `X_{βᵢ}` and then `X_{−α_{m-1}}`, and
`ω(L)^m` acts as `−1` on roots.

## Main results

* `TypeCCardThree.closure_pair_eq_top`: `G = ⟨x α₀ 1, ω(L)⟩`.
* `TypeCCardThree.twoGenerated`: `G` is generated by two elements.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary

namespace TypeCCardThree

open CFSG.LieType.Universal.Symplectic

variable {m : ℕ} {K G : Type*} [Field K] [Finite K] [Group G]

/-- `G = ⟨x α₀ 1, ω(L)⟩` for `|K| = 3`. -/
theorem closure_pair_eq_top (hm : 3 ≤ m)
    (x : SteinbergSystem (cartanC m) (isFiniteType_cartanC m) K G)
    (hx : x.HasUnitCommutatorConstants) (hK : Nat.card K = 3) :
    Subgroup.closure {x.rootElement (Pi.single ⟨0, by omega⟩ 1) 1,
      weylWordElement x.rootElement (List.finRange m)} = ⊤ := by
  set F := Subgroup.closure {x.rootElement (Pi.single ⟨0, by omega⟩ 1) 1,
      weylWordElement x.rootElement (List.finRange m)} with hF
  set L := List.finRange m with hL
  have hw : weylWordElement x.rootElement L ∈ F :=
    Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton_iff.2 rfl))
  have h0mem : x.rootElement (Pi.single ⟨0, by omega⟩ 1) 1 ∈ F :=
    Subgroup.subset_closure (by simp)
  have hα0 : (Pi.single (⟨0, by omega⟩ : Fin m) 1 : Fin m → ℤ) ∈ roots m :=
    single_mem_roots (isFiniteType_cartanC m) _
  have f0 : ∀ u, x.rootElement (Pi.single ⟨0, by omega⟩ 1) u ∈ F := by
    intro u
    have := range_subset_of_card_eq_prime_of_mem 3 Nat.prime_three hK
      (x.rootElement (Pi.single ⟨0, by omega⟩ 1)) (x.rootElement_add _ hα0) F h0mem
    exact this ⟨u, rfl⟩
  have fpow : ∀ (k : ℕ) {γ : Fin m → ℤ}, γ ∈ roots m → (∀ u, x.rootElement γ u ∈ F) →
      (reflectionWord (cartanC m) L ^ k) γ ∈ roots m ∧
        ∀ u, x.rootElement ((reflectionWord (cartanC m) L ^ k) γ) u ∈ F := by
    intro k γ hγ h
    rw [reflectionWord_pow_apply]
    exact (x.rootGroupIn_iterate F L hw ⟨hγ, h⟩ k).1
  have fpos : ∀ i : Fin m, i.val + 2 ≤ m → ∀ u, x.rootElement (Pi.single i 1) u ∈ F := by
    intro i hi
    have := (fpow i.val hα0 f0).2
    rwa [reflectionWord_pow_single_zero hm i hi] at this
  have fbeta : ∀ n : ℕ, n + 2 ≤ m →
      (partialSumRoot m n ∈ roots m) ∧ ∀ u, x.rootElement (partialSumRoot m n) u ∈ F := by
    intro n
    induction n with
    | zero =>
      intro _
      have : partialSumRoot m 0 = Pi.single ⟨0, by omega⟩ 1 := by
        have : Finset.univ.filter (fun j : Fin m ↦ j.val ≤ 0) = {⟨0, by omega⟩} := by
          ext j
          simp [Fin.ext_iff]
        rw [partialSumRoot, this, Finset.sum_singleton]
      rw [this]
      exact ⟨hα0, f0⟩
    | succ n ih =>
      intro hn
      obtain ⟨hp1, hp2⟩ := ih (by omega)
      have hu : OnlyPositiveCombination (roots m) (partialSumRoot m n)
          (Pi.single ⟨n + 1, by omega⟩ 1) (partialSumRoot m (n + 1)) :=
        onlyPositiveCombination_partialSumRoot hm ⟨n + 1, by omega⟩ (by simp) hn
      exact x.rootGroupIn_of_onlyPositiveCombination hx F ⟨hp1, hp2⟩
        ⟨single_mem_roots (isFiniteType_cartanC m) _, fpos ⟨n + 1, by omega⟩ hn⟩ hu
  obtain ⟨hβ1, hβ2⟩ := fbeta (m - 2) (by omega)
  have hrev : weylWordRootInv (cartanC m) L (partialSumRoot m (m - 2)) =
      -Pi.single (⟨m - 2, by omega⟩ : Fin m) 1 - Pi.single (⟨m - 1, by omega⟩ : Fin m) 1 := by
    rw [← reflectionWord_reverse_apply]
    exact reflectionWord_reverse_partialSumRoot hm
  have hγ1 : (-Pi.single (⟨m - 2, by omega⟩ : Fin m) 1 -
      Pi.single (⟨m - 1, by omega⟩ : Fin m) 1) ∈ roots m := by
    rw [← hrev]
    exact (x.weylWordElement_conj L _ hβ1).2.1
  have hγ2 : ∀ u, x.rootElement (-Pi.single (⟨m - 2, by omega⟩ : Fin m) 1 -
      Pi.single (⟨m - 1, by omega⟩ : Fin m) 1) u ∈ F := by
    rw [← hrev]
    exact (x.rootGroupIn_weylWordRoot F L hw ⟨hβ1, hβ2⟩).2.2
  have hu2 := onlyPositiveCombination_neg_single_last hm
  have hlast1 : (-Pi.single (⟨m - 1, by omega⟩ : Fin m) 1 : Fin m → ℤ) ∈ roots m := hu2.2.1
  have hlast2 : ∀ u, x.rootElement (-Pi.single (⟨m - 1, by omega⟩ : Fin m) 1) u ∈ F :=
    (x.rootGroupIn_of_onlyPositiveCombination hx F
      ⟨single_mem_roots (isFiniteType_cartanC m) _, fpos ⟨m - 2, by omega⟩ (by simp; omega)⟩
      ⟨hγ1, hγ2⟩ hu2).2
  have hneg : ∀ (i : Fin m) (u : K), x.rootElement (-Pi.single i 1) u ∈ F := by
    intro i u
    by_cases hi : i.val + 2 ≤ m
    · have := (fpow m (single_mem_roots (isFiniteType_cartanC m) i) (fpos i hi)).2 u
      rwa [reflectionWord_pow_apply_eq_neg hm] at this
    · have : i = ⟨m - 1, by omega⟩ := Fin.ext (by simp; omega)
      rw [this]
      exact hlast2 u
  have hpos : ∀ (i : Fin m) (u : K), x.rootElement (Pi.single i 1) u ∈ F := by
    intro i u
    by_cases hi : i.val + 2 ≤ m
    · exact fpos i hi u
    · have : i = ⟨m - 1, by omega⟩ := Fin.ext (by simp; omega)
      rw [this]
      have := (fpow m hlast1 hlast2).2 u
      rwa [reflectionWord_pow_apply_eq_neg hm, neg_neg] at this
  exact x.eq_top_of_simple_root_groups F hpos hneg

/-- Type `C` over `𝔽₃`: `G` is two-generated. -/
theorem twoGenerated (hm : 3 ≤ m)
    (x : SteinbergSystem (cartanC m) (isFiniteType_cartanC m) K G)
    (hx : x.HasUnitCommutatorConstants) (hK : Nat.card K = 3) : TwoGenerated G :=
  ⟨_, _, closure_pair_eq_top hm x hx hK⟩

end TypeCCardThree

end CFSGCorollary
