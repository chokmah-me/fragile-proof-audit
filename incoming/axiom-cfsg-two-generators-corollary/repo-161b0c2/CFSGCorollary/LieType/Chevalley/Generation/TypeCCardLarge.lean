module

public import CFSGCorollary.TwoGenerated.Basic
public import CFSGCorollary.LieType.Chevalley.Roots.TypeCCardLarge
public import CFSGCorollary.LieType.Steinberg.Diagonal
import CFSGCorollary.LieType.Steinberg.ClosurePair
import CFSGCorollary.LieType.Steinberg.GeneratingScalar

/-!
# Two-generation of Chevalley groups of type `C_m` over fields with at least four elements

Let `x` be a Steinberg system of type `C_m` (`m ≥ 2`) over a finite field `K` with `|K| ≥ 4`, and
let `r = TypeCCardLarge.rootR m`, `s = TypeCCardLarge.rootS m`,
`μ = TypeCCardLarge.cocharacter m` and `L = [0, …, m-1]`. Following Steinberg, we show
`G = ⟨h_μ(k), x r 1 · x s 1 · ω(L)⟩` for a generator `k` of `Kˣ`: the diagonal element `h_μ(k)`
and its conjugates by `ω(L)^{±1}` separate the root groups `X_r` and `X_s`, which then lie in the
generated subgroup, and the `w`-orbits of `r` and `s` contain all `±αᵢ`. No hypothesis on the
commutator constants is needed.

## Main results

* `TypeCCardLarge.closure_diagonal_mul_eq_top`: `G = ⟨h_μ(k), x r 1 · x s 1 · ω(L)⟩`.
* `TypeCCardLarge.twoGenerated`: `G` is generated by two elements.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary

namespace TypeCCardLarge

open CFSG.LieType.Universal.Symplectic

variable {m : ℕ} {K G : Type*} [Field K] [Finite K] [Group G]

/-- `G = ⟨h_μ(k), x r 1 · x s 1 · ω(L)⟩` for a generator `k` of `Kˣ`, `|K| ≥ 4`. -/
theorem closure_diagonal_mul_eq_top (hm : 2 ≤ m)
    (x : SteinbergSystem (cartanC m) (isFiniteType_cartanC m) K G)
    (hK : 4 ≤ Nat.card K) (k : Kˣ) (hk : Subgroup.zpowers k = ⊤) :
    Subgroup.closure {cocharacterElement x.rootElement (cocharacter m) k,
      x.rootElement (rootR m) 1 * x.rootElement (rootS m (by omega)) 1 *
        weylWordElement x.rootElement (List.finRange m)} = ⊤ := by
  have hm0 : 0 < m := by omega
  have hr := rootR_mem hm
  have hs := rootS_mem hm
  have hk1 : k ^ (1 : ℤ) ≠ 1 := by simpa using ne_one_of_zpowers_eq_top (by omega) hk
  have hk2 : k ^ (2 : ℤ) ≠ 1 := by simpa using sq_ne_one_of_zpowers_eq_top hK hk
  obtain ⟨hXr, hXs, hgF⟩ := x.rootGroupIn_closure_diagonal_mul_pair (List.finRange m)
    (cocharacter m) k hr hs
    (x.rootElement_commute _ hr _ hs (rootR_add_rootS_ne_zero hm)
      (noPositiveCombination_rootR_rootS hm))
    (n₁ := 1) (n₂ := 2) (n₃ := 1) (n₄ := -2) (cocharacterPairing_rootR hm)
    (cocharacterPairing_rootS hm)
    (by rw [← reflectionWord_reverse_apply]
        exact cocharacterPairing_reflectionWord_reverse_rootR hm)
    (by rw [← reflectionWord_reverse_apply]
        exact cocharacterPairing_reflectionWord_reverse_rootS hm)
    (by rw [← reflectionWord_apply]; exact cocharacterPairing_reflectionWord_rootR hm)
    (.zpow_of_zpowers_eq_top hk (.inl rfl))
    ⟨k⁻¹, by rw [Subgroup.zpowers_inv]; exact hk, Or.inr (by simp [zpow_neg])⟩
    hk1 hk2 hk1 (by simpa [zpow_neg] using hk2)
  exact x.eq_top_of_rootGroupIn _ _ hgF {rootR m, rootS m hm0}
    (by rintro ρ (rfl | rfl) <;> assumption) (inWeylWordOrbit_rootR_rootS hm)

/-- Type `C`, `|K| ≥ 4`: `G` is two-generated. -/
theorem twoGenerated (hm : 2 ≤ m)
    (x : SteinbergSystem (cartanC m) (isFiniteType_cartanC m) K G)
    (hK : 4 ≤ Nat.card K) : TwoGenerated G := by
  obtain ⟨k, hk⟩ := isCyclic_iff_exists_zpowers_eq_top.1 (inferInstance : IsCyclic Kˣ)
  exact ⟨_, _, closure_diagonal_mul_eq_top hm x hK k hk⟩

end TypeCCardLarge

end CFSGCorollary
