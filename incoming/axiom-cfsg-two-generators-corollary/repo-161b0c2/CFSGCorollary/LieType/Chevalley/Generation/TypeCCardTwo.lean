module

public import CFSGCorollary.TwoGenerated.Basic
public import CFSGCorollary.LieType.Chevalley.Generation.TypeCCardTwoIdentity
import CFSGCorollary.LieType.Chevalley.Symplectic
import CFSGCorollary.LieType.Steinberg.GeneratingScalar
import CFSGCorollary.LieType.Steinberg.SimpleRootGroups

/-!
# Two-generation of the symplectic groups over `𝔽₂`

Let `A = cartanC m` with `m ≥ 3`, `L' = [m-1, …, 0]`, `r' = α₀ + ⋯ + α_{m-2}` and
`s' = −α_{m-1}`. For Steinberg data of type `C_m` over `𝔽₂` satisfying the commutator identity
`TypeCCardTwo.CommutatorIdentity`, we follow Steinberg (3.14) and show
`G = ⟨x r' 1 · x s' 1, ω(L')⟩`: the identity puts `x α_{m-2} 1` in the generated subgroup, the
`w'`-orbits give the root groups `X_{±αᵢ}` for `i ≤ m - 2`, hence `x r' 1` and `x s' 1`, and the
`w'`-orbit of `s'` gives `X_{±α_{m-1}}`. Since the identity holds in `Sp_{2m}(𝔽₂)`, this group is
two-generated.

## Main results

* `TypeCCardTwo.twoGenerated_statedSp`: `Sp_{2m}(𝔽₂)` is generated by two elements.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary

namespace TypeCCardTwo

open CFSG.LieType.Universal.Symplectic
open scoped commutatorElement

variable {m : ℕ} {K G : Type*} [Field K] [Finite K] [Group G]

private theorem closure_pair_eq_top (hm : 3 ≤ m)
    (data : SteinbergData (cartanC m) (isFiniteType_cartanC m) K G)
    (hK : Nat.card K = 2) (hid : CommutatorIdentity hm data.rootElement) :
    Subgroup.closure {productElement hm data.rootElement,
      weylWordElement data.rootElement (coxeterList m)} = ⊤ := by
  set x := data.rootElement with hx
  set F := Subgroup.closure {productElement hm x, weylWordElement x (coxeterList m)} with hF
  have hy : productElement hm x ∈ F := Subgroup.subset_closure (by simp)
  have hω : weylWordElement x (coxeterList m) ∈ F := Subgroup.subset_closure (by simp)
  have hcomm : ∀ a b : G, a ∈ F → b ∈ F → ⁅a, b⁆ ∈ F := by
    intro a b ha hb
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem ha hb) (inv_mem ha)) (inv_mem hb)
  have hα : x (Pi.single (⟨m - 2, by omega⟩ : Fin m) 1) 1 ∈ F := by
    rw [← hid]
    refine hcomm _ _ hy (hcomm _ _ ?_ (hcomm _ _ hy ?_))
    · unfold conjPowElement
      exact mul_mem (mul_mem (pow_mem hω _) hy) (inv_mem (pow_mem hω _))
    · unfold conjPowElement
      exact mul_mem (mul_mem (pow_mem hω _) hy) (inv_mem (pow_mem hω _))
  have R : ∀ γ ∈ roots m, x γ 1 ∈ F → ∀ u, x γ u ∈ F := by
    intro γ hγ h1 u
    exact range_subset_of_card_eq_prime_of_mem 2 Nat.prime_two hK (x γ)
      (data.rootElement_add γ hγ) F h1 ⟨u, rfl⟩
  have Wstep : ∀ L : List (Fin m), weylWordElement x L ∈ F → ∀ γ ∈ roots m, x γ 1 ∈ F →
      x (weylWordRoot (cartanC m) L γ) 1 ∈ F := by
    intro L hL γ hγ h1
    obtain ⟨ε, hε, h⟩ := data.weylWordElement_conj_rootElement L γ hγ
    have hε2 : (ε : K) * ε = 1 := by rcases hε with rfl | rfl <;> simp
    have := h ε
    rw [hε2] at this
    change data.rootElement _ 1 ∈ F
    rw [← this]
    exact mul_mem (mul_mem hL (R γ hγ h1 _)) (inv_mem hL)
  have P : ∀ k : ℕ, ∀ γ ∈ roots m, x γ 1 ∈ F →
      (reflectionWord (cartanC m) (coxeterList m) ^ k) γ ∈ roots m ∧
        x ((reflectionWord (cartanC m) (coxeterList m) ^ k) γ) 1 ∈ F := by
    intro k
    induction k with
    | zero =>
      intro γ hγ h1
      simpa using ⟨hγ, h1⟩
    | succ k ih =>
      intro γ hγ h1
      obtain ⟨h2, h3⟩ := ih γ hγ h1
      rw [pow_succ', Module.End.mul_apply, reflectionWord_apply]
      exact ⟨weylWordRoot_mem_roots _ _ h2, Wstep _ hω _ h2 h3⟩
  -- simple roots `α_i`, `i ≤ m - 2`
  have hlow : ∀ (i : Fin m), i.val + 2 ≤ m → ∀ γ : Fin m → ℤ,
      (γ = Pi.single i 1 ∨ γ = -Pi.single i 1) → x γ 1 ∈ F := by
    intro i hi γ hγ
    obtain ⟨k, hk⟩ := exists_reflectionWord_pow_single hm i hi γ hγ
    have := (P k _ (single_mem_roots (isFiniteType_cartanC m) _) hα).2
    rwa [hk] at this
  have hlowall : ∀ (i : Fin m), i.val + 2 ≤ m → ∀ γ : Fin m → ℤ,
      (γ = Pi.single i 1 ∨ γ = -Pi.single i 1) → ∀ u, x γ u ∈ F := by
    intro i hi γ hγ u
    have hmem : γ ∈ roots m := by
      rcases hγ with rfl | rfl
      · exact single_mem_roots (isFiniteType_cartanC m) i
      · obtain ⟨k, hk⟩ := exists_reflectionWord_pow_single hm i hi _ (Or.inr rfl)
        have := (P k _ (single_mem_roots (isFiniteType_cartanC m) _) hα).1
        rwa [hk] at this
    exact R γ hmem (hlow i hi γ hγ) u
  have hωi : ∀ i : Fin m, i.val + 2 ≤ m →
      CFSG.LieType.Steinberg.weylElement x i (1 : Kˣ) ∈ F := by
    intro i hi
    unfold CFSG.LieType.Steinberg.weylElement
    exact mul_mem (mul_mem (hlowall i hi _ (Or.inl rfl) _) (hlowall i hi _ (Or.inr rfl) _))
      (hlowall i hi _ (Or.inl rfl) _)
  have hg : weylWordElement x (reflectionList m) ∈ F := by
    unfold weylWordElement
    refine Subgroup.list_prod_mem _ ?_
    intro g hg
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hg
    have : i ∈ reflectionList m := hi
    simp only [reflectionList, List.mem_reverse, List.mem_filter, List.mem_finRange,
      true_and, decide_eq_true_eq] at this
    exact hωi i this.2
  have hr : x (rootR m) 1 ∈ F := by
    have := Wstep _ hg (Pi.single ⟨0, by omega⟩ 1) (single_mem_roots (isFiniteType_cartanC m) _)
      (hlow ⟨0, by omega⟩ (by simp; omega) _ (Or.inl rfl))
    rwa [← reflectionWord_apply, reflectionWord_reflectionList_single_zero hm] at this
  have hs : x (rootS m (by omega)) 1 ∈ F := by
    have : x (rootS m (by omega)) 1 = (x (rootR m) 1)⁻¹ * productElement hm x := by
      unfold productElement
      group
    rw [this]
    exact mul_mem (inv_mem hr) hy
  have hhigh : ∀ γ : Fin m → ℤ,
      (γ = Pi.single (⟨m - 1, by omega⟩ : Fin m) 1 ∨
        γ = -Pi.single (⟨m - 1, by omega⟩ : Fin m) 1) → ∀ u, x γ u ∈ F := by
    intro γ hγ u
    obtain ⟨k, hk⟩ := exists_reflectionWord_pow_rootS hm γ hγ
    have := P k _ (rootS_mem hm) hs
    rw [hk] at this
    exact R γ this.1 this.2 u
  refine data.eq_top_of_simple_root_groups F (fun i u ↦ ?_) (fun i u ↦ ?_)
  · by_cases hi : i.val + 2 ≤ m
    · exact hlowall i hi _ (Or.inl rfl) u
    · have : i = ⟨m - 1, by omega⟩ := Fin.ext (by simp; omega)
      rw [this]
      exact hhigh _ (Or.inl rfl) u
  · by_cases hi : i.val + 2 ≤ m
    · exact hlowall i hi _ (Or.inr rfl) u
    · have : i = ⟨m - 1, by omega⟩ := Fin.ext (by simp; omega)
      rw [this]
      exact hhigh _ (Or.inr rfl) u

/-- `Sp_{2m}(𝔽)` in characteristic two with `|𝔽| = 2` is two-generated (no extra hypotheses). -/
theorem twoGenerated_statedSp (hm : 3 ≤ m) {F : Type} [Field F] [Finite F]
    (hF : Nat.card F = 2) :
    TwoGenerated (CFSG.Open.StatedSp m F) := by
  have : CharP F 2 := by
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have := Fintype.ofFinite F
    exact charP_of_card_eq_prime (R := F) (p := 2) (by rwa [← Nat.card_eq_fintype_card])
  obtain ⟨data, hdata, -⟩ := Sp.exists_steinbergData m (by omega) F
  have hid : CommutatorIdentity hm data.rootElement := by
    rw [hdata]
    exact commutatorIdentity_sp hm
  exact ⟨_, _, closure_pair_eq_top hm data hF hid⟩

end TypeCCardTwo

end CFSGCorollary
