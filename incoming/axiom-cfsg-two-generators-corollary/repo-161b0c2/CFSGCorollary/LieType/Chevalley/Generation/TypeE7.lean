module

public import CFSGCorollary.LieType.Chevalley.Roots.TypeE7
public import CFSGCorollary.TwoGenerated.Basic
public import CFSGCorollary.LieType.Steinberg.Diagonal
import CFSGCorollary.LieType.Steinberg.ClosurePair
import CFSGCorollary.LieType.Steinberg.GeneratingScalar

/-!
# Two-generation of Chevalley groups of type `E₇`

Steinberg's theorem 3.11 for type `E₇`: a group `G` with a Steinberg system of type `E₇` over a
finite field `K` is generated by two elements. With `a = α₆`, `L` as in `TypeE7.coxeterList` and
`ω(L)` the corresponding product of Weyl elements:

* if `|K| ≥ 4` and `k` generates `Kˣ`, then `G = ⟨h_a(k), x_a(1) ω(L)⟩`;
* if `|K| ≤ 3`, then `G = ⟨x_a(1), ω(L)⟩`.

In both cases one first shows that the generated subgroup contains `X_a` and `ω(L)`. Since
`w⁹ = -1`, conjugation by `ω(L)⁹` then gives `X_{-a}`, and every root group `X_{±αᵢ}` is
recovered from the root identities of `Roots.TypeE7`.

## Main results

* `TypeE7.closure_diagonal_mul_eq_top`: the case `|K| ≥ 4`.
* `TypeE7.closure_pair_eq_top_of_card_le_three`: the case `|K| ≤ 3`.
* `TypeE7.twoGenerated`: `G` is two-generated.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TypeE7

section Conj

variable {rank : ℕ} {K G : Type*} [Field K] [Group G]

private theorem mem_of_conj_mem (x : (Fin rank → ℤ) → K → G) (F : Subgroup G) {g : G}
    (hg : g ∈ F) {γ δ : Fin rank → ℤ} {ε : ℤ} (hε : ε = 1 ∨ ε = -1)
    (h : ∀ u : K, g * x γ u * g⁻¹ = x δ ((ε : K) * u)) (hγ : ∀ u, x γ u ∈ F) (v : K) :
    x δ v ∈ F := by
  have hsq : (ε : K) * ((ε : K) * v) = v := by
    rcases hε with rfl | rfl <;> simp
  have := h ((ε : K) * v)
  rw [hsq] at this
  rw [← this]
  exact F.mul_mem (F.mul_mem hg (hγ _)) (F.inv_mem hg)

end Conj

variable {K G : Type*} [Field K] [Finite K] [Group G]

/-- A subgroup containing the root group `X_a` and `ω(L)` is the whole group. -/
theorem eq_top_of_rootElement_mem_of_weylWordElement_mem
    (system : SteinbergSystem cartan isFiniteType K G) (F : Subgroup G)
    (hax : ∀ u, system.rootElement (simpleRoot 6) u ∈ F)
    (hω : weylWordElement system.rootElement coxeterList ∈ F) : F = ⊤ := by
  set ω := weylWordElement system.rootElement coxeterList with hωdef
  have hword : ∀ γ, weylWordRoot cartan coxeterList γ = coxeterElement γ := fun γ ↦
    (reflectionWord_apply cartan coxeterList γ).symm
  have hwordInv : ∀ γ, weylWordRootInv cartan coxeterList γ = coxeterElementInv γ := fun γ ↦
    (reflectionWord_reverse_apply cartan coxeterList γ).symm
  have hpow : ∀ n : ℕ, ∀ γ ∈ rootSet, ∃ ε : ℤ, (ε = 1 ∨ ε = -1) ∧
      (coxeterElement ^ n) γ ∈ rootSet ∧ ∀ u : K, ω ^ n * system.rootElement γ u * (ω ^ n)⁻¹ =
        system.rootElement ((coxeterElement ^ n) γ) ((ε : K) * u) := by
    intro n
    induction n with
    | zero => intro γ hγ; exact ⟨1, Or.inl rfl, by simpa using hγ, fun u ↦ by simp⟩
    | succ n ih =>
      intro γ hγ
      obtain ⟨ε, hε, hm, h⟩ := ih γ hγ
      obtain ⟨hm1, -, ε', ε2, hε', hε2, h'⟩ := system.weylWordElement_conj coxeterList _ hm
      have hs : (coxeterElement ^ (n + 1)) γ =
          weylWordRoot cartan coxeterList ((coxeterElement ^ n) γ) := by
        rw [hword, pow_succ', Module.End.mul_apply]
      refine ⟨ε' * ε, ?_, ?_, fun u ↦ ?_⟩
      · rcases hε with rfl | rfl <;> rcases hε' with rfl | rfl <;> simp
      · rw [hs]; exact hm1
      · rw [hs]
        have e : ω ^ (n + 1) * system.rootElement γ u * (ω ^ (n + 1))⁻¹ =
            ω * (ω ^ n * system.rootElement γ u * (ω ^ n)⁻¹) * ω⁻¹ := by
          rw [pow_succ']; group
        rw [e, h u, (h' _).1]
        push_cast; rw [mul_assoc]
  have hmemroot : ∀ i : Fin 7, simpleRoot i ∈ rootSet := fun i ↦ Or.inl ⟨1, i, by simp⟩
  let R : Set (Fin 7 → ℤ) := {γ | system.RootGroupIn F γ}
  have hWm : ∀ v ∈ R, coxeterElement v ∈ R := fun v hv ↦ by
    have := (system.rootGroupIn_weylWordRoot F coxeterList hω hv).1
    rwa [hword] at this
  have hWi : ∀ v ∈ R, coxeterElementInv v ∈ R := fun v hv ↦ by
    have := (system.rootGroupIn_weylWordRoot F coxeterList hω hv).2
    rwa [hwordInv] at this
  have hS : ∀ j : Fin 7, CFSG.LieType.Steinberg.weylElement system.rootElement j (1 : Kˣ) ∈ F →
      ∀ v ∈ R, simpleReflection j v ∈ R :=
    fun j hj _ hv ↦ system.rootGroupIn_reflection F j hj hv
  have hA : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot 6 ∈ R := by
    intro ε hε
    rcases hε with rfl | rfl
    · exact ⟨by simpa using hmemroot 6, by simpa using hax⟩
    · obtain ⟨ε, hε, hm, h⟩ := hpow 9 _ (hmemroot 6)
      rw [coxeterElement_pow_apply_eq_neg] at hm h
      rw [neg_smul, one_smul]
      exact ⟨hm, mem_of_conj_mem system.rootElement F (F.pow_mem hω 9) hε h hax⟩
  have hωj : ∀ j : Fin 7, (∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot j ∈ R) →
      CFSG.LieType.Steinberg.weylElement system.rootElement j (1 : Kˣ) ∈ F := by
    intro j hT
    have p1 : ∀ u, system.rootElement (Pi.single j 1) u ∈ F := by
      simpa only [one_smul] using (hT 1 (Or.inl rfl)).2
    have p2 : ∀ u, system.rootElement (-Pi.single j 1) u ∈ F := by
      simpa only [neg_smul, one_smul] using (hT (-1) (Or.inr rfl)).2
    unfold CFSG.LieType.Steinberg.weylElement
    exact mul_mem (mul_mem (p1 _) (p2 _)) (p1 _)
  have hneg : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → (-ε = 1 ∨ -ε = -1) := by
    intro ε hε; rcases hε with rfl | rfl <;> simp
  have T5 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot 5 ∈ R := by
    intro ε hε
    rw [smul_simpleRoot_five ε hε]; exact hWm _ (hA ε hε)
  have T4 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot 4 ∈ R := by
    intro ε hε
    rw [smul_simpleRoot_four ε hε, pow_two, Module.End.mul_apply]
    exact hWm _ (hWm _ (hA ε hε))
  have T3 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot 3 ∈ R := by
    intro ε hε
    rw [smul_simpleRoot_three ε hε, pow_three, Module.End.mul_apply, Module.End.mul_apply]
    exact hWm _ (hWm _ (hWm _ (hA ε hε)))
  have ω3 := hωj 3 T3
  have ω4 := hωj 4 T4
  have T2 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot 2 ∈ R := by
    intro ε hε
    rw [smul_simpleRoot_two ε hε, pow_two, Module.End.mul_apply]
    exact hS 3 ω3 _ (hWi _ (hWi _ (hA _ (hneg ε hε))))
  have T0 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot 0 ∈ R := by
    intro ε hε
    rw [smul_simpleRoot_zero ε hε, pow_two, Module.End.mul_apply]
    exact hWm _ (hS 3 ω3 _ (hWi _ (hWi _ (hA _ (hneg ε hε)))))
  have T1 : ∀ ε : ℤ, (ε = 1 ∨ ε = -1) → ε • simpleRoot 1 ∈ R := by
    intro ε hε
    rw [smul_simpleRoot_one ε hε, pow_three, Module.End.mul_apply, Module.End.mul_apply]
    exact hS 3 ω3 _ (hS 4 ω4 _ (hWi _ (hWi _ (hWi _ (hA _ (hneg ε hε))))))
  have T : ∀ (i : Fin 7) (ε : ℤ), (ε = 1 ∨ ε = -1) → ε • simpleRoot i ∈ R := by
    intro i
    fin_cases i
    · exact T0
    · exact T1
    · exact T2
    · exact T3
    · exact T4
    · exact T5
    · exact hA
  refine system.eq_top_of_simple_root_groups F (fun i u ↦ ?_) (fun i u ↦ ?_)
  · simpa only [one_smul] using (T i 1 (Or.inl rfl)).2 u
  · simpa only [neg_smul, one_smul] using (T i (-1) (Or.inr rfl)).2 u

theorem sum_simpleRoot_six_mul (f : Fin 7 → ℤ) : ∑ i, simpleRoot 6 i * f i = f 6 := by
  simp [simpleRoot, Pi.single_apply]

/-- [Steinberg1962] 3.11 for `E₇`, `|K| ≥ 4`: `G` is generated by `h_a(k)` and `x_a(1) ω(L)`,
where `a = α₆` and `k` generates `Kˣ`. -/
theorem closure_diagonal_mul_eq_top (system : SteinbergSystem cartan isFiniteType K G)
    (hK : 4 ≤ Nat.card K) {k : Kˣ} (hk : Subgroup.zpowers k = ⊤) :
    Subgroup.closure
      {cocharacterElement system.rootElement (simpleRoot 6) k,
        system.rootElement (simpleRoot 6) 1 * weylWordElement system.rootElement coxeterList} =
      ⊤ := by
  have ha : simpleRoot 6 ∈ rootSet := Or.inl ⟨1, 6, by simp⟩
  have hk1 := ne_one_of_zpowers_eq_top (by omega) hk
  have hk2 := sq_ne_one_of_zpowers_eq_top hK hk
  obtain ⟨h1, h2⟩ := system.rootGroupIn_closure_diagonal_mul coxeterList (simpleRoot 6) k ha
    (n := 2) (n' := -1)
    (by rw [cocharacterPairing, sum_simpleRoot_six_mul]; exact pairing_simpleRoot_last)
    (by
      rw [cocharacterPairing, sum_simpleRoot_six_mul, ← reflectionWord_reverse_apply]
      exact pairing_coxeterElementInv_simpleRoot_last)
    ⟨k, hk, Or.inr (by simp)⟩ (by simpa using hk2) (by simpa using hk1)
  exact eq_top_of_rootElement_mem_of_weylWordElement_mem system _ h1.2 h2

/-- [Steinberg1962] 3.11 for `E₇`, `|K| ≤ 3`: `G` is generated by `x_a(1)` and `ω(L)`. -/
theorem closure_pair_eq_top_of_card_le_three (system : SteinbergSystem cartan isFiniteType K G)
    (hK : Nat.card K ≤ 3) :
    Subgroup.closure
      {system.rootElement (simpleRoot 6) 1, weylWordElement system.rootElement coxeterList} =
      ⊤ := by
  have ha : simpleRoot 6 ∈ rootSet := Or.inl ⟨1, 6, by simp⟩
  have h2 : 2 ≤ Nat.card K := Nat.succ_le_of_lt Finite.one_lt_card
  have hp : (Nat.card K).Prime := by
    interval_cases h : Nat.card K
    · exact Nat.prime_two
    · exact Nat.prime_three
  have hsub := range_subset_of_card_eq_prime_of_mem (Nat.card K) hp rfl
    (system.rootElement (simpleRoot 6)) (system.rootElement_add _ ha)
    (Subgroup.closure
      {system.rootElement (simpleRoot 6) 1, weylWordElement system.rootElement coxeterList})
    (Subgroup.subset_closure (by simp))
  exact eq_top_of_rootElement_mem_of_weylWordElement_mem system _ (fun u ↦ hsub ⟨u, rfl⟩)
    (Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

/-- [Steinberg1962] 3.11 for `E₇`: `G` is two-generated. -/
theorem twoGenerated (system : SteinbergSystem cartan isFiniteType K G) : TwoGenerated G := by
  by_cases hK : 4 ≤ Nat.card K
  · obtain ⟨k, hk⟩ := IsCyclic.exists_generator (α := Kˣ)
    exact ⟨_, _, closure_diagonal_mul_eq_top system hK
      (k := k) (Subgroup.eq_top_iff' _ |>.mpr hk)⟩
  · exact ⟨_, _, closure_pair_eq_top_of_card_le_three system (by omega)⟩

end CFSGCorollary.TypeE7
