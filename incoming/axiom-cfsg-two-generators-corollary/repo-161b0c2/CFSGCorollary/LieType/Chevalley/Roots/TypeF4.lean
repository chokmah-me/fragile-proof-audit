module

public import CFSGCorollary.LieType.Steinberg.WeylWord
public import CFSG.Blueprint.Chevalley
import CFSG.LieType.Chevalley.WeylRoots

/-!
# Root computations for type `F₄`

Root-level facts about the Cartan matrix `A` of type `F₄` (in CFSG's labelling, over `Fin 4`)
used in Steinberg's proof that the Chevalley group `F₄(K)` is generated by two elements, with
`L = [0, 1, 2, 3]` and `w = w_L` the corresponding Coxeter element.

Non-membership of positive combinations in the root system is reduced to polynomial inequalities
through the `W`-invariant quadratic form `normForm`, which takes only the values `2` and `4` on
roots. All concrete identities are checked by `decide`.

* For `|K| ≥ 3` we use the roots `r = α₃`, `s = -α₁` and the cocharacter `μ = (-1, -1, 0, 0)`:
  `r` and `s` have no positive combination, and every `±αᵢ` lies in the `w`-orbit of `r` or `s`.
* For `|K| = 2` we use the roots `r₂`, `s₂` and their images under `w` and `w⁵`, whose
  commutators produce the roots `t₁`, `t₂`; every `±αᵢ` is then obtained from `t₁`, `t₂` using
  `w`, `w⁻¹` and simple reflections.

## Main results

* `TypeF4.normForm_of_mem`: `normForm` takes the values `2` and `4` on roots.
* `TypeF4.exists_coxeterElement_pow_eq`: every `±αᵢ` is `wᵏ r` or `wᵏ s` for some `k`.
* `TypeF4.onlyPositiveCombination_rootRCardTwo_rootRCardTwoPowFive`,
  `TypeF4.onlyPositiveCombination_rootSCardTwo_rootSCardTwoPowOne`: the positive combinations
  `t₁` and `t₂` used for `|K| = 2`.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

open CFSG.LieType.RootSystem

namespace CFSGCorollary.TypeF4

/-- The Cartan matrix of type `F₄`, as a matrix over `Fin 4` (numerals do not elaborate in
`Fin τ.rank`). -/
abbrev cartan : Matrix (Fin 4) (Fin 4) ℤ := CFSG.Blueprint.Chevalley.Tag.cartan .F4

theorem isFiniteType : TauCeti.IsFiniteType cartan :=
  CFSG.LieType.Chevalley.isFiniteType_cartan .F4

/-- The list `L = [0, 1, 2, 3]` of simple roots. -/
def coxeterList : List (Fin 4) := [0, 1, 2, 3]

/-- The Coxeter element `w = w_L`. -/
noncomputable abbrev coxeterElement : Module.End ℤ (Fin 4 → ℤ) :=
  reflectionWord cartan coxeterList

/-- The inverse `w⁻¹ = w_L⁻¹`: the reflections of `L` in the reverse order. -/
noncomputable abbrev coxeterElementInv : Module.End ℤ (Fin 4 → ℤ) :=
  reflectionWord cartan coxeterList.reverse

/-- The simple root `αᵢ`. -/
abbrev simpleRoot (i : Fin 4) : Fin 4 → ℤ := Pi.single i 1

/-- The simple reflection `sⱼ`. -/
noncomputable abbrev simpleReflection (j : Fin 4) : Module.End ℤ (Fin 4 → ℤ) :=
  reflection cartan j

/-- The root system `Φ`. -/
abbrev rootSet : Set (Fin 4 → ℤ) := roots isFiniteType ∅

/-! ### An invariant of the root system -/

/-- The `W`-invariant quadratic form `v ↦ ∑ᵢ dᵢ vᵢ (A v)ᵢ`, `d = (2, 2, 1, 1)`. -/
def normForm (v : Fin 4 → ℤ) : ℤ := ∑ i, ![2, 2, 1, 1] i * v i * ∑ j, cartan i j * v j

theorem normForm_eq (v : Fin 4 → ℤ) :
    normForm v = 4 * v 0 ^ 2 + 4 * v 1 ^ 2 + 2 * v 2 ^ 2 + 2 * v 3 ^ 2 - 4 * v 0 * v 1
      - 4 * v 1 * v 2 - 2 * v 2 * v 3 := by
  simp [normForm, Fin.sum_univ_four, CFSG.Blueprint.Chevalley.Tag.cartan]
  ring

theorem normForm_reflection (j : Fin 4) (v : Fin 4 → ℤ) :
    normForm (simpleReflection j v) = normForm v := by
  simp only [simpleReflection, reflection_apply, normForm_eq]
  fin_cases j <;>
    simp [Fin.sum_univ_four, CFSG.Blueprint.Chevalley.Tag.cartan] <;> ring

theorem normForm_weylAction (w : (coxeterMatrix isFiniteType).Group) (v : Fin 4 → ℤ) :
    normForm (weylAction isFiniteType w v) = normForm v := by
  induction w using (coxeterMatrix isFiniteType).toCoxeterSystem.simple_induction_left
    generalizing v with
  | one => simp
  | mul_simple_left w j ih =>
    rw [weylAction_mul_apply, weylAction_simple, normForm_reflection, ih]

theorem normForm_of_mem {v : Fin 4 → ℤ} (h : v ∈ rootSet) : normForm v = 2 ∨ normForm v = 4 := by
  rcases h with ⟨w, k, rfl⟩ | ⟨w, k, hk, -⟩
  · rw [normForm_weylAction]
    fin_cases k <;> decide +kernel
  · exact absurd hk (Set.notMem_empty k)

theorem mem_rootSet_reflectionWord (L : List (Fin 4)) (i : Fin 4) :
    reflectionWord cartan L (Pi.single i 1) ∈ rootSet := by
  rw [reflectionWord_apply]
  exact weylWordRoot_mem_roots isFiniteType L (single_mem_roots isFiniteType i)

/-- Reduces a membership `i • u + j • v ∈ rootSet` to a polynomial identity in `i, j`. -/
theorem normForm_smul_add {u v : Fin 4 → ℤ} {i j : ℕ} (h : i • u + j • v ∈ rootSet) :
    (4 * (i * u 0 + j * v 0) ^ 2 + 4 * (i * u 1 + j * v 1) ^ 2 + 2 * (i * u 2 + j * v 2) ^ 2
      + 2 * (i * u 3 + j * v 3) ^ 2 - 4 * (i * u 0 + j * v 0) * (i * u 1 + j * v 1)
      - 4 * (i * u 1 + j * v 1) * (i * u 2 + j * v 2)
      - 2 * (i * u 2 + j * v 2) * (i * u 3 + j * v 3) : ℤ) = 2 ∨
    (4 * (i * u 0 + j * v 0) ^ 2 + 4 * (i * u 1 + j * v 1) ^ 2 + 2 * (i * u 2 + j * v 2) ^ 2
      + 2 * (i * u 3 + j * v 3) ^ 2 - 4 * (i * u 0 + j * v 0) * (i * u 1 + j * v 1)
      - 4 * (i * u 1 + j * v 1) * (i * u 2 + j * v 2)
      - 2 * (i * u 2 + j * v 2) * (i * u 3 + j * v 3) : ℤ) = 4 := by
  simpa [normForm_eq] using normForm_of_mem h

/-! ### The case `|K| ≥ 3` -/

/-- The root `r = α₃`. -/
def rootR : Fin 4 → ℤ := simpleRoot 3

/-- The root `s = -α₁`. -/
def rootS : Fin 4 → ℤ := -simpleRoot 1

/-- The cocharacter `μ = (-1, -1, 0, 0)`. -/
def cocharacter : Fin 4 → ℤ := ![-1, -1, 0, 0]

theorem rootR_mem : rootR ∈ rootSet := by
  simpa [reflectionWord, rootR] using mem_rootSet_reflectionWord [] 3

theorem rootS_mem : rootS ∈ rootSet := by
  convert mem_rootSet_reflectionWord [1] 1 using 1
  decide +kernel

theorem rootR_add_rootS_ne_zero : rootR + rootS ≠ 0 := by
  decide +kernel

theorem noPositiveCombination_rootR_rootS : NoPositiveCombination rootSet rootR rootS := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootR, rootS, simpleRoot, ne_eq, Fin.reduceEq, not_false_eq_true,
    Pi.single_eq_of_ne, Pi.single_eq_same, Pi.neg_apply, neg_zero] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

/-- `e(r) = 0`, where `e = cocharacterPairing A μ` is the exponent of `h_μ(k)` on a root group. -/
theorem cocharacterPairing_rootR : cocharacterPairing cartan cocharacter rootR = 0 := by
  decide +kernel

theorem cocharacterPairing_rootS :
    cocharacterPairing cartan cocharacter rootS = 1 ∨
      cocharacterPairing cartan cocharacter rootS = -1 := by
  decide +kernel

theorem cocharacterPairing_coxeterElementInv_rootR :
    cocharacterPairing cartan cocharacter (coxeterElementInv rootR) = 1 ∨
      cocharacterPairing cartan cocharacter (coxeterElementInv rootR) = -1 := by
  decide +kernel

theorem cocharacterPairing_coxeterElementInv_rootS :
    cocharacterPairing cartan cocharacter (coxeterElementInv rootS) = 1 ∨
      cocharacterPairing cartan cocharacter (coxeterElementInv rootS) = -1 := by
  decide +kernel

theorem cocharacterPairing_coxeterElement_rootR :
    cocharacterPairing cartan cocharacter (coxeterElement rootR) = 1 ∨
      cocharacterPairing cartan cocharacter (coxeterElement rootR) = -1 := by
  decide +kernel

/-- Every `±αᵢ` lies in the `w`-orbit of `r` or of `s` (`w` has order `12`, so exponents below
`12` suffice). -/
theorem exists_coxeterElement_pow_eq (i : Fin 4) (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ∃ k : ℕ, ε • simpleRoot i = (coxeterElement ^ k) rootR ∨
      ε • simpleRoot i = (coxeterElement ^ k) rootS := by
  have : ∃ k : Fin 12, ε • simpleRoot i = (coxeterElement ^ (k : ℕ)) rootR ∨
      ε • simpleRoot i = (coxeterElement ^ (k : ℕ)) rootS := by
    revert i
    rcases hε with rfl | rfl <;> decide +kernel
  obtain ⟨k, hk⟩ := this
  exact ⟨k, hk⟩

/-! ### The case `|K| = 2` -/

/-- The root `r₂ = (-2, -3, -4, -2)`. -/
def rootRCardTwo : Fin 4 → ℤ := ![-2, -3, -4, -2]

/-- The root `s₂ = (-1, -1, -2, -1)`. -/
def rootSCardTwo : Fin 4 → ℤ := ![-1, -1, -2, -1]

/-- The root `w⁵ r₂ = (1, 2, 2, 0)`. -/
def rootRCardTwoPowFive : Fin 4 → ℤ := ![1, 2, 2, 0]

/-- The root `w⁵ s₂ = (0, 1, 1, 0)`. -/
def rootSCardTwoPowFive : Fin 4 → ℤ := ![0, 1, 1, 0]

/-- The root `w r₂ = (-1, -3, -4, -2)`. -/
def rootRCardTwoPowOne : Fin 4 → ℤ := ![-1, -3, -4, -2]

/-- The root `w s₂ = (0, -1, -1, -1)`. -/
def rootSCardTwoPowOne : Fin 4 → ℤ := ![0, -1, -1, -1]

/-- The root `t₁ = r₂ + w⁵ r₂ = (-1, -1, -2, -2)`. -/
def rootRCardTwoSum : Fin 4 → ℤ := ![-1, -1, -2, -2]

/-- The root `t₂ = s₂ + w s₂ = (-1, -2, -3, -2)`. -/
def rootSCardTwoSum : Fin 4 → ℤ := ![-1, -2, -3, -2]

theorem rootRCardTwo_mem : rootRCardTwo ∈ rootSet := by
  convert mem_rootSet_reflectionWord [0, 1, 2, 3, 1, 2, 1, 0] 0 using 1
  decide +kernel

theorem rootSCardTwo_mem : rootSCardTwo ∈ rootSet := by
  convert mem_rootSet_reflectionWord [2, 3, 0, 1, 2] 2 using 1
  decide +kernel

theorem rootRCardTwoSum_mem : rootRCardTwoSum ∈ rootSet := by
  convert mem_rootSet_reflectionWord [3, 2, 1, 0] 0 using 1
  decide +kernel

theorem rootSCardTwoSum_mem : rootSCardTwoSum ∈ rootSet := by
  convert mem_rootSet_reflectionWord [3, 2, 1, 2, 3, 0, 1, 2] 2 using 1
  decide +kernel

theorem noPositiveCombination_rootRCardTwo_rootSCardTwo :
    NoPositiveCombination rootSet rootRCardTwo rootSCardTwo := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootRCardTwo, rootSCardTwo, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

theorem coxeterElement_pow_five_rootRCardTwo :
    (coxeterElement ^ 5) rootRCardTwo = rootRCardTwoPowFive := by
  decide +kernel

theorem coxeterElement_pow_five_rootSCardTwo :
    (coxeterElement ^ 5) rootSCardTwo = rootSCardTwoPowFive := by
  decide +kernel

theorem coxeterElement_rootRCardTwo : coxeterElement rootRCardTwo = rootRCardTwoPowOne := by
  decide +kernel

theorem coxeterElement_rootSCardTwo : coxeterElement rootSCardTwo = rootSCardTwoPowOne := by
  decide +kernel

/-- `t₁` is the only positive combination of `r₂` and `w⁵ r₂` in `Φ`. -/
theorem onlyPositiveCombination_rootRCardTwo_rootRCardTwoPowFive :
    OnlyPositiveCombination rootSet rootRCardTwo rootRCardTwoPowFive rootRCardTwoSum := by
  refine ⟨by decide +kernel, rootRCardTwoSum_mem, fun i j hi hj hmem ↦ ?_⟩
  have h := normForm_smul_add hmem
  simp only [rootRCardTwo, rootRCardTwoPowFive, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  have hib : (i : ℤ) ≤ 3 := by rcases h with h | h <;> nlinarith [sq_nonneg ((i : ℤ) - j)]
  have hjb : (j : ℤ) ≤ 3 := by rcases h with h | h <;> nlinarith [sq_nonneg ((i : ℤ) - j)]
  have hib' : i ≤ 3 := by exact_mod_cast hib
  have hjb' : j ≤ 3 := by exact_mod_cast hjb
  interval_cases i <;> interval_cases j <;> simp_all

theorem rootRCardTwoPowFive_sub_rootRCardTwo_notMem :
    rootRCardTwoPowFive - rootRCardTwo ∉ rootSet := by
  intro h
  have := normForm_of_mem h
  simp [normForm_eq, rootRCardTwo, rootRCardTwoPowFive] at this

theorem noPositiveCombination_rootRCardTwo_rootSCardTwoPowFive :
    NoPositiveCombination rootSet rootRCardTwo rootSCardTwoPowFive := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootRCardTwo, rootSCardTwoPowFive, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

theorem noPositiveCombination_rootSCardTwo_rootRCardTwoPowFive :
    NoPositiveCombination rootSet rootSCardTwo rootRCardTwoPowFive := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootSCardTwo, rootRCardTwoPowFive, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

theorem noPositiveCombination_rootSCardTwo_rootSCardTwoPowFive :
    NoPositiveCombination rootSet rootSCardTwo rootSCardTwoPowFive := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootSCardTwo, rootSCardTwoPowFive, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

/-- `t₂` is the only positive combination of `s₂` and `w s₂` in `Φ`. -/
theorem onlyPositiveCombination_rootSCardTwo_rootSCardTwoPowOne :
    OnlyPositiveCombination rootSet rootSCardTwo rootSCardTwoPowOne rootSCardTwoSum := by
  refine ⟨by decide +kernel, rootSCardTwoSum_mem, fun i j hi hj hmem ↦ ?_⟩
  have h := normForm_smul_add hmem
  simp only [rootSCardTwo, rootSCardTwoPowOne, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  have hib : (i : ℤ) ≤ 3 := by rcases h with h | h <;> nlinarith [sq_nonneg ((i : ℤ) - j)]
  have hjb : (j : ℤ) ≤ 3 := by rcases h with h | h <;> nlinarith [sq_nonneg ((i : ℤ) - j)]
  have hib' : i ≤ 3 := by exact_mod_cast hib
  have hjb' : j ≤ 3 := by exact_mod_cast hjb
  interval_cases i <;> interval_cases j <;> simp_all

theorem rootSCardTwoPowOne_sub_rootSCardTwo_notMem :
    rootSCardTwoPowOne - rootSCardTwo ∉ rootSet := by
  intro h
  have := normForm_of_mem h
  simp [normForm_eq, rootSCardTwo, rootSCardTwoPowOne] at this

theorem noPositiveCombination_rootRCardTwo_rootRCardTwoPowOne :
    NoPositiveCombination rootSet rootRCardTwo rootRCardTwoPowOne := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootRCardTwo, rootRCardTwoPowOne, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

theorem noPositiveCombination_rootRCardTwo_rootSCardTwoPowOne :
    NoPositiveCombination rootSet rootRCardTwo rootSCardTwoPowOne := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootRCardTwo, rootSCardTwoPowOne, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

theorem noPositiveCombination_rootSCardTwo_rootRCardTwoPowOne :
    NoPositiveCombination rootSet rootSCardTwo rootRCardTwoPowOne := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootSCardTwo, rootRCardTwoPowOne, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

theorem noPositiveCombination_rootRCardTwoPowOne_rootSCardTwoSum :
    NoPositiveCombination rootSet rootRCardTwoPowOne rootSCardTwoSum := by
  intro i j hi hj hmem
  have h := normForm_smul_add hmem
  simp only [rootRCardTwoPowOne, rootSCardTwoSum, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val] at h
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  rcases h with h | h <;> nlinarith

/-- `α₀ = w t₁`. -/
theorem simpleRoot_zero : simpleRoot 0 = coxeterElement rootRCardTwoSum := by
  decide +kernel

/-- `α₁ = w² t₁`. -/
theorem simpleRoot_one : simpleRoot 1 = (coxeterElement ^ 2) rootRCardTwoSum := by
  decide +kernel

/-- `-α₀ = w⁻⁵ t₁`. -/
theorem neg_simpleRoot_zero : -simpleRoot 0 = (coxeterElementInv ^ 5) rootRCardTwoSum := by
  decide +kernel

/-- `-α₁ = w⁻⁴ t₁`. -/
theorem neg_simpleRoot_one : -simpleRoot 1 = (coxeterElementInv ^ 4) rootRCardTwoSum := by
  decide +kernel

/-- `α₂ = w(s₁(w⁻⁴ t₂))`. -/
theorem simpleRoot_two :
    simpleRoot 2 =
      coxeterElement (simpleReflection 1 ((coxeterElementInv ^ 4) rootSCardTwoSum)) := by
  decide +kernel

/-- `-α₂ = w(s₁(w² t₂))`. -/
theorem neg_simpleRoot_two :
    -simpleRoot 2 =
      coxeterElement (simpleReflection 1 ((coxeterElement ^ 2) rootSCardTwoSum)) := by
  decide +kernel

/-- `α₃ = s₂(w⁻⁴ t₂)`. -/
theorem simpleRoot_three :
    simpleRoot 3 = simpleReflection 2 ((coxeterElementInv ^ 4) rootSCardTwoSum) := by
  decide +kernel

/-- `-α₃ = s₂(w² t₂)`. -/
theorem neg_simpleRoot_three :
    -simpleRoot 3 = simpleReflection 2 ((coxeterElement ^ 2) rootSCardTwoSum) := by
  decide +kernel

end CFSGCorollary.TypeF4
