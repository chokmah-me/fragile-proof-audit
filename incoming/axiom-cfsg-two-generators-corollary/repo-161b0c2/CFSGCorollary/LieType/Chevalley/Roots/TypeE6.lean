module

public import CFSGCorollary.LieType.Steinberg.WeylWord
public import CFSG.Blueprint.Chevalley
import CFSG.LieType.Chevalley.WeylRoots

/-!
# Root computations for type `E₆`

Root-level facts about the Cartan matrix `A` of type `E₆` (in CFSG's labelling, over `Fin 6`)
used in Steinberg's proof that the Chevalley group `E₆(K)` is generated by two elements.
With `a = α₅`, `L = [5, 4, 3, 2, 0, 1]` and `w = w_L` the corresponding Coxeter element, we show
that `-a` is the only positive combination of `w⁴ a` and `w⁸ a` in the root system, and express
each `±αᵢ` through `±a` using `w`, `w⁻¹` and simple reflections. All concrete identities are
checked by `decide`.

The positivity statement is reduced to a computation by the `W`-invariance of the quadratic form
`v ↦ vᵀ A v` (`quadForm_weylAction`), which takes the value `2` on every root.

## Main results

* `TypeE6.onlyPositiveCombination_coxeterElement_pow_simpleRoot_last`: `-a` is the only positive
  combination of `w⁴ a` and `w⁸ a`.
* `TypeE6.smul_simpleRoot_four`, …, `TypeE6.neg_simpleRoot_one`: `±αᵢ` in terms of `±a`.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

open scoped Matrix

open CFSG.LieType.RootSystem

namespace CFSGCorollary.TypeE6

/-- The quadratic form `v ↦ vᵀ A v`. -/
def quadForm {I : Type} [Fintype I] (A : Matrix I I ℤ) (v : I → ℤ) : ℤ := v ⬝ᵥ A *ᵥ v

theorem quadForm_reflection {I : Type} [Fintype I] [DecidableEq I] {A : Matrix I I ℤ}
    (hs : A.IsSymm) {i : I} (hi : A i i = 2) (v : I → ℤ) :
    quadForm A (reflection A i v) = quadForm A v := by
  have h1 : (∑ j, A i j * v j) = (A *ᵥ v) i := rfl
  have h2 : v ⬝ᵥ A *ᵥ (Pi.single i 1) = (A *ᵥ v) i := by
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hs.eq]
    simp [dotProduct, Pi.single_apply]
  have h3 : (Pi.single i (1 : ℤ)) ⬝ᵥ A *ᵥ v = (A *ᵥ v) i := by simp
  have h4 : (Pi.single i (1 : ℤ)) ⬝ᵥ A *ᵥ (Pi.single i 1) = 2 := by
    simp [dotProduct, Pi.single_apply, Matrix.mulVec, hi]
  rw [reflection_apply, h1]
  unfold quadForm
  simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, dotProduct_sub, sub_dotProduct,
    dotProduct_smul, smul_dotProduct, h2, h3, h4, smul_eq_mul]
  ring

theorem quadForm_weylAction {I : Type} [Fintype I] [DecidableEq I] {A : Matrix I I ℤ}
    (hA : TauCeti.IsFiniteType A) (hs : A.IsSymm) (w : (coxeterMatrix hA).Group) (i : I) :
    quadForm A (weylAction hA w (Pi.single i 1)) = 2 := by
  induction w using (coxeterMatrix hA).toCoxeterSystem.simple_induction_left with
  | one =>
    simp only [map_one, Module.End.one_apply]
    simp [quadForm, dotProduct, Pi.single_apply, Matrix.mulVec, hA.apply_self]
  | mul_simple_left w j ih =>
    rw [weylAction_mul_apply, weylAction_simple, quadForm_reflection hs (hA.apply_self j), ih]

/-- For a symmetric Cartan matrix, if `u + v` is a root and `u`, `v` have norm `2` and pairing
`-1`, then `u + v` is the only positive combination of `u` and `v` in the root system. -/
theorem onlyPositiveCombination_of_pairing {I : Type} [Fintype I] [DecidableEq I]
    {A : Matrix I I ℤ} (hA : TauCeti.IsFiniteType A) (hs : A.IsSymm) {u v t : I → ℤ}
    (hu : quadForm A u = 2) (hv : quadForm A v = 2) (hb : u ⬝ᵥ A *ᵥ v = -1) (htuv : t = u + v)
    (ht : t ∈ roots hA ∅) :
    OnlyPositiveCombination (roots hA ∅) u v t := by
  refine ⟨htuv, ht, fun i j hi hj hmem ↦ ?_⟩
  have hq : quadForm A (i • u + j • v) = 2 := by
    rcases hmem with ⟨w, k, h⟩ | ⟨w, k, hk, -⟩
    · rw [h]; exact quadForm_weylAction hA hs w k
    · exact absurd hk (Set.notMem_empty k)
  have hba : v ⬝ᵥ A *ᵥ u = -1 := by
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hs.eq, dotProduct_comm]
    exact hb
  unfold quadForm at hq hu hv
  simp only [← Nat.cast_smul_eq_nsmul ℤ, Matrix.mulVec_add, Matrix.mulVec_smul, dotProduct_add,
    add_dotProduct, dotProduct_smul, smul_dotProduct, hu, hv, hb, hba, smul_eq_mul] at hq
  have hi' : (1 : ℤ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℤ) ≤ j := by exact_mod_cast hj
  have h1 : (i : ℤ) = 1 := by
    nlinarith [sq_nonneg ((i : ℤ) - j), sq_nonneg ((i : ℤ) - 1), sq_nonneg ((j : ℤ) - 1)]
  have h2 : (j : ℤ) = 1 := by
    nlinarith [sq_nonneg ((i : ℤ) - j), sq_nonneg ((i : ℤ) - 1), sq_nonneg ((j : ℤ) - 1)]
  exact ⟨by exact_mod_cast h1, by exact_mod_cast h2⟩

/-- The Cartan matrix of type `E₆`, as a matrix over `Fin 6` (numerals do not elaborate in
`Fin τ.rank`). -/
abbrev cartan : Matrix (Fin 6) (Fin 6) ℤ := CFSG.Blueprint.Chevalley.Tag.cartan .E6

theorem cartan_isSymm : cartan.IsSymm := by
  have : ∀ p : Fin 6 × Fin 6, cartan p.1 p.2 = cartan p.2 p.1 := by decide +kernel
  exact Matrix.IsSymm.ext fun i j ↦ this (j, i)

theorem isFiniteType : TauCeti.IsFiniteType cartan :=
  CFSG.LieType.Chevalley.isFiniteType_cartan .E6

/-- The list `L = [5, 4, 3, 2, 0, 1]` of simple roots (Steinberg's `a₁, …, aₙ`). -/
def coxeterList : List (Fin 6) := [5, 4, 3, 2, 0, 1]

/-- The Coxeter element `w = w_L`. -/
noncomputable abbrev coxeterElement : Module.End ℤ (Fin 6 → ℤ) :=
  reflectionWord cartan coxeterList

/-- The inverse `w⁻¹ = w_L⁻¹`: the reflections of `L` in the reverse order. -/
noncomputable abbrev coxeterElementInv : Module.End ℤ (Fin 6 → ℤ) :=
  reflectionWord cartan coxeterList.reverse

/-- The simple root `αᵢ`. -/
abbrev simpleRoot (i : Fin 6) : Fin 6 → ℤ := Pi.single i 1

/-- The simple reflection `sⱼ`. -/
noncomputable abbrev simpleReflection (j : Fin 6) : Module.End ℤ (Fin 6 → ℤ) :=
  reflection cartan j

/-- The root system `Φ`. -/
abbrev rootSet : Set (Fin 6 → ℤ) := roots isFiniteType ∅

/-- `∑ⱼ A₅ⱼ aⱼ = 2` for `a = α₅`. -/
theorem pairing_simpleRoot_last : ∑ j, cartan 5 j * simpleRoot 5 j = 2 := by
  decide +kernel

/-- `∑ⱼ A₅ⱼ (w⁻¹ a)ⱼ = -1` for `a = α₅`. -/
theorem pairing_coxeterElementInv_simpleRoot_last :
    ∑ j, cartan 5 j * (coxeterElementInv (simpleRoot 5)) j = -1 := by
  decide +kernel

/-- `-a` is the only positive combination of `w⁴ a` and `w⁸ a` in `Φ`. -/
theorem onlyPositiveCombination_coxeterElement_pow_simpleRoot_last :
    OnlyPositiveCombination rootSet ((coxeterElement ^ 4) (simpleRoot 5))
      ((coxeterElement ^ 8) (simpleRoot 5)) (-simpleRoot 5) := by
  refine onlyPositiveCombination_of_pairing isFiniteType cartan_isSymm ?_ ?_ ?_ ?_ ?_
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · exact Or.inl ⟨(coxeterMatrix isFiniteType).toCoxeterSystem.simple 5, 5,
      (weylAction_simple_single isFiniteType 5).symm⟩

/-- `±α₄ = w(±α₅)`. -/
theorem smul_simpleRoot_four (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 4 = coxeterElement (ε • simpleRoot 5) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₃ = w²(±α₅)`. -/
theorem smul_simpleRoot_three (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 3 = (coxeterElement ^ 2) (ε • simpleRoot 5) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₂ = s₃(w⁻²(∓α₅))`. -/
theorem smul_simpleRoot_two (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 2 = simpleReflection 3 ((coxeterElementInv ^ 2) ((-ε) • simpleRoot 5)) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₀ = w(s₃(w⁻²(∓α₅)))`. -/
theorem smul_simpleRoot_zero (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 0 =
      coxeterElement (simpleReflection 3 ((coxeterElementInv ^ 2) ((-ε) • simpleRoot 5))) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `α₁ = w⁻¹(s₅(w⁻³ α₅))`. -/
theorem simpleRoot_one :
    simpleRoot 1 =
      coxeterElementInv (simpleReflection 5 ((coxeterElementInv ^ 3) (simpleRoot 5))) := by
  decide +kernel

/-- `-α₁ = w⁻¹(s₂(w³ α₅))`. -/
theorem neg_simpleRoot_one :
    -simpleRoot 1 =
      coxeterElementInv (simpleReflection 2 ((coxeterElement ^ 3) (simpleRoot 5))) := by
  decide +kernel

end CFSGCorollary.TypeE6
