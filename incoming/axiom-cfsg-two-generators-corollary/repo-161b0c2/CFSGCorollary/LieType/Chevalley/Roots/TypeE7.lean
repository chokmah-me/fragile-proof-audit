module

public import CFSGCorollary.LieType.Steinberg.WeylWord
public import CFSG.Blueprint.Chevalley
import CFSG.LieType.Chevalley.WeylRoots

/-!
# Root computations for type `E₇`

Root-level facts about the Cartan matrix `A` of type `E₇` (in CFSG's labelling, over `Fin 7`)
used in Steinberg's proof that the Chevalley group `E₇(K)` is generated by two elements.
With `a = α₆`, `L = [6, 5, 4, 3, 2, 0, 1]` and `w = w_L` the corresponding Coxeter element, we
show that `w⁹ = -1` on the root lattice and express each `±αᵢ` through `±a` using `w`, `w⁻¹`
and simple reflections. All concrete identities are checked by `decide`.

## Main results

* `TypeE7.coxeterElement_pow_apply_eq_neg`: `w⁹ γ = -γ`.
* `TypeE7.smul_simpleRoot_five`, …, `TypeE7.smul_simpleRoot_one`: `±αᵢ` in terms of `±a`.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TypeE7

/-- The Cartan matrix of type `E₇`, as a matrix over `Fin 7` (numerals do not elaborate in
`Fin τ.rank`). -/
abbrev cartan : Matrix (Fin 7) (Fin 7) ℤ := CFSG.Blueprint.Chevalley.Tag.cartan .E7

theorem isFiniteType : TauCeti.IsFiniteType cartan :=
  CFSG.LieType.Chevalley.isFiniteType_cartan .E7

/-- The list `L = [6, 5, 4, 3, 2, 0, 1]` of simple roots (Steinberg's `a₁, …, aₙ`). -/
def coxeterList : List (Fin 7) := [6, 5, 4, 3, 2, 0, 1]

/-- The Coxeter element `w = w_L`. -/
noncomputable abbrev coxeterElement : Module.End ℤ (Fin 7 → ℤ) :=
  reflectionWord cartan coxeterList

/-- The inverse `w⁻¹ = w_L⁻¹`: the reflections of `L` in the reverse order. -/
noncomputable abbrev coxeterElementInv : Module.End ℤ (Fin 7 → ℤ) :=
  reflectionWord cartan coxeterList.reverse

/-- The simple root `αᵢ`. -/
abbrev simpleRoot (i : Fin 7) : Fin 7 → ℤ := Pi.single i 1

/-- The simple reflection `sⱼ`. -/
noncomputable abbrev simpleReflection (j : Fin 7) : Module.End ℤ (Fin 7 → ℤ) :=
  CFSG.LieType.RootSystem.reflection cartan j

/-- The root system `Φ`. -/
abbrev rootSet : Set (Fin 7 → ℤ) := CFSG.LieType.RootSystem.roots isFiniteType ∅

/-- `∑ⱼ A₆ⱼ aⱼ = 2` for `a = α₆`. -/
theorem pairing_simpleRoot_last : ∑ j, cartan 6 j * simpleRoot 6 j = 2 := by
  decide +kernel

/-- `∑ⱼ A₆ⱼ (w⁻¹ a)ⱼ = -1` for `a = α₆`. -/
theorem pairing_coxeterElementInv_simpleRoot_last :
    ∑ j, cartan 6 j * (coxeterElementInv (simpleRoot 6)) j = -1 := by
  decide +kernel

/-- `w⁹ γ = -γ`. -/
theorem coxeterElement_pow_apply_eq_neg (γ : Fin 7 → ℤ) : (coxeterElement ^ 9) γ = -γ := by
  have h : ∀ i : Fin 7, (coxeterElement ^ 9) (simpleRoot i) = -simpleRoot i := by
    decide +kernel
  have hγ : γ = ∑ i, γ i • simpleRoot i := by
    ext j
    simp [simpleRoot, Finset.sum_apply, Pi.single_apply]
  conv_lhs => rw [hγ]
  rw [map_sum]
  conv_rhs => rw [hγ]
  simp only [map_smul, h, smul_neg, Finset.sum_neg_distrib]

/-- `±α₅ = w(±α₆)`. -/
theorem smul_simpleRoot_five (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 5 = coxeterElement (ε • simpleRoot 6) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₄ = w²(±α₆)`. -/
theorem smul_simpleRoot_four (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 4 = (coxeterElement ^ 2) (ε • simpleRoot 6) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₃ = w³(±α₆)`. -/
theorem smul_simpleRoot_three (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 3 = (coxeterElement ^ 3) (ε • simpleRoot 6) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₂ = s₃(w⁻²(∓α₆))`. -/
theorem smul_simpleRoot_two (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 2 = simpleReflection 3 ((coxeterElementInv ^ 2) ((-ε) • simpleRoot 6)) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₀ = w(s₃(w⁻²(∓α₆)))`. -/
theorem smul_simpleRoot_zero (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 0 =
      coxeterElement (simpleReflection 3 ((coxeterElementInv ^ 2) ((-ε) • simpleRoot 6))) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₁ = s₃(s₄(w⁻³(∓α₆)))`. -/
theorem smul_simpleRoot_one (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 1 =
      simpleReflection 3 (simpleReflection 4 ((coxeterElementInv ^ 3) ((-ε) • simpleRoot 6))) := by
  rcases hε with rfl | rfl <;> decide +kernel

end CFSGCorollary.TypeE7
