module

public import CFSGCorollary.LieType.Steinberg.WeylWord
public import CFSG.Blueprint.ChevalleyRootsInputs
import CFSG.LieType.Chevalley.WeylRoots

/-!
# Root computations for type `G₂`

Root-level facts about the Cartan matrix `A` of type `G₂` (in CFSG's labelling, over `Fin 2`)
used in Steinberg's proof that the Chevalley group `G₂(K)` is generated by two elements.
With `L = [0, 1]`, `w = w_L`, the roots `r = (1, 2)`, `s = (1, 3)` and the cocharacter
`μ = (-1, 0)`, we show that `r` and `s` have no positive combination in the root system, compute
the exponents by which `h_μ(k)` acts on the relevant root groups, and show that every `±αᵢ` lies
in the `w`-orbit of `r` or `s`. Root membership is decided through CFSG's root certificate for
`G₂`; all concrete identities are checked by `decide`.

## Main results

* `TypeG2.noPositiveCombination_rootR_rootS`: `r` and `s` have no positive combination in `Φ`.
* `TypeG2.exists_coxeterElement_pow_eq`: every `±αᵢ` is `wᵏ r` or `wᵏ s` for some `k`.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TypeG2

/-- The Cartan matrix of type `G₂`, as a matrix over `Fin 2` (numerals do not elaborate in
`Fin τ.rank`). -/
abbrev cartan : Matrix (Fin 2) (Fin 2) ℤ := CFSG.Blueprint.Chevalley.Tag.cartan .G2

theorem isFiniteType : TauCeti.IsFiniteType cartan :=
  CFSG.LieType.Chevalley.isFiniteType_cartan .G2

/-- The list `L = [0, 1]` of simple roots. -/
def coxeterList : List (Fin 2) := [0, 1]

/-- The Coxeter element `w = w_L`. -/
noncomputable abbrev coxeterElement : Module.End ℤ (Fin 2 → ℤ) :=
  reflectionWord cartan coxeterList

/-- The inverse `w⁻¹ = w_L⁻¹`: the reflections of `L` in the reverse order. -/
noncomputable abbrev coxeterElementInv : Module.End ℤ (Fin 2 → ℤ) :=
  reflectionWord cartan coxeterList.reverse

/-- The simple root `αᵢ`. -/
abbrev simpleRoot (i : Fin 2) : Fin 2 → ℤ := Pi.single i 1

/-- The root system `Φ`. -/
abbrev rootSet : Set (Fin 2 → ℤ) := CFSG.LieType.RootSystem.roots isFiniteType ∅

/-- The root `r = (1, 2)`. -/
def rootR : Fin 2 → ℤ := ![1, 2]

/-- The root `s = (1, 3)`. -/
def rootS : Fin 2 → ℤ := ![1, 3]

/-- The cocharacter `μ = (-1, 0)`. -/
def cocharacter : Fin 2 → ℤ := ![-1, 0]

/-- The `k`-th root of CFSG's root certificate for `G₂`, as a vector over `Fin 2`. -/
def certificateRoot (k : ℕ) : Fin 2 → ℤ := CFSG.Blueprint.Chevalley.g2Certificate.root k

open CFSG.Blueprint.Chevalley in
theorem mem_rootSet_iff (v : Fin 2 → ℤ) : v ∈ rootSet ↔ ∃ k < 12, certificateRoot k = v :=
  (CFSG.LieType.Chevalley.isRoot_iff_mem_roots (τ := .G2) (v := v)).symm.trans
    (RootCertificate.isRoot_iff (Tag.rootCertificate_check .G2) (v := v))

theorem rootR_mem : rootR ∈ rootSet := by
  rw [mem_rootSet_iff]
  refine ⟨8, by decide, ?_⟩
  decide +kernel

theorem rootS_mem : rootS ∈ rootSet := by
  rw [mem_rootSet_iff]
  refine ⟨3, by decide, ?_⟩
  decide +kernel

theorem rootR_add_rootS_ne_zero : rootR + rootS ≠ 0 := by
  decide +kernel

theorem noPositiveCombination_rootR_rootS : NoPositiveCombination rootSet rootR rootS := by
  intro i j hi hj h
  rw [mem_rootSet_iff] at h
  obtain ⟨k, hk, hkv⟩ := h
  have h0 : (certificateRoot k) 0 = i + j := by
    rw [hkv]
    simp [rootR, rootS]
  have key : ∀ k : Fin 12, ∀ i j : Fin 8, 0 < (i : ℕ) → 0 < (j : ℕ) →
      certificateRoot k ≠ (i : ℕ) • rootR + (j : ℕ) • rootS := by
    decide +kernel
  have hb : ∀ k : Fin 12, (certificateRoot k) 0 ≤ 7 := by decide +kernel
  have h0' : (certificateRoot k) 0 ≤ 7 := hb ⟨k, hk⟩
  have hi8 : i < 8 := by omega
  have hj8 : j < 8 := by omega
  exact key ⟨k, hk⟩ ⟨i, hi8⟩ ⟨j, hj8⟩ hi hj hkv

/-- `e(r) = 0`, where `e = cocharacterPairing A μ` is the exponent of `h_μ(k)` on a root group. -/
theorem cocharacterPairing_rootR : cocharacterPairing cartan cocharacter rootR = 0 := by
  decide +kernel

theorem cocharacterPairing_rootS : cocharacterPairing cartan cocharacter rootS = 1 := by
  decide +kernel

theorem cocharacterPairing_coxeterElementInv_rootR :
    cocharacterPairing cartan cocharacter (coxeterElementInv rootR) = -1 := by
  decide +kernel

theorem cocharacterPairing_coxeterElementInv_rootS :
    cocharacterPairing cartan cocharacter (coxeterElementInv rootS) = -1 := by
  decide +kernel

theorem cocharacterPairing_coxeterElement_rootR :
    cocharacterPairing cartan cocharacter (coxeterElement rootR) = 1 := by
  decide +kernel

/-- Every `±αᵢ` lies in the `w`-orbit of `r` or of `s` (`w` has order `6`, so exponents below `6`
suffice). -/
theorem exists_coxeterElement_pow_eq (i : Fin 2) (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ∃ k : ℕ, ε • simpleRoot i = (coxeterElement ^ k) rootR ∨
      ε • simpleRoot i = (coxeterElement ^ k) rootS := by
  have : ∃ k : Fin 6, ε • simpleRoot i = (coxeterElement ^ (k : ℕ)) rootR ∨
      ε • simpleRoot i = (coxeterElement ^ (k : ℕ)) rootS := by
    revert i
    rcases hε with rfl | rfl <;> decide +kernel
  obtain ⟨k, hk⟩ := this
  exact ⟨k, hk⟩

end CFSGCorollary.TypeG2
