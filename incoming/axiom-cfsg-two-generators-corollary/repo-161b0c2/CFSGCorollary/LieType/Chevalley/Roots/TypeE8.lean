module

public import CFSGCorollary.LieType.Steinberg.WeylWord
public import CFSG.Blueprint.Chevalley
import CFSG.LieType.Chevalley.WeylRoots

/-!
# Root computations for type `E₈`

Root-level facts about the Cartan matrix `A` of type `E₈` (in CFSG's labelling, over `Fin 8`)
used in Steinberg's proof that the Chevalley group `E₈(K)` is generated by two elements.
With `a = α₇`, `L = [7, 6, 5, 4, 3, 2, 0, 1]` and `w = w_L` the corresponding Coxeter element, we
show that `w¹⁵ = -1` on the root lattice and express each `±αᵢ` through `±a` using `w`, `w⁻¹`
and simple reflections. All concrete identities are checked by `decide`.

## Main results

* `TypeE8.coxeterElement_pow_apply_eq_neg`: `w¹⁵ γ = -γ`.
* `TypeE8.smul_simpleRoot_six`, …, `TypeE8.smul_simpleRoot_one`: `±αᵢ` in terms of `±a`.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TypeE8

/-- The Cartan matrix of type `E₈`, as a matrix over `Fin 8` (numerals do not elaborate in
`Fin τ.rank`). -/
abbrev cartan : Matrix (Fin 8) (Fin 8) ℤ := CFSG.Blueprint.Chevalley.Tag.cartan .E8

theorem isFiniteType : TauCeti.IsFiniteType cartan :=
  CFSG.LieType.Chevalley.isFiniteType_cartan .E8

/-- The list `L = [7, 6, 5, 4, 3, 2, 0, 1]` of simple roots (Steinberg's `a₁, …, aₙ`). -/
def coxeterList : List (Fin 8) := [7, 6, 5, 4, 3, 2, 0, 1]

/-- The Coxeter element `w = w_L`. -/
noncomputable abbrev coxeterElement : Module.End ℤ (Fin 8 → ℤ) :=
  reflectionWord cartan coxeterList

/-- The inverse `w⁻¹ = w_L⁻¹`: the reflections of `L` in the reverse order. -/
noncomputable abbrev coxeterElementInv : Module.End ℤ (Fin 8 → ℤ) :=
  reflectionWord cartan coxeterList.reverse

/-- The simple root `αᵢ`. -/
abbrev simpleRoot (i : Fin 8) : Fin 8 → ℤ := Pi.single i 1

/-- The simple reflection `sⱼ`. -/
noncomputable abbrev simpleReflection (j : Fin 8) : Module.End ℤ (Fin 8 → ℤ) :=
  CFSG.LieType.RootSystem.reflection cartan j

/-- The root system `Φ`. -/
abbrev rootSet : Set (Fin 8 → ℤ) := CFSG.LieType.RootSystem.roots isFiniteType ∅

/-- `∑ⱼ A₇ⱼ aⱼ = 2` for `a = α₇`. -/
theorem pairing_simpleRoot_last : ∑ j, cartan 7 j * simpleRoot 7 j = 2 := by
  decide +kernel

/-- `∑ⱼ A₇ⱼ (w⁻¹ a)ⱼ = -1` for `a = α₇`. -/
theorem pairing_coxeterElementInv_simpleRoot_last :
    ∑ j, cartan 7 j * (coxeterElementInv (simpleRoot 7)) j = -1 := by
  decide +kernel

/-- `w¹⁵ γ = -γ`. -/
theorem coxeterElement_pow_apply_eq_neg (γ : Fin 8 → ℤ) : (coxeterElement ^ 15) γ = -γ := by
  have h : ∀ i : Fin 8, (coxeterElement ^ 15) (simpleRoot i) = -simpleRoot i := by
    intro i
    fin_cases i <;> decide +kernel
  have hγ : γ = ∑ i, γ i • simpleRoot i := by
    ext j
    simp [simpleRoot, Pi.single_apply]
  rw [hγ, map_sum]
  simp only [map_smul, h]
  simp [Finset.sum_neg_distrib]

/-- `±α₆ = w(±α₇)`. -/
theorem smul_simpleRoot_six (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 6 = coxeterElement (ε • simpleRoot 7) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₅ = w²(±α₇)`. -/
theorem smul_simpleRoot_five (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 5 = (coxeterElement ^ 2) (ε • simpleRoot 7) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₄ = w³(±α₇)`. -/
theorem smul_simpleRoot_four (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 4 = (coxeterElement ^ 3) (ε • simpleRoot 7) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₃ = w⁴(±α₇)`. -/
theorem smul_simpleRoot_three (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 3 = (coxeterElement ^ 4) (ε • simpleRoot 7) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₂ = s₃(w⁻²(∓α₇))`. -/
theorem smul_simpleRoot_two (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 2 = simpleReflection 3 ((coxeterElementInv ^ 2) ((-ε) • simpleRoot 7)) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₀ = w(s₃(w⁻²(∓α₇)))`. -/
theorem smul_simpleRoot_zero (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 0 =
      coxeterElement (simpleReflection 3 ((coxeterElementInv ^ 2) ((-ε) • simpleRoot 7))) := by
  rcases hε with rfl | rfl <;> decide +kernel

/-- `±α₁ = s₃(s₄(w⁻³(∓α₇)))`. -/
theorem smul_simpleRoot_one (ε : ℤ) (hε : ε = 1 ∨ ε = -1) :
    ε • simpleRoot 1 =
      simpleReflection 3 (simpleReflection 4 ((coxeterElementInv ^ 3) ((-ε) • simpleRoot 7))) := by
  rcases hε with rfl | rfl <;> decide +kernel

end CFSGCorollary.TypeE8
