module

public import CFSGCorollary.TwoGenerated.Basic
public import CFSGCorollary.LieType.Twisted.TwistedE6.RootGroups
import all TauCeti.GroupTheory.SpecificGroups.CFSG.Index
import CFSG.Adapters.TauCetiExceptional.EvenAll
import CFSGCorollary.LieType.LambdaRootGroup.ClosurePair
import CFSGCorollary.LieType.Twisted.Basic
import CFSGCorollary.LieType.Twisted.TwistedE6.Commutator
import CFSGCorollary.LieType.Twisted.TwistedE6.Orbit
import CFSGCorollary.LieType.Twisted.TwistedE6.WeylTorus

/-!
# `²E₆(q)` is two-generated

Let `t` generate `K = 𝔽_{q²}ˣ` and let `n = n₀ n₁ n₂ n₃` be the Coxeter element of
`fixedGroup K θ`. We show that `a = torU (torusVecD t)` and `b = xPair α₁ 1 * n` generate
`fixedGroup K θ`, following Steinberg:

* `a` and `n a n⁻¹ = torU (torusVecD₁ t)` commute and act on the λ-root group `X e₃` by the
  generating scalars `t ^ 2` and `t⁻¹`, so `⟨a, b⟩` contains `X e₃` and `n`;
* conjugating by powers of `n` and one commutator relation yield `X (±eᵢ)` for all simple roots,
  and these generate `fixedGroup K θ`.

Finally `fixedGroup K θ` maps onto TauCeti's `²E₆(q)`.

## Main results

* `CFSGCorollary.TwistedE6.twoGenerated_fixedGroup`: the model `fixedGroup K θ` is
  two-generated.
* `CFSGCorollary.twoGenerated_twistedE6`: every simple `²E₆(q)` is two-generated.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TwistedE6

open CFSG.Blueprint.Chevalley (Tag IsRoot)
open CFSG.LieType.Steinberg.TwistedE6 (nf IsSymU twistedRootGroup fixedGroup xPair nHat)
open CFSG.LieType.Steinberg.CentralExt.TwistedE6Closed (torU theta_theta_of_card)

/-- The pair `⟨torU (torusVecD t), xPair 1 * n⟩` contains `X e₃` and `n`. -/
theorem rootGroup_le_closure_and_nHat_mem {K : Type} [Field K] [Finite K] {q : ℕ}
    (hq : 2 ≤ q) (hK : Nat.card K = q ^ 2) (θ : K →+* K) (hθ : ∀ c : K, θ (θ c) = c)
    (t : Kˣ) (ht : Subgroup.zpowers t = ⊤) (hd : IsSymU θ (torusVecD θ t)) :
    twistedRootGroup K θ (Pi.single (nf 3) 1) ≤
        Subgroup.closure {torU θ _ hd, xPair θ hθ isRoot_alphaOne rho_alphaOne_ne 1 *
          (nHat θ (nf 0) * nHat θ (nf 1) * nHat θ (nf 2) * nHat θ (nf 3))} ∧
      nHat θ (nf 0) * nHat θ (nf 1) * nHat θ (nf 2) * nHat θ (nf 3) ∈
        Subgroup.closure {torU θ _ hd, xPair θ hθ isRoot_alphaOne rho_alphaOne_ne 1 *
          (nHat θ (nf 0) * nHat θ (nf 1) * nHat θ (nf 2) * nHat θ (nf 3))} := by
  set n := nHat θ (nf 0) * nHat θ (nf 1) * nHat θ (nf 2) * nHat θ (nf 3)
  obtain ⟨R, hRc, hRcoord, -, hRd, hRd₁⟩ := exists_shortRootGroup θ hθ
  have hd₁ : IsSymU θ (torusVecD₁ θ t) := isSymU_torusVecD₁ θ hθ t
  obtain ⟨hconj, hcomm⟩ := nHat_prod_mul_torU_mul_inv_and_commute θ t hd hd₁
  obtain ⟨actD⟩ := hRd t hd
  obtain ⟨actD₁⟩ := hRd₁ t hd₁
  have hmem : xPair θ hθ isRoot_alphaOne rho_alphaOne_ne 1 ∈ R.carrier :=
    hRc ▸ xPair_alphaOne_mem θ hθ 1
  have hcard : orderOf t = q ^ 2 - 1 := by
    rw [orderOf_eq_card_of_zpowers_eq_top ht, Nat.card_units, hK]
  have hq2 : 3 ≤ orderOf t := by
    rw [hcard]
    have : 4 ≤ q ^ 2 := by nlinarith
    omega
  have ht1 : t ≠ 1 := by
    intro h; rw [h, orderOf_one] at hq2; omega
  have ht2 : t ^ 2 ≠ 1 := by
    intro h
    have := Nat.le_of_dvd (by norm_num) (orderOf_dvd_of_pow_eq_one h)
    omega
  have hk : IsNontrivialGeneratingScalar (t ^ 2) := ⟨⟨t, ht, Or.inr rfl⟩, ht2⟩
  have hl : IsNontrivialGeneratingScalar t⁻¹ :=
    ⟨⟨t⁻¹, by rw [Subgroup.zpowers_inv]; exact ht, Or.inl rfl⟩, by simpa using ht1⟩
  have hcomm' : Commute (torU θ _ hd) (n * torU θ _ hd * n⁻¹) := by
    rw [hconj]; exact hcomm
  have actD₁' : R.Action (n * torU θ _ hd * n⁻¹) t⁻¹ := by
    rw [hconj]; exact actD₁
  have := LambdaRootGroup.le_closure_pair_mul R (torU θ _ hd) n (t ^ 2) t⁻¹ hk hl hcomm'
    actD actD₁' ⟨_, hmem⟩ (by simp [hRcoord])
  exact ⟨hRc.symm.le.trans this.1, this.2⟩

/-- The `²E₆` model is generated by `torU (torusVecD t)` and `xPair 1 * n`. -/
theorem closure_torU_xPair_mul_nHat_eq_top {K : Type} [Field K] [Finite K] {q : ℕ}
    (hq : 2 ≤ q) (hK : Nat.card K = q ^ 2) (θ : K →+* K) (hθq : ∀ c : K, θ c = c ^ q)
    (hθ : ∀ c : K, θ (θ c) = c) (t : Kˣ) (ht : Subgroup.zpowers t = ⊤)
    (hd : IsSymU θ (torusVecD θ t)) :
    Subgroup.closure {torU θ _ hd, xPair θ hθ isRoot_alphaOne rho_alphaOne_ne 1 *
      (nHat θ (nf 0) * nHat θ (nf 1) * nHat θ (nf 2) * nHat θ (nf 3))} = ⊤ := by
  obtain ⟨h3, hn⟩ := rootGroup_le_closure_and_nHat_mem hq hK θ hθ t ht hd
  set F := Subgroup.closure {torU θ _ hd, xPair θ hθ isRoot_alphaOne rho_alphaOne_ne 1 *
    (nHat θ (nf 0) * nHat θ (nf 1) * nHat θ (nf 2) * nHat θ (nf 3))}
  obtain ⟨h2, h2', h3', h4⟩ := rootGroup_short_le θ F hn h3
  have hl := rootGroup_long_le hq hK θ hθq F h2 h4
  obtain ⟨h0, h0', h1, h1'⟩ := rootGroup_long_simple_le θ F hn hl
  refine eq_top_of_simple_root_groups_le (τ := .F4) (twistedRootGroup K θ) (nHat θ)
    (fun i β hβ x hx ↦ CFSG.LieType.Steinberg.TwistedE6.nHat_conj_mem θ i hβ hx)
    (fun i ↦ CFSG.LieType.Steinberg.TwistedE6.nHat_mem_rankOne θ hθ i) ?_ F ?_
  · have h := CFSG.LieType.Steinberg.TwistedE6.iSup_twistedDatum_rootGroup θ hθ
    have hr : (CFSG.LieType.Steinberg.TwistedE6.twistedDatum K θ).roots =
        {β | IsRoot Tag.F4 β} := CFSG.LieType.Steinberg.Adjoint.roots_eq_setOf_isRoot (τ := .F4)
          (CFSG.LieType.Chevalley.isFiniteType_cartan .F4)
    rwa [hr] at h
  · intro i
    fin_cases i
    · exact ⟨h0, h0'⟩
    · exact ⟨h1, h1'⟩
    · exact ⟨h2, h2'⟩
    · exact ⟨h3, h3'⟩

/-- The `²E₆` model `fixedGroup K θ` is two-generated. -/
theorem twoGenerated_fixedGroup {K : Type} [Field K] [Finite K] {q : ℕ} (hq : 2 ≤ q)
    (hK : Nat.card K = q ^ 2) (θ : K →+* K) (hθq : ∀ c : K, θ c = c ^ q) :
    TwoGenerated (fixedGroup K θ) := by
  have hθ : ∀ c : K, θ (θ c) = c := theta_theta_of_card hK hθq
  obtain ⟨t, ht⟩ := IsCyclic.exists_generator (α := Kˣ)
  have ht' : Subgroup.zpowers t = ⊤ := by
    ext x; simpa [Subgroup.mem_zpowers_iff] using ht x
  exact ⟨_, _, closure_torU_xPair_mul_nHat_eq_top hq hK θ hθq hθ t ht'
    (isSymU_torusVecD θ hθ t)⟩

end CFSGCorollary.TwistedE6

namespace CFSGCorollary

/-- Every simple group `²E₆(q)` is two-generated. -/
theorem twoGenerated_twistedE6 (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.twistedE6 q).Valid)
    [Finite (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedE6 q, hv⟩)]
    [IsSimpleGroup (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedE6 q, hv⟩)] :
    TwoGenerated (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedE6 q, hv⟩) := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  have hn : 2 * q.exponent ≠ 0 := by have := q.exponent_pos; omega
  let K := GaloisField q.p (2 * q.exponent)
  have : Finite K := inferInstanceAs (Finite (GaloisField q.p (2 * q.exponent)))
  have hKc : Nat.card K = q.card ^ 2 := by
    rw [GaloisField.card q.p _ hn, TauCeti.PrimePower.card_def, ← pow_mul, mul_comm]
  let θ : K →+* K := iterateFrobenius K q.p q.exponent
  have hθq : ∀ c : K, θ c = c ^ q.card := fun c ↦ iterateFrobenius_def _ _ c
  have hθ : ∀ c : K, θ (θ c) = c :=
    CFSG.LieType.Steinberg.CentralExt.TwistedE6Closed.theta_theta_of_card hKc hθq
  have hq2 : 2 ≤ q.card :=
    q.prime_p.two_le.trans (Nat.le_self_pow (by have := q.exponent_pos; omega) _)
  have hK4 : 4 ≤ Nat.card K := by
    rw [hKc]; nlinarith
  obtain ⟨e⟩ := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.twistedE6 q hv K hKc θ hθq
  let φ := (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center _))).comp
    (CFSG.LieType.Simplicity.twistedIsogeny θ hθ hK4)
  refine twoGenerated_of_surjective φ ?_ (TwistedE6.twoGenerated_fixedGroup hq2 hKc θ hθq)
  exact e.surjective.comp ((QuotientGroup.mk'_surjective _).comp
    (CFSG.LieType.Simplicity.twistedIsogeny_surjective θ hθ hK4))

end CFSGCorollary
