module

public import CFSGCorollary.TwoGenerated.Basic
public import CFSG.LieType.Steinberg.CentralExt.TrialityLift
import CFSG.Adapters.TauCetiExceptional.EvenAll
import CFSGCorollary.LieType.LambdaRootGroup.ClosurePair
import CFSGCorollary.LieType.Twisted.Basic
import CFSGCorollary.LieType.Twisted.TrialityD4.RootGroups
import CFSGCorollary.LieType.Twisted.TrialityD4.WeylTorus

/-!
# The groups `³D₄(q)` are two-generated

Let `K` be a field with `q ^ 3` elements, `σ c = c ^ q`, and `t` a generator of `Kˣ`. In CFSG's
model `twistedGroup σ` of `³D₄(q)`, the pair `(tor 1 t, xS 1 * n)` with `n = n₀ n₁` generates:
the short simple root group `X ![0, 1]` is a λ-root group on which `tor 1 t` and its
`n`-conjugate act by good scalars, so the closure contains `X ![0, 1]` and `n`, hence the root
groups of `± ![0, 1]` and `± ![1, 0]`, which generate. The simple group `³D₄(q)` is a quotient of
this model.

## Main results

* `CFSGCorollary.TrialityD4.twoGenerated_twistedGroup`: the model `twistedGroup σ` is
  two-generated.
* `CFSGCorollary.twoGenerated_trialityD4`: the simple group `³D₄(q)` is two-generated.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

open CFSG.LieType.Steinberg.TwistedD4
  (ng nHat proj twistedGroup twistedRootGroup twistedDatum_roots fixedUnits)
open CFSG.LieType.Steinberg.CentralExt.TrialityClosed
  (xS tor d01 isRoot_d01 rho_d01 proj_d01 mem_iff_xS tor_commute nu normU)

namespace CFSGCorollary

namespace TrialityD4

/-- ³D₄: the closure of `⟨tor 1 t, xS 1 * n⟩` contains `X a` and `n`. -/
theorem rootGroup_le_closure_and_nHat_mem {K : Type} [Field K] [Finite K] {σ : K →+* K} {q : ℕ}
    (hq : 2 ≤ q) (hK : Nat.card K = q ^ 3) (hσq : ∀ c : K, σ c = c ^ q)
    (hσ : ∀ c : K, σ (σ (σ c)) = c) (t : Kˣ) (ht : Subgroup.zpowers t = ⊤) :
    twistedRootGroup σ ![0, 1] ≤ Subgroup.closure
        {tor hσ 1 t, xS hσ isRoot_d01 rho_d01 1 * (nHat σ (ng 0) * nHat σ (ng 1))} ∧
      nHat σ (ng 0) * nHat σ (ng 1) ∈ Subgroup.closure
        {tor hσ 1 t, xS hσ isRoot_d01 rho_d01 1 * (nHat σ (ng 0) * nHat σ (ng 1))} := by
  obtain ⟨R, hRc, hcoord, hact⟩ := exists_shortRootGroup σ hσ
  have hp : proj d01 = ![0, 1] := proj_d01.trans (by ext i; fin_cases i <;> rfl)
  have hmem : xS hσ isRoot_d01 rho_d01 1 ∈ R.carrier := by
    rw [hRc]
    exact (mem_iff_xS hσ isRoot_d01 rho_d01 hp _).2 ⟨1, rfl⟩
  obtain ⟨hg1, hg2⟩ := isGoodScalar_sq_and_normU_mul_inv_sq hq hK hσq t ht
  set n := nHat σ (ng 0) * nHat σ (ng 1)
  have hconj : n * tor hσ 1 t * n⁻¹ = tor hσ (nu hσ t)⁻¹ t⁻¹ := nHat_mul_tor_mul_inv hσ t
  obtain ⟨A⟩ := hact 1 t
  obtain ⟨B⟩ := hact (nu hσ t)⁻¹ t⁻¹
  have hs1 : (((1 : fixedUnits σ) : Kˣ))⁻¹ * t ^ 2 = t ^ 2 := by simp
  have hA : R.Action (tor hσ 1 t) (t ^ 2) := by
    rw [← hs1]
    exact A
  have hs : (((nu hσ t)⁻¹ : fixedUnits σ) : Kˣ)⁻¹ * t⁻¹ ^ 2 = normU σ t * t⁻¹ ^ 2 := by
    rw [Subgroup.coe_inv, inv_inv]
    rfl
  have hB : R.Action (n * tor hσ 1 t * n⁻¹) (normU σ t * t⁻¹ ^ 2) := by
    rw [hconj, ← hs]
    exact B
  have hcomm : Commute (tor hσ 1 t) (n * tor hσ 1 t * n⁻¹) := by
    rw [hconj]
    exact tor_commute hσ _ _ _ _
  have := LambdaRootGroup.le_closure_pair_mul R (tor hσ 1 t) n (t ^ 2) (normU σ t * t⁻¹ ^ 2)
    hg1 hg2 hcomm hA hB ⟨_, hmem⟩ (by simp [hcoord _ hmem])
  exact ⟨by rw [← hRc]; exact this.1, this.2⟩

/-- The ³D₄ model is generated by `tor 1 t` and `xS 1 * n` for `t` a generator of `Kˣ`. -/
theorem closure_tor_xS_mul_nHat_eq_top {K : Type} [Field K] [Finite K] {σ : K →+* K} {q : ℕ}
    (hq : 2 ≤ q) (hK : Nat.card K = q ^ 3) (hσq : ∀ c : K, σ c = c ^ q)
    (hσ : ∀ c : K, σ (σ (σ c)) = c) (t : Kˣ) (ht : Subgroup.zpowers t = ⊤) :
    Subgroup.closure
      {tor hσ 1 t, xS hσ isRoot_d01 rho_d01 1 * (nHat σ (ng 0) * nHat σ (ng 1))} = ⊤ := by
  obtain ⟨ha, hn⟩ := rootGroup_le_closure_and_nHat_mem hq hK hσq hσ t ht
  set F := Subgroup.closure
    {tor hσ 1 t, xS hσ isRoot_d01 rho_d01 1 * (nHat σ (ng 0) * nHat σ (ng 1))}
  obtain ⟨hna, h12⟩ := rootGroup_neg_short_le σ F hn ha
  obtain ⟨hb, hnb⟩ := rootGroup_long_simple_le σ F hn (rootGroup_one_three_le hq hK hσq F ha h12)
  refine eq_top_of_simple_root_groups_le (τ := .G2) (twistedRootGroup σ) (nHat σ)
    (fun i _ hβ _ hx ↦ CFSG.LieType.Steinberg.TwistedD4.nHat_conj_mem σ i hβ hx)
    (fun i ↦ CFSG.LieType.Steinberg.TwistedD4.nHat_mem_rankOne σ i) ?_ F ?_
  · have := CFSG.LieType.Steinberg.TwistedD4.iSup_twistedDatum_rootGroup σ
    rwa [twistedDatum_roots] at this
  · intro i
    fin_cases i
    · have e : (Pi.single (ng 0) 1 : Fin (CFSG.Blueprint.Chevalley.Tag.rank .G2) → ℤ) =
          ![1, 0] := by
        funext j; fin_cases j <;> decide
      rw [e]
      exact ⟨hb, hnb⟩
    · have e : (Pi.single (ng 1) 1 : Fin (CFSG.Blueprint.Chevalley.Tag.rank .G2) → ℤ) =
          ![0, 1] := by
        funext j; fin_cases j <;> decide
      rw [e]
      exact ⟨ha, hna⟩

/-- The ³D₄ model `twistedGroup σ` is two-generated. -/
theorem twoGenerated_twistedGroup {K : Type} [Field K] [Finite K] {σ : K →+* K} {q : ℕ}
    (hq : 2 ≤ q) (hK : Nat.card K = q ^ 3) (hσq : ∀ c : K, σ c = c ^ q) :
    TwoGenerated (twistedGroup σ) := by
  have hσ := CFSG.LieType.Steinberg.TwistedD4.sigma_three_of_card hK hσq
  obtain ⟨t, ht⟩ := IsCyclic.exists_generator (α := Kˣ)
  exact ⟨_, _, closure_tor_xS_mul_nHat_eq_top hq hK hσq hσ t
    (eq_top_iff.2 fun x _ ↦ Subgroup.mem_zpowers_iff.mp (ht x))⟩

end TrialityD4

/-- The simple groups `³D₄(q)` are two-generated. -/
theorem twoGenerated_trialityD4 (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.trialityD4 q).Valid)
    [Finite (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.trialityD4 q, hv⟩)]
    [IsSimpleGroup (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.trialityD4 q, hv⟩)] :
    TwoGenerated (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.trialityD4 q, hv⟩) := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  have hK : Nat.card (GaloisField q.p (3 * q.exponent)) = q.card ^ 3 := by
    rw [GaloisField.card _ _ (by have := q.exponent_pos; omega), TauCeti.PrimePower.card_def,
      ← pow_mul, mul_comm]
  set K := GaloisField q.p (3 * q.exponent)
  let σ : K →+* K := iterateFrobenius K q.p q.exponent
  have hσ (x : K) : σ x = x ^ q.card := by
    rw [TauCeti.PrimePower.card_def]
    exact iterateFrobenius_def q.p q.exponent x
  have hq2 : 2 ≤ q.card := by
    rw [TauCeti.PrimePower.card_def]
    calc 2 ≤ q.p := q.prime_p.two_le
      _ = q.p ^ 1 := (pow_one _).symm
      _ ≤ q.p ^ q.exponent := Nat.pow_le_pow_right q.prime_p.pos q.exponent_pos
  obtain ⟨e⟩ := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.trialityD4 q hv K hK σ hσ
  let f := CFSG.LieType.Steinberg.TwistedD4.twistedGroupEquivDerived σ hq2 hK hσ
  let φ := e.toMonoidHom.comp ((QuotientGroup.mk' (Subgroup.center _)).comp f.toMonoidHom)
  exact twoGenerated_of_surjective φ
    (e.surjective.comp ((QuotientGroup.mk'_surjective _).comp f.surjective))
    (TrialityD4.twoGenerated_twistedGroup hq2 hK hσ)

end CFSGCorollary
