module

public import CFSG.LieType.Ree.LargeReeA1Pair
public import CFSG.LieType.Ree.LargeReeB2FixedCoordinates
public import CFSG.LieType.Ree.LargeReeTorusRootForms
import CFSG.LieType.Chevalley.GraphFixedHighestRoot
import CFSG.LieType.Ree.FixedTwoCellParabolics

/-!
# The large Ree groups `²F₄(q)`: setting and the generating pair

Throughout, `K` is a finite field of characteristic `2` with `Nat.card K = 2 ^ (2 * m + 1)` and
`θ = 2 ^ m`. The large Ree group is CFSG's `F4.reeGamma K m ≤ ModGL F4.tag K`, the fixed points
of the exceptional graph-field endomorphism of `F₄(K)`. Its relative Weyl group is dihedral,
generated by the reflections `s₀`, `s₁` along the two orbits of simple roots.

This file defines the objects of the two-generation argument and computes how the Coxeter
element `w = s₀ s₁` and the torus act on the relevant roots.

## Main definitions

* `CFSGCorollary.ReeF4.rootElemR`, `rootElemS`: root elements of the root groups
  `rootSubgroupR = X_{-S₂}` and `rootSubgroupS = X_{S₁}`.
* `CFSGCorollary.ReeF4.coxeterRep`: the lift `g = n₀ n₁` of the Coxeter element
  `coxeterWeylElement = s₀ s₁`.
* `CFSGCorollary.ReeF4.fixedTorusElt`: the torus element `d = torusPair (u, u²)`, and its
  conjugates `d₁ = g d g⁻¹`, `d₂ = g⁻¹ d g`.
* `CFSGCorollary.ReeF4.secondGenerator`: the second generator `b = y 1 * x_s (1, 0) * g`.

## Main results

* `CFSGCorollary.ReeF4.coxeterWeylElement_pow_four_smul`: `w ^ 4` negates the relevant roots.
* `CFSGCorollary.ReeF4.not_isRoot_orbit_sum`: there are no root sums between the two orbits.
* `CFSGCorollary.ReeF4.fixedTorusElt_conj_pinnedX`: `d` acts on root elements through the
  character `u ^ torusExponent m β`.
-/

@[expose] public section

noncomputable section

namespace CFSGCorollary.ReeF4

open CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley CFSG.LieType.Ree CFSG.LieType.Ree.ReeTag

/-- A vector of simple-root coordinates of `F₄`. -/
abbrev f4RootVector (a b c d : ℤ) : Fin F4.tag.rank → ℤ := ![a, b, c, d]

/-- The root element `y c = pinnedX (-α₀) c * pinnedX (-α₃) (c ^ θ)` of `X_{-S₂}`. -/
def rootElemR {K : Type} [Field K] (m : ℕ) (c : K) : ModGL F4.tag K :=
  yUnit F4.tag K largeReeI1 c * yUnit F4.tag K largeReeI4 (c ^ 2 ^ m)

/-- The root element of `X_{S₁}` with Suzuki-type coordinates `(t, v)`. -/
def rootElemS {K : Type} [Field K] (m : ℕ) (t v : K) : ModGL F4.tag K :=
  show ModGL F4.tag K from largeReeCoord m K t v

/-- The root group `X_r = X_{-S₂}` of the fixed group. -/
abbrev rootSubgroupR (K : Type) [Field K] [Finite K] [CharP K F4.prime] (m : ℕ) :
    Subgroup (ModGL F4.tag K) :=
  largeReeA1Y K m

/-- The root group `X_s = X_{S₁}` of the fixed group. -/
abbrev rootSubgroupS (K : Type) [Field K] [Finite K] [CharP K F4.prime] (m : ℕ) :
    Subgroup (ModGL F4.tag K) :=
  F4.reeFixedOrbitUnipotent K m ⟨1, by decide⟩

/-- The Weyl representative `n₀` (`j = 0`) or `n₁` (`j = 1`). -/
def weylRep (K : Type) [Field K] (j : Fin F4.fixedOrbitCount) : ModGL F4.tag K :=
  canonicalRep (coxeterSystem F4.tag) K (F4.fixedOrbitElement j)

/-- The lift `g = n₀ * n₁` of the Coxeter element. -/
def coxeterRep (K : Type) [Field K] : ModGL F4.tag K :=
  weylRep K ⟨0, by decide⟩ * weylRep K ⟨1, by decide⟩

/-- The Coxeter element `w = s₀ s₁` of the dihedral relative Weyl group. -/
def coxeterWeylElement : WeylGroup F4.tag :=
  F4.fixedOrbitElement ⟨0, by decide⟩ * F4.fixedOrbitElement ⟨1, by decide⟩

/-- The exponent `E β = torusExp0 θ β + 2 * torusExp1 θ β` of the torus character. -/
def torusExponent (m : ℕ) (β : Fin F4.tag.rank → ℤ) : ℤ :=
  LargeReeCover.torusExp0 (2 ^ m) β + 2 * LargeReeCover.torusExp1 (2 ^ m) β

/-- The torus element `d = torusPair (u, u²)`. -/
def fixedTorusElt {K : Type} [Field K] (m : ℕ) (u : Kˣ) : ModGL F4.tag K :=
  LargeReeCover.torusPair m (u, u ^ 2)

/-- The conjugate `d₁ = g d g⁻¹` of the torus element. -/
def fixedTorusEltConj {K : Type} [Field K] (m : ℕ) (u : Kˣ) : ModGL F4.tag K :=
  coxeterRep K * fixedTorusElt m u * (coxeterRep K)⁻¹

/-- The conjugate `d₂ = g⁻¹ d g` of the torus element. -/
def fixedTorusEltConjInv {K : Type} [Field K] (m : ℕ) (u : Kˣ) : ModGL F4.tag K :=
  (coxeterRep K)⁻¹ * fixedTorusElt m u * coxeterRep K

/-- The second generator `b = y 1 * largeReeCoord m K 1 0 * g`. -/
def secondGenerator (K : Type) [Field K] (m : ℕ) : ModGL F4.tag K :=
  rootElemR m (1 : K) * rootElemS m (1 : K) 0 * coxeterRep K

/-! ### Root computations for the Coxeter element `w` -/

private abbrev coxeterWord : List (Fin F4.tag.rank) := ([0, 3, 1, 2, 1, 2] : List (Fin 4))

private theorem coxeterWeylElement_eq_wordProd :
    coxeterWeylElement = (coxeterSystem F4.tag).wordProd coxeterWord :=
  (CoxeterSystem.wordProd_append (coxeterSystem F4.tag) ([0, 3] : List (Fin 4))
    ([1, 2, 1, 2] : List (Fin 4))).symm

private theorem coxeterWeylElement_smul (v : Fin F4.tag.rank → ℤ) :
    coxeterWeylElement • v = coxeterWord.foldr (reflect F4.tag) v := by
  rw [coxeterWeylElement_eq_wordProd, CFSG.LieType.Ree.wordProd_smul]

private theorem coxeterWeylElement_inv_smul (v : Fin F4.tag.rank → ℤ) :
    coxeterWeylElement⁻¹ • v = coxeterWord.reverse.foldr (reflect F4.tag) v := by
  rw [coxeterWeylElement_eq_wordProd, ← CoxeterSystem.wordProd_reverse,
    CFSG.LieType.Ree.wordProd_smul]

open LargeReeCover in
private theorem torusExponent_eq_of_cartanPair (m : ℕ) (β : Fin F4.tag.rank → ℤ)
    (a b c d : ℤ) (h0 : F4.cartanPair (f4i 0) β = a) (h1 : F4.cartanPair (f4i 1) β = b)
    (h2 : F4.cartanPair (f4i 2) β = c) (h3 : F4.cartanPair (f4i 3) β = d) :
    torusExponent m β = (a + 2 * b) + (d + 2 * c) * 2 ^ m := by
  simp only [torusExponent, torusExp0, torusExp1, h0, h1, h2, h3]; ring

private theorem neg_alpha0_eq : -(Pi.single largeReeI1 (1 : ℤ)) = f4RootVector (-1) 0 0 0 := by
  decide +kernel

private theorem neg_alpha3_eq : -(Pi.single largeReeI4 (1 : ℤ)) = f4RootVector 0 0 0 (-1) := by
  decide +kernel

private abbrev simpleRootIndex0 : Fin F4.tag.rank := (0 : Fin 4)
private abbrev simpleRootIndex1 : Fin F4.tag.rank := (1 : Fin 4)
private abbrev simpleRootIndex2 : Fin F4.tag.rank := (2 : Fin 4)
private abbrev simpleRootIndex3 : Fin F4.tag.rank := (3 : Fin 4)

private theorem nsmul_add_nsmul_f4RootVector (a b : ℕ) (x y z w x' y' z' w' : ℤ) :
    a • f4RootVector x y z w + b • f4RootVector x' y' z' w' =
      f4RootVector (a * x + b * x') (a * y + b * y') (a * z + b * z') (a * w + b * w') := by
  change (a • ![x, y, z, w] + b • ![x', y', z', w'] : Fin 4 → ℤ) = _
  ext j
  fin_cases j <;> simp

private theorem f4RootVector_inj {x y z w x' y' z' w' : ℤ}
    (h : f4RootVector x y z w = f4RootVector x' y' z' w') :
    x = x' ∧ y = y' ∧ z = z' ∧ w = w' :=
  ⟨congrFun h simpleRootIndex0, congrFun h simpleRootIndex1, congrFun h simpleRootIndex2,
    congrFun h simpleRootIndex3⟩

private theorem f4RootVector_nonneg_or_nonpos {x y z w : ℤ}
    (h : (∀ j, 0 ≤ f4RootVector x y z w j) ∨ (∀ j, f4RootVector x y z w j ≤ 0)) :
    (0 ≤ x ∧ 0 ≤ y ∧ 0 ≤ z ∧ 0 ≤ w) ∨ (x ≤ 0 ∧ y ≤ 0 ∧ z ≤ 0 ∧ w ≤ 0) := by
  rcases h with h | h
  · exact Or.inl ⟨h simpleRootIndex0, h simpleRootIndex1, h simpleRootIndex2,
      h simpleRootIndex3⟩
  · exact Or.inr ⟨h simpleRootIndex0, h simpleRootIndex1, h simpleRootIndex2,
      h simpleRootIndex3⟩

/-- The images of `-α₀` and `α₂` under `w⁻¹`. -/
theorem coxeterWeylElement_inv_smul_neg_alpha0 :
    coxeterWeylElement⁻¹ • (-(Pi.single largeReeI1 (1 : ℤ))) = f4RootVector 1 2 2 0 := by
  rw [coxeterWeylElement_inv_smul]
  decide +kernel

theorem coxeterWeylElement_inv_smul_alpha2 :
    coxeterWeylElement⁻¹ • f4RootVector 0 0 1 0 = f4RootVector 0 1 1 1 := by
  rw [coxeterWeylElement_inv_smul]
  decide +kernel

/-- The image of `-α₀` under `w`. -/
theorem coxeterWeylElement_smul_neg_alpha0 :
    coxeterWeylElement • (-(Pi.single largeReeI1 (1 : ℤ))) =
      f4RootVector (-1) (-2) (-2) (-2) := by
  rw [coxeterWeylElement_smul]
  decide +kernel

/-- `w ^ 4` negates the roots `α₀`, `α₃` of the first orbit and the positive roots of the
`B₂` block of the second orbit. -/
theorem coxeterWeylElement_pow_four_smul (β : Fin F4.tag.rank → ℤ)
    (hβ : β ∈ ({f4RootVector 1 0 0 0, f4RootVector 0 0 0 1, f4RootVector 0 0 1 0,
      f4RootVector 0 1 0 0, f4RootVector 0 1 1 0, f4RootVector 0 1 2 0} :
        Set (Fin F4.tag.rank → ℤ))) :
    coxeterWeylElement ^ 4 • β = -β ∧ coxeterWeylElement ^ 4 • (-β) = β := by
  have h4 : ∀ v, coxeterWeylElement ^ 4 • v = coxeterWord.foldr (reflect F4.tag)
      (coxeterWord.foldr (reflect F4.tag)
        (coxeterWord.foldr (reflect F4.tag) (coxeterWord.foldr (reflect F4.tag) v))) := by
    intro v
    simp only [pow_succ, pow_zero, one_mul, mul_smul, coxeterWeylElement_smul]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hβ
  rw [h4, h4]
  rcases hβ with rfl | rfl | rfl | rfl | rfl | rfl <;> constructor <;> decide +kernel

/-- The torus exponent of `-α₀` vanishes. -/
theorem torusExponent_neg_alpha0 (m : ℕ) :
    torusExponent m (-(Pi.single largeReeI1 (1 : ℤ))) = 0 := by
  rw [torusExponent_eq_of_cartanPair m _ (-2) 1 0 0 (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel)]
  ring

theorem torusExponent_alpha2 (m : ℕ) :
    torusExponent m (f4RootVector 0 0 1 0) = 3 * 2 ^ m - 2 := by
  rw [torusExponent_eq_of_cartanPair m _ 0 (-1) 2 (-1) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel)]
  ring

theorem torusExponent_one_two_two_zero (m : ℕ) :
    torusExponent m (f4RootVector 1 2 2 0) = 2 - 2 * 2 ^ m := by
  rw [torusExponent_eq_of_cartanPair m _ 0 1 0 (-2) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel)]
  ring

theorem torusExponent_zero_one_one_one (m : ℕ) :
    torusExponent m (f4RootVector 0 1 1 1) = 1 - 2 ^ m := by
  rw [torusExponent_eq_of_cartanPair m _ (-1) 1 (-1) 1 (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel)]
  ring

theorem torusExponent_neg_one_neg_two_neg_two_neg_two (m : ℕ) :
    torusExponent m (f4RootVector (-1) (-2) (-2) (-2)) = 2 * 2 ^ m - 2 := by
  rw [torusExponent_eq_of_cartanPair m _ 0 (-1) 2 (-2) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel)]
  ring

/-- No positive combination of a root of `-S₂` and a root of `S₁` is a root. -/
theorem not_isRoot_orbit_sum {β γ : Fin F4.tag.rank → ℤ}
    (hβ : β ∈ ({-(Pi.single largeReeI1 (1 : ℤ)), -(Pi.single largeReeI4 (1 : ℤ))} :
      Set (Fin F4.tag.rank → ℤ)))
    (hγ : γ ∈ ({f4RootVector 0 0 1 0, f4RootVector 0 1 0 0, f4RootVector 0 1 1 0,
      f4RootVector 0 1 2 0} : Set (Fin F4.tag.rank → ℤ)))
    (a b : ℕ) (ha : 0 < a) (hb : 0 < b) :
    ¬ IsRoot F4.tag (a • β + b • γ) ∧ β ≠ γ ∧ β ≠ -γ := by
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, neg_alpha0_eq, neg_alpha3_eq] at hβ hγ
  have hneg : ∀ x y z w : ℤ, -f4RootVector x y z w = f4RootVector (-x) (-y) (-z) (-w) := by
    intro x y z w
    change (-![x, y, z, w] : Fin 4 → ℤ) = ![-x, -y, -z, -w]
    ext j
    fin_cases j <;> simp
  have a' : (0 : ℤ) < a := by exact_mod_cast ha
  have b' : (0 : ℤ) < b := by exact_mod_cast hb
  rcases hβ with rfl | rfl <;> rcases hγ with rfl | rfl | rfl | rfl <;>
  refine ⟨?_, ?_, ?_⟩ <;> intro h
  all_goals
    first
    | (rw [nsmul_add_nsmul_f4RootVector] at h
       have := f4RootVector_nonneg_or_nonpos (IsRoot.nonneg_or_nonpos h)
       rcases this with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩ <;> nlinarith)
    | (try rw [hneg] at h
       have := f4RootVector_inj h
       simp at this)

/-! ### The Coxeter representative `g` -/

section CoxeterRep

variable {K : Type} [Field K] [Finite K] [CharP K F4.prime] {m : ℕ}

private theorem reeFixedTorus_mul_comm {g g' : ModGL F4.tag K} (hg : g ∈ F4.reeFixedTorus K m)
    (hg' : g' ∈ F4.reeFixedTorus K m) : g * g' = g' * g :=
  (ree_fixed_Bruhat_decomposition F4 m K).2.2.2.2.2.2.1 g hg g' hg'

theorem coxeterRep_mem_reeGamma : coxeterRep K ∈ F4.reeGamma K m :=
  mul_mem (canonicalRep_fixedOrbitElement_mem_reeGamma_inf (K := K) (a := m) _).1
    (canonicalRep_fixedOrbitElement_mem_reeGamma_inf (K := K) (a := m) _).1

omit [Finite K] in
private theorem two_eq_zero : (2 : K) = 0 :=
  have : CharP K 2 := inferInstanceAs (CharP K F4.prime)
  CharTwo.two_eq_zero

omit [Finite K] in
/-- Conjugation by `g` acts on root elements through `w`. -/
theorem coxeterRep_conj_pinnedX {β : Fin F4.tag.rank → ℤ} (hβ : IsRoot F4.tag β) (c : K) :
    coxeterRep K * pinnedX F4.tag K β c * (coxeterRep K)⁻¹ =
      pinnedX F4.tag K (coxeterWeylElement • β) c := by
  have h1 := canonicalRep_mul_pinnedX_mul_inv_of_two (two_eq_zero (K := K))
    (F4.fixedOrbitElement ⟨1, by decide⟩) hβ c
  have h0 := canonicalRep_mul_pinnedX_mul_inv_of_two (two_eq_zero (K := K))
    (F4.fixedOrbitElement ⟨0, by decide⟩) (IsRoot.smul hβ (F4.fixedOrbitElement ⟨1, by decide⟩)) c
  unfold coxeterRep weylRep coxeterWeylElement
  rw [mul_smul, ← h0, ← h1]
  simp only [mul_inv_rev, mul_assoc]

omit [Finite K] in
theorem coxeterRep_inv_conj_pinnedX {β : Fin F4.tag.rank → ℤ} (hβ : IsRoot F4.tag β) (c : K) :
    (coxeterRep K)⁻¹ * pinnedX F4.tag K β c * coxeterRep K =
      pinnedX F4.tag K (coxeterWeylElement⁻¹ • β) c := by
  have h := coxeterRep_conj_pinnedX (K := K) (IsRoot.smul hβ coxeterWeylElement⁻¹) c
  rw [smul_inv_smul] at h
  rw [← h]
  group

/-- Conjugation by `g` maps `rootSpan S ⊓ Γ` into `rootSpan (w • S) ⊓ Γ`. -/
theorem coxeterRep_conj_mem_rootSpan_inf {S : Set (Fin F4.tag.rank → ℤ)}
    (hS : ∀ α ∈ S, IsRoot F4.tag α) {x : ModGL F4.tag K}
    (hx : x ∈ rootSpan F4.tag K S ⊓ F4.reeGamma K m) :
    coxeterRep K * x * (coxeterRep K)⁻¹ ∈
      rootSpan F4.tag K ((fun β ↦ coxeterWeylElement • β) '' S) ⊓ F4.reeGamma K m := by
  obtain ⟨hx1, hx2⟩ := Subgroup.mem_inf.1 hx
  refine Subgroup.mem_inf.2 ⟨?_, Subgroup.mul_mem _
    (Subgroup.mul_mem _ coxeterRep_mem_reeGamma hx2) (Subgroup.inv_mem _ coxeterRep_mem_reeGamma)⟩
  set j0 : Fin F4.fixedOrbitCount := ⟨0, by decide⟩
  set j1 : Fin F4.fixedOrbitCount := ⟨1, by decide⟩
  have hS1 : ∀ α ∈ (fun β ↦ F4.fixedOrbitElement j1 • β) '' S, IsRoot F4.tag α := by
    rintro _ ⟨α, hα, rfl⟩
    exact IsRoot.smul (hS α hα) _
  have a1 := canonicalRep_conj_mem_rootSpan (K := K) (w := F4.fixedOrbitElement j1) hS hx1
  have a0 := canonicalRep_conj_mem_rootSpan (K := K) (w := F4.fixedOrbitElement j0) hS1 a1
  have himg : (fun α ↦ F4.fixedOrbitElement j0 • α) ''
      ((fun β ↦ F4.fixedOrbitElement j1 • β) '' S) =
      (fun β ↦ coxeterWeylElement • β) '' S := by
    rw [Set.image_image]
    simp [coxeterWeylElement, mul_smul, j0, j1]
  rw [himg] at a0
  have : coxeterRep K * x * (coxeterRep K)⁻¹ =
      weylRep K j0 * (weylRep K j1 * x * (weylRep K j1)⁻¹) * (weylRep K j0)⁻¹ := by
    unfold coxeterRep
    simp only [mul_inv_rev, mul_assoc]
    rfl
  rw [this]
  exact a0

omit [Finite K] [CharP K F4.prime] in
theorem weylRep_mem_normalizer (j : Fin F4.fixedOrbitCount) :
    weylRep K j ∈ Subgroup.normalizer (torusGroup F4.tag K : Set (ModGL F4.tag K)) :=
  canonicalRep_mem_normalizer _

omit [Finite K] [CharP K F4.prime] in
theorem coxeterRep_mem_normalizer :
    coxeterRep K ∈ Subgroup.normalizer (torusGroup F4.tag K : Set (ModGL F4.tag K)) :=
  mul_mem (weylRep_mem_normalizer _) (weylRep_mem_normalizer _)

/-- `d` lies in the fixed torus. -/
theorem fixedTorusElt_mem_reeFixedTorus (hK : Nat.card K = 2 ^ (2 * m + 1)) (u : Kˣ) :
    fixedTorusElt m u ∈ torusGroup F4.tag K ⊓ F4.reeGamma K m := by
  refine Subgroup.mem_inf.2 ⟨?_, LargeReeCover.torusPair_mem_reeGamma m hK _⟩
  unfold fixedTorusElt
  rw [LargeReeCover.torusPair_apply]
  exact mul_mem (mul_mem (torusElt_mem_torusGroup _ _) (torusElt_mem_torusGroup _ _))
    (mul_mem (torusElt_mem_torusGroup _ _) (torusElt_mem_torusGroup _ _))

/-- `d₁` lies in the fixed torus. -/
theorem fixedTorusEltConj_mem_reeFixedTorus (hK : Nat.card K = 2 ^ (2 * m + 1)) (u : Kˣ) :
    fixedTorusEltConj m u ∈ torusGroup F4.tag K ⊓ F4.reeGamma K m := by
  obtain ⟨h1, h2⟩ := Subgroup.mem_inf.1 (fixedTorusElt_mem_reeFixedTorus hK u)
  refine Subgroup.mem_inf.2 ⟨?_, Subgroup.mul_mem _
    (Subgroup.mul_mem _ coxeterRep_mem_reeGamma h2) (Subgroup.inv_mem _ coxeterRep_mem_reeGamma)⟩
  exact (Subgroup.mem_normalizer_iff.1 (coxeterRep_mem_normalizer (K := K)) _).1 h1

/-- `d₂` lies in the fixed torus. -/
theorem fixedTorusEltConjInv_mem_reeFixedTorus (hK : Nat.card K = 2 ^ (2 * m + 1)) (u : Kˣ) :
    fixedTorusEltConjInv m u ∈ torusGroup F4.tag K ⊓ F4.reeGamma K m := by
  obtain ⟨h1, h2⟩ := Subgroup.mem_inf.1 (fixedTorusElt_mem_reeFixedTorus hK u)
  refine Subgroup.mem_inf.2 ⟨?_, Subgroup.mul_mem _ (Subgroup.mul_mem _
    (Subgroup.inv_mem _ coxeterRep_mem_reeGamma) h2) coxeterRep_mem_reeGamma⟩
  have := (Subgroup.mem_normalizer_iff.1
    (Subgroup.inv_mem _ (coxeterRep_mem_normalizer (K := K))) _).1 h1
  simpa [fixedTorusEltConjInv, mul_assoc] using this

/-! ### Characters of `d`, `d₁`, `d₂` on root elements -/

omit [Finite K] [CharP K F4.prime] in
/-- `d` acts on the root element `pinnedX β c` by `u ^ torusExponent m β`. -/
theorem fixedTorusElt_conj_pinnedX (u : Kˣ) {β : Fin F4.tag.rank → ℤ} (hβ : IsRoot F4.tag β)
    (c : K) :
    fixedTorusElt m u * pinnedX F4.tag K β c * (fixedTorusElt m u)⁻¹ =
      pinnedX F4.tag K β (((u ^ torusExponent m β : Kˣ) : K) * c) := by
  have h := LargeReeCover.torusPair_conj_pinnedX (K := K) m (u, u ^ 2) hβ c
  have e : LargeReeCover.torusWeight (K := K) m β (u, u ^ 2) = u ^ torusExponent m β := by
    rw [LargeReeCover.torusWeight_apply, torusExponent, zpow_add, zpow_mul]
    norm_cast
  rwa [e] at h

omit [Finite K] in
/-- `d₁` acts on the root element `pinnedX β c` by `u ^ torusExponent m (w⁻¹ • β)`. -/
theorem fixedTorusEltConj_conj_pinnedX (u : Kˣ) {β : Fin F4.tag.rank → ℤ}
    (hβ : IsRoot F4.tag β) (c : K) :
    fixedTorusEltConj m u * pinnedX F4.tag K β c * (fixedTorusEltConj m u)⁻¹ =
      pinnedX F4.tag K β
        (((u ^ torusExponent m (coxeterWeylElement⁻¹ • β) : Kˣ) : K) * c) := by
  have hβ' : IsRoot F4.tag (coxeterWeylElement⁻¹ • β) := IsRoot.smul hβ _
  have e : fixedTorusEltConj m u * pinnedX F4.tag K β c * (fixedTorusEltConj m u)⁻¹ =
      coxeterRep K * (fixedTorusElt m u *
        ((coxeterRep K)⁻¹ * pinnedX F4.tag K β c * coxeterRep K) *
        (fixedTorusElt m u)⁻¹) * (coxeterRep K)⁻¹ := by
    unfold fixedTorusEltConj; group
  rw [e, coxeterRep_inv_conj_pinnedX hβ, fixedTorusElt_conj_pinnedX u hβ',
    coxeterRep_conj_pinnedX hβ', smul_inv_smul]

omit [Finite K] in
/-- `d₂` acts on the root element `pinnedX β c` by `u ^ torusExponent m (w • β)`. -/
theorem fixedTorusEltConjInv_conj_pinnedX (u : Kˣ) {β : Fin F4.tag.rank → ℤ}
    (hβ : IsRoot F4.tag β) (c : K) :
    fixedTorusEltConjInv m u * pinnedX F4.tag K β c * (fixedTorusEltConjInv m u)⁻¹ =
      pinnedX F4.tag K β (((u ^ torusExponent m (coxeterWeylElement • β) : Kˣ) : K) * c) := by
  have hβ' : IsRoot F4.tag (coxeterWeylElement • β) := IsRoot.smul hβ _
  have e : fixedTorusEltConjInv m u * pinnedX F4.tag K β c * (fixedTorusEltConjInv m u)⁻¹ =
      (coxeterRep K)⁻¹ * (fixedTorusElt m u *
        (coxeterRep K * pinnedX F4.tag K β c * (coxeterRep K)⁻¹) *
        (fixedTorusElt m u)⁻¹) * coxeterRep K := by
    unfold fixedTorusEltConjInv; group
  rw [e, coxeterRep_conj_pinnedX hβ, fixedTorusElt_conj_pinnedX u hβ',
    coxeterRep_inv_conj_pinnedX hβ', inv_smul_smul]

theorem commute_fixedTorusElt_fixedTorusEltConj (hK : Nat.card K = 2 ^ (2 * m + 1)) (u : Kˣ) :
    Commute (fixedTorusElt m u) (fixedTorusEltConj m u) :=
  reeFixedTorus_mul_comm (fixedTorusElt_mem_reeFixedTorus hK u)
    (fixedTorusEltConj_mem_reeFixedTorus hK u)

theorem commute_fixedTorusElt_fixedTorusEltConjInv (hK : Nat.card K = 2 ^ (2 * m + 1))
    (u : Kˣ) : Commute (fixedTorusElt m u) (fixedTorusEltConjInv m u) :=
  reeFixedTorus_mul_comm (fixedTorusElt_mem_reeFixedTorus hK u)
    (fixedTorusEltConjInv_mem_reeFixedTorus hK u)

theorem commute_fixedTorusEltConj_fixedTorusEltConjInv (hK : Nat.card K = 2 ^ (2 * m + 1))
    (u : Kˣ) : Commute (fixedTorusEltConj m u) (fixedTorusEltConjInv m u) :=
  reeFixedTorus_mul_comm (fixedTorusEltConj_mem_reeFixedTorus hK u)
    (fixedTorusEltConjInv_mem_reeFixedTorus hK u)

end CoxeterRep

end CFSGCorollary.ReeF4
