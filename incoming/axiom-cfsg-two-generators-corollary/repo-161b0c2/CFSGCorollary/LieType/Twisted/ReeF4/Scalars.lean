module

public import CFSGCorollary.LieType.LambdaRootGroup.Basic
import Mathlib.Algebra.CharP.CharAndCard

/-!
# Arithmetic facts for the large Ree groups

Let `K` be a field with `Nat.card K = 2 ^ (2 * m + 1)` and `θ = 2 ^ m`, so `|Kˣ| = 2 θ² - 1`.

* The torus exponents `3θ - 2`, `2 - 2θ`, `1 - θ`, `2θ - 2` are coprime to `|Kˣ|`, so if `u`
  generates `Kˣ` then so does each `u ^ e`; these are the scalars by which the torus acts on the
  root groups `X_{-S₂}` and `X_{S₁}`.
* The values `t ^ (2θ) * s + s ^ (2θ) * t` additively generate `K`; these are the commutators of
  the Suzuki-type root group `X_{S₁}`.

## Main results

* `CFSGCorollary.ReeF4.isGoodScalar_zpow_torusExponent`
* `CFSGCorollary.ReeF4.addSubgroup_closure_commutator_values_eq_top`
-/

@[expose] public section

namespace CFSGCorollary.ReeF4

/-- With `θ = 2 ^ m`, `N = 2 θ² - 1`, the integers `3θ - 2`, `2 - 2θ`, `1 - θ`, `2θ - 2`
are coprime to `N`. -/
theorem isCoprime_torusExponent {m : ℕ} {e : ℤ}
    (he : e ∈ ({3 * 2 ^ m - 2, 2 - 2 * 2 ^ m, 1 - 2 ^ m, 2 * 2 ^ m - 2} : Set ℤ)) :
    IsCoprime e (2 * ((2 : ℤ) ^ m) ^ 2 - 1) := by
  set t : ℤ := 2 ^ m with ht
  have h2 : IsCoprime (2 : ℤ) (2 * t ^ 2 - 1) := ⟨t ^ 2, -1, by ring⟩
  have h1 : IsCoprime (1 - t) (2 * t ^ 2 - 1) := ⟨2 * (t + 1), 1, by ring⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at he
  rcases he with rfl | rfl | rfl | rfl
  · exact ⟨2 * (3 * t + 2), -9, by ring⟩
  · have : (2 - 2 * t) = 2 * (1 - t) := by ring
    rw [this]; exact h2.mul_left h1
  · exact h1
  · have : (2 * t - 2) = 2 * -(1 - t) := by ring
    rw [this]; exact h2.mul_left h1.neg_left

/-- The corresponding power of an element of order `q - 1` again has order `q - 1`. -/
theorem orderOf_zpow_torusExponent {K : Type} [Field K] [Finite K] {m : ℕ} (hm : 1 ≤ m)
    (hK : Nat.card K = 2 ^ (2 * m + 1)) {u : Kˣ} (hu : orderOf u = Nat.card K - 1) {e : ℤ}
    (he : e ∈ ({3 * 2 ^ m - 2, 2 - 2 * 2 ^ m, 1 - 2 ^ m, 2 * 2 ^ m - 2} : Set ℤ)) :
    orderOf (u ^ e) = Nat.card K - 1 := by
  have hpos : 1 ≤ 2 ^ (2 * m + 1) := Nat.one_le_two_pow
  have hN : ((Nat.card K - 1 : ℕ) : ℤ) = 2 * ((2 : ℤ) ^ m) ^ 2 - 1 := by
    rw [hK]; push_cast [hpos]; ring
  have hc := isCoprime_torusExponent he
  rw [← hN] at hc
  have hg : (Nat.card K - 1).gcd e.natAbs = 1 := by
    have := Int.isCoprime_iff_gcd_eq_one.mp hc.symm
    rw [Int.gcd, Int.natAbs_natCast] at this
    exact this
  have hne : e ≠ 0 := by
    rintro rfl
    have := hc
    simp only [isCoprime_zero_left, Int.isUnit_iff] at this
    have h7 : 4 ≤ 2 ^ (2 * m + 1) := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)
    rw [hK] at this
    omega
  rw [orderOf_zpow, hu, hg, Nat.div_one]

/-- Each of these powers is a good scalar: it generates `Kˣ` and is `≠ 1`. -/
theorem isGoodScalar_zpow_torusExponent {K : Type} [Field K] [Finite K] {m : ℕ} (hm : 1 ≤ m)
    (hK : Nat.card K = 2 ^ (2 * m + 1)) {u : Kˣ} (hu : orderOf u = Nat.card K - 1) {e : ℤ}
    (he : e ∈ ({3 * 2 ^ m - 2, 2 - 2 * 2 ^ m, 1 - 2 ^ m, 2 * 2 ^ m - 2} : Set ℤ)) :
    IsNontrivialGeneratingScalar (u ^ e) := by
  have hord := orderOf_zpow_torusExponent hm hK hu he
  have hcard : Nat.card Kˣ = Nat.card K - 1 := by
    rw [Nat.card_units K]
  have h7 : 4 ≤ 2 ^ (2 * m + 1) := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)
  refine ⟨⟨u ^ e, ?_, Or.inl rfl⟩, ?_⟩
  · apply Subgroup.eq_top_of_card_eq
    rw [Nat.card_zpowers, hord, hcard]
  · intro h
    rw [h, orderOf_one] at hord
    rw [hK] at hord
    omega

/-- The additive subgroup of `K` generated by `t ^ (2θ) * s + s ^ (2θ) * t` is all of `K`. -/
theorem addSubgroup_closure_commutator_values_eq_top {K : Type} [Field K] [Finite K]
    {m : ℕ} (hm : 1 ≤ m) (hK : Nat.card K = 2 ^ (2 * m + 1)) :
    AddSubgroup.closure
      {x : K | ∃ s t : K, x = t ^ (2 * 2 ^ m) * s + s ^ (2 * 2 ^ m) * t} = ⊤ := by
  classical
  set n : ℕ := 2 * 2 ^ m with hn
  have hq : Nat.card K = 2 ^ m * n := by rw [hK, hn]; ring
  have hnpos : 2 ≤ n := by
    have : 1 ≤ 2 ^ m := Nat.one_le_two_pow
    omega
  have hqn : 2 * n ≤ Nat.card K := by
    have : 2 ≤ 2 ^ m := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ m := Nat.pow_le_pow_right (by norm_num) hm
    rw [hq]; nlinarith
  have hchar : CharP K 2 := by
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have := Fintype.ofFinite K
    exact charP_of_card_eq_prime_pow (p := 2) (f := 2 * m + 1)
      (by rw [← Nat.card_eq_fintype_card]; exact hK)
  have hcop : (Nat.card Kˣ).Coprime (n + 1) := by
    rw [Nat.card_units]
    have aux : ∀ n N : ℕ, 1 ≤ n → 1 ≤ N → n * n = 2 * N →
        (n + 1) * (n - 1) = 2 * (N - 1) + 1 := by
      intro n N hn hN h
      obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
      obtain ⟨j, rfl⟩ : ∃ j, N = j + 1 := ⟨N - 1, by omega⟩
      simp only [Nat.add_sub_cancel]
      nlinarith
    have key := aux n (Nat.card K) (by omega) (by omega) (by rw [hK, hn]; ring)
    apply Nat.coprime_of_dvd'
    intro p _ h1 h2
    have h3 : p ∣ 2 * (Nat.card K - 1) + 1 := key ▸ Dvd.dvd.mul_right h2 _
    exact (Nat.dvd_add_right (Dvd.dvd.mul_left h1 2)).1 h3
  have hex : ∃ s : K, s ^ n + s ≠ 0 := by
    by_contra hcon
    push Not at hcon
    have hall : ∀ u : Kˣ, u ^ n = u := by
      intro u
      apply Units.ext
      have := hcon u
      have h2 : (u : K) ^ n = - (u : K) := eq_neg_of_add_eq_zero_left this
      rw [Units.val_pow_eq_pow_val, h2, CharTwo.neg_eq]
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Kˣ)
    have hord : orderOf g = Nat.card Kˣ := orderOf_eq_card_of_forall_mem_zpowers hg
    have h1 : g ^ (n - 1) = 1 := by
      have := hall g
      obtain ⟨k, hk⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
      rw [hk, pow_succ] at this
      rw [hk]
      simpa using this
    have h2 := orderOf_dvd_of_pow_eq_one h1
    rw [hord, Nat.card_units] at h2
    have := Nat.le_of_dvd (by omega) h2
    omega
  obtain ⟨s0, hs0⟩ := hex
  rw [eq_top_iff]
  intro e _
  apply AddSubgroup.subset_closure
  by_cases he : e = 0
  · exact ⟨0, 0, by simp [he, hn]⟩
  · have hx : e / (s0 ^ n + s0) ≠ 0 := div_ne_zero he hs0
    obtain ⟨c, hc⟩ := (powCoprime hcop).surjective (Units.mk0 _ hx)
    have hc' : (c : K) ^ (n + 1) = e / (s0 ^ n + s0) := by
      have := congrArg Units.val hc
      simpa using this
    refine ⟨c, c * s0, ?_⟩
    have : e = (c : K) ^ (n + 1) * (s0 ^ n + s0) := by
      rw [hc']; field_simp
    rw [this]; ring

end CFSGCorollary.ReeF4
