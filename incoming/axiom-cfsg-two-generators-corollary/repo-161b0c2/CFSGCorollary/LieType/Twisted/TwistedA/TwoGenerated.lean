module

public import CFSGCorollary.TwoGenerated.Basic
import all TauCeti.GroupTheory.SpecificGroups.CFSG.Index
public import CFSGCorollary.LieType.Twisted.TwistedA.Torus
import CFSG.Assembly.GL83LieDefs
import CFSG.LieType.Universal.Unitary.Clause0
import CFSG.LieType.Universal.Unitary.Roots
import CFSG.LocalAnalysis.QuasithinUnique.SQTK.UnitaryTauCeti
import CFSGCorollary.LieType.Twisted.TwistedA.Generation

/-!
# The unitary groups are two-generated

We show that `SU (unitaryInvolution F p f) n` is generated by two elements for `n ≥ 3` and
`(n, q) ≠ (3, 2)`, where `F` has `q ^ 2` elements, `q = p ^ f`. The generators are a torus element
`d` and `u g`, where `g` is the twisted Coxeter element and `u` is an element of the root group
`S(0, 1)` (for `n` even) or `H(0)` (for `n` odd). Since `SU` surjects onto the simple group
`²Aᵣ(q)` (with `n = r + 1`), the latter is two-generated as well.

## Main results

* `TwistedA.twoGenerated_su`: `SU` is two-generated.
* `CFSGCorollary.twoGenerated_twistedA`: the finite simple groups `²Aᵣ(q)` are two-generated.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

@[expose] public section

namespace CFSGCorollary.TwistedA

open CFSG.LieType.Universal.Unitary CFSG.LieType.BorelTits

section

variable {F : Type} [Field F] [Finite F] {p f : ℕ} [Fact p.Prime] [CharP F p]
  (hF : Nat.card F = (p ^ f) ^ 2) {n : ℕ}

/-- `n` even: `d` and `u g` generate `SU`, where `u ∈ S(0, 1)` has coordinate `1`. -/
theorem closure_eq_top_of_even (hn : 4 ≤ n) (hev : n % 2 = 0) (κ : Fˣ)
    (hκ : ∀ x : Fˣ, x ∈ Subgroup.zpowers κ)
    {ζ : traceZero (unitaryInvolution F p f)} (hζ : (ζ : F) ≠ 0) :
    Subgroup.closure {torusElement hF hn (κ : F),
      shortRootHom (unitaryInvolution_involutive hF) hn (Multiplicative.ofAdd (1 : F)) *
        coxeterElement (unitaryInvolution_involutive hF) ζ n} = ⊤ := by
  obtain ⟨h1, h2⟩ :=
    shortRootSubgroup_le_closure_and_coxeterElement_mem_of_even hF hn hev κ hκ hζ
  obtain ⟨hA, hB⟩ := rootGroups_le_of_coxeterElement_mem_of_range_le
    (unitaryInvolution_involutive hF) hn hev hζ h2 h1
  refine eq_top_of_rootElements_mem hF (by omega) _ ?_ ?_ ?_
  · intro i j hij hi hj hjr c
    exact hA i j hij hi hj hjr ⟨c, rfl⟩
  · intro i hi c
    exact hB i hi ⟨c, rfl⟩
  · intro i k hi hik hk
    exfalso
    have := congrArg Fin.val hk
    simp [Fin.val_rev] at this
    omega

/-- `n` odd, `n ≥ 5`: `d` and `u_β g` generate `SU`. -/
theorem closure_eq_top_of_odd (hodd : n % 2 = 1) (hn : 5 ≤ n) (κ : Fˣ)
    (hκ : ∀ x : Fˣ, x ∈ Subgroup.zpowers κ)
    {ζ : traceZero (unitaryInvolution F p f)} (hζ : (ζ : F) ≠ 0)
    {β : F} (hβ : β + unitaryInvolution F p f β = -1)
    {u : SU (unitaryInvolution F p f) n}
    (hu : ((u : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
      heisenbergMatrix (unitaryInvolution F p f)
        (lowIdx ⟨0, by omega⟩) (midIdx hodd) 1 β) :
    Subgroup.closure {torusElement hF (by omega) (κ : F),
      u * coxeterElement (unitaryInvolution_involutive hF) ζ n} = ⊤ := by
  obtain ⟨h1, h2⟩ :=
    heisenbergRootSubgroup_le_closure_and_coxeterElement_mem_of_odd hF hodd hn κ hκ hζ hβ hu
  obtain ⟨hH, hL, hS⟩ := rootGroups_le_of_coxeterElement_mem_of_heisenbergSubgroup_le
    (unitaryInvolution_involutive hF) (by omega) hodd hζ h2 h1
  refine eq_top_of_rootElements_mem hF (by omega) _ ?_ ?_ ?_
  · intro i j hij hi hj hjr c
    exact hS i j hij hi hj hjr ⟨c, rfl⟩
  · intro i hi c
    exact hL i hi ⟨c, rfl⟩
  · intro i k hi hik hk
    exact hH i k hi hik hk

/-- `n = 3`, `q ≠ 2`: `D` and `u_β g` generate `SU`. -/
theorem closure_eq_top_three (hnq : p ^ f ≠ 2) (κ : Fˣ) (hκ : ∀ x : Fˣ, x ∈ Subgroup.zpowers κ)
    {ζ : traceZero (unitaryInvolution F p f)} (hζ : (ζ : F) ≠ 0)
    {D : SU (unitaryInvolution F p f) 3} {t : Fin 3 → F}
    (hD : ((D : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) = Matrix.diagonal t)
    (ht : t = ![(κ : F), (κ : F) ^ (p ^ f - 1), ((κ ^ (p ^ f))⁻¹ : Fˣ)])
    {β : F} (hβ : β + unitaryInvolution F p f β = -1)
    {u : SU (unitaryInvolution F p f) 3}
    (hu : ((u : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) =
      heisenbergMatrix (unitaryInvolution F p f)
        (lowIdx ⟨0, by omega⟩) (midIdx (n := 3) (by omega)) 1 β) :
    Subgroup.closure {D, u * coxeterElement (unitaryInvolution_involutive hF) ζ 3} = ⊤ := by
  obtain ⟨h1, h2⟩ :=
    heisenbergRootSubgroup_le_closure_and_coxeterElement_mem_three hF hnq κ hκ hζ hD ht hβ hu
  obtain ⟨hH, hL, hS⟩ := rootGroups_le_of_coxeterElement_mem_of_heisenbergSubgroup_le
    (unitaryInvolution_involutive hF) (by omega) (by omega) hζ h2 h1
  refine eq_top_of_rootElements_mem hF (by omega) _ ?_ ?_ ?_
  · intro i j hij hi hj hjr c
    exact hS i j hij hi hj hjr ⟨c, rfl⟩
  · intro i hi c
    exact hL i hi ⟨c, rfl⟩
  · intro i k hi hik hk
    exact hH i k hi hik hk

include hF in
/-- `SU` is two-generated for `n ≥ 3`, `(n, q) ≠ (3, 2)`. -/
theorem twoGenerated_su (hn : 3 ≤ n) (hnq : ¬ (n = 3 ∧ p ^ f = 2)) :
    TwoGenerated (SU (unitaryInvolution F p f) n) := by
  classical
  obtain ⟨κ, hκ⟩ := IsCyclic.exists_generator (α := Fˣ)
  obtain ⟨ζ, hζ⟩ := exists_traceZero_ne_zero hF
  have hn' : 4 ≤ n ∨ n % 2 = 1 := by omega
  have hσ := unitaryInvolution_involutive (K := F) (p := p) (f := f) hF
  have hneg : unitaryInvolution F p f (-1) = -1 := by simp
  obtain ⟨β, hβ⟩ := exists_add_unitaryInvolution_eq hF hneg
  -- the Heisenberg element
  have hodd_u : ∀ (hodd : n % 2 = 1) (hn3 : 3 ≤ n), ∃ u : SU (unitaryInvolution F p f) n,
      ((u : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) =
        heisenbergMatrix (unitaryInvolution F p f)
          (lowIdx ⟨0, by omega⟩) (midIdx hodd) 1 β := by
    intro hodd hn3
    have hi := lowIdx_ne_rev_self (n := n) ⟨0, by omega⟩
    have hik := lowIdx_ne_midIdx hodd ⟨0, by omega⟩
    have hk := rev_midIdx hodd
    have hab : β + unitaryInvolution F p f β + unitaryInvolution F p f 1 * 1 = 0 := by
      simp only [map_one, mul_one]; linear_combination hβ
    have hmul : heisenbergMatrix (unitaryInvolution F p f)
        (lowIdx ⟨0, by omega⟩) (midIdx hodd) 1 β *
        heisenbergMatrix (unitaryInvolution F p f)
        (lowIdx ⟨0, by omega⟩) (midIdx hodd) (-1) (-β - 1 * unitaryInvolution F p f 1) = 1 := by
      rw [heisenbergMatrix_mul _ hi hik hk]
      have h2 :
          β + (-β - 1 * unitaryInvolution F p f 1) - 1 * unitaryInvolution F p f (-1) = 0 := by
        rw [hneg, map_one]; ring
      rw [show (1 : F) + -1 = 0 by ring, h2]
      exact heisenbergMatrix_zero _ _ _
    have hmul' : heisenbergMatrix (unitaryInvolution F p f)
        (lowIdx ⟨0, by omega⟩) (midIdx hodd) (-1) (-β - 1 * unitaryInvolution F p f 1) *
        heisenbergMatrix (unitaryInvolution F p f)
        (lowIdx ⟨0, by omega⟩) (midIdx hodd) 1 β = 1 := by
      rw [heisenbergMatrix_mul _ hi hik hk]
      have h2 : (-β - 1 * unitaryInvolution F p f 1) + β - -1 * unitaryInvolution F p f 1 = 0 := by
        ring
      rw [show (-1 : F) + 1 = 0 by ring, h2]
      exact heisenbergMatrix_zero _ _ _
    refine ⟨⟨⟨_, _, hmul, hmul'⟩, ?_⟩, rfl⟩
    exact ⟨det_heisenbergMatrix _ hi hik hk _ _,
      heisenbergMatrix_isometry _ hσ hi hik hk (by simpa using hab)⟩
  by_cases hev : n % 2 = 0
  · have h4 : 4 ≤ n := by omega
    refine ⟨_, _, closure_eq_top_of_even hF h4 hev κ hκ hζ⟩
  · have hodd : n % 2 = 1 := by omega
    by_cases h3 : n = 3
    · subst h3
      have hnq' : p ^ f ≠ 2 := fun h ↦ hnq ⟨rfl, h⟩
      obtain ⟨D, hD⟩ := exists_su_coe_eq_diagonal_three hF κ hκ
      obtain ⟨u, hu⟩ := hodd_u hodd le_rfl
      exact ⟨_, _, closure_eq_top_three hF hnq' κ hκ hζ hD rfl hβ hu⟩
    · obtain ⟨u, hu⟩ := hodd_u hodd hn
      exact ⟨_, _, closure_eq_top_of_odd hF hodd (by omega) κ hκ hζ hβ hu⟩

end

/-- `SU` surjects onto the `²Aᵣ(q)` carrier. -/
theorem exists_surjective_su (r : ℕ) (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.twistedA r q).Valid) :
    haveI : Fact q.p.Prime := ⟨q.prime_p⟩
    Nat.card (GaloisField q.p (2 * q.exponent)) = (q.p ^ q.exponent) ^ 2 ∧
      3 ≤ r + 1 ∧ (r + 1, q.p ^ q.exponent) ≠ (3, 2) ∧
      ∃ φ : SU (unitaryInvolution (GaloisField q.p (2 * q.exponent)) q.p q.exponent) (r + 1) →*
          TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedA r q, hv⟩,
        Function.Surjective φ := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  have hr := (TauCeti.LieTypeIndex.inStandardRange_iff _).1 hv.1
  simp only at hr
  obtain ⟨h2, h3⟩ := hr
  have hcard : Nat.card (GaloisField q.p (2 * q.exponent)) = (q.p ^ q.exponent) ^ 2 := by
    rw [GaloisField.card _ _ (by have := q.exponent_pos; omega), ← pow_mul, mul_comm]
  have hn : 3 ≤ r + 1 := by omega
  have hnq : (r + 1, q.p ^ q.exponent) ≠ (3, 2) := by
    intro h
    simp only [Prod.mk.injEq] at h
    obtain ⟨h1, h4⟩ := h
    have := h3 (by omega)
    simp only [TauCeti.PrimePower.card] at this
    omega
  refine ⟨hcard, hn, hnq, ?_⟩
  have hZ := (isQuasisimple_statedSU_of_card hcard hn hnq).2
  let e := centerQuotientEquivStatedProj hcard hZ
  let e2 := CFSG.QuasithinUnique.SQTK.typeTwistedAGroupEquivStatedProj r q hv
  refine ⟨((e2.symm.toMonoidHom).comp e.toMonoidHom).comp (QuotientGroup.mk' _), ?_⟩
  exact (e2.symm.surjective.comp e.surjective).comp (QuotientGroup.mk'_surjective _)

end CFSGCorollary.TwistedA

namespace CFSGCorollary

open TwistedA

/-- The finite simple unitary groups `²Aᵣ(q)` are two-generated. -/
theorem twoGenerated_twistedA (r : ℕ) (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.twistedA r q).Valid)
    [Finite (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedA r q, hv⟩)]
    [IsSimpleGroup (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedA r q, hv⟩)] :
    TwoGenerated (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedA r q, hv⟩) := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  obtain ⟨hcard, hn, hnq, φ, hφ⟩ := exists_surjective_su r q hv
  refine twoGenerated_of_surjective φ hφ ?_
  refine twoGenerated_su hcard (F := GaloisField q.p (2 * q.exponent)) (p := q.p) (f := q.exponent)
    (n := r + 1) hn ?_
  intro h
  exact hnq (by rw [h.1, h.2])

end CFSGCorollary
