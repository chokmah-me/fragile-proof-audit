module

public import CFSGCorollary.LieType.Twisted.Suzuki.RootGroup
public import CFSG.StronglyEmbedded.Catalog.Suzuki
public import CFSGCorollary.TwoGenerated.Basic
import CFSGCorollary.LieType.LambdaRootGroup.ClosurePair
import CFSGCorollary.LieType.Twisted.Suzuki.Torus

@[expose] public section

/-!
# The Suzuki groups are two-generated

For `m ≥ 1`, `F = GF(2 ^ (2m + 1))` and `κ ∈ Fˣ` such that `χ(κ) = κ ^ θ κ⁻²` generates `Fˣ`, the
torus element `h(κ)` and `u(1, 0) w` generate the Suzuki group `Sz(F)`: this is the rank one case
`LambdaRootGroup.le_closure_pair_of_inverting` of Steinberg's argument applied to the λ-root group
`X_m`, since `w` inverts `h(κ)` and `Sz(F)` is generated by `X_m` and `w`.

## Main results

* `CFSGCorollary.Suzuki.closure_torus_unipotent_mul_weyl`: `⟨h(κ), u(1, 0) w⟩ = Sz(F)`.
* `CFSGCorollary.twoGenerated_suzuki`: TauCeti's Suzuki groups `²B₂(2 ^ (2m + 1))` are
  two-generated.

## References

* [R. Steinberg, *Generators for simple groups*, Canad. J. Math. 14 (1962) 277–283][Steinberg1962]
-/

namespace CFSGCorollary

namespace Suzuki

open TauCeti.Suzuki (unipotent torus weyl torus_mem_suzukiGroup unipotent_mem_suzukiGroup
  weyl_mem_suzukiGroup)

/-- For `m ≥ 1` and `κ` with `χ(κ)` a generator of `Fˣ` different from `1`
(see `exists_generator_torusCharacter`), `h(κ)` and `u(1, 0) w` generate the Suzuki group. -/
theorem closure_torus_unipotent_mul_weyl {m : ℕ} (hm : 1 ≤ m)
    {κ : (GaloisField 2 (2 * m + 1))ˣ}
    (hgen : ∀ y : (GaloisField 2 (2 * m + 1))ˣ, y ∈ Subgroup.zpowers (torusCharacter m κ))
    (hne : torusCharacter m κ ≠ 1) :
    Subgroup.closure {torus m κ, unipotent m 1 0 * weyl m} = TauCeti.suzukiGroup m := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact torus_mem_suzukiGroup m κ
    · exact Subgroup.mul_mem _ (unipotent_mem_suzukiGroup 1 0) weyl_mem_suzukiGroup
  · have hz : Subgroup.zpowers (torusCharacter m κ) = ⊤ := Subgroup.eq_top_iff' _ |>.2 hgen
    have hu : Multiplicative.toAdd ((lambdaRootGroup hm).coordinate
        ⟨unipotent m 1 0, unipotent_mem_unipotentSubgroup m 1 0⟩) ≠ 0 := by
      intro h0
      have h0' : Multiplicative.toAdd (leadingCoordinate m
          ⟨unipotent m 1 0, unipotent_mem_unipotentSubgroup m 1 0⟩) = 0 := h0
      rw [leadingCoordinate_unipotent] at h0'
      exact one_ne_zero h0'
    obtain ⟨h1, h2⟩ := (lambdaRootGroup hm).le_closure_pair_of_inverting (torus m κ) (weyl m)
      (torusCharacter m κ) hz hne (torusAction hm κ) (weyl_mul_torus_mul_weyl_inv_eq_inv m κ)
      ⟨unipotent m 1 0, unipotent_mem_unipotentSubgroup m 1 0⟩ hu
    rw [TauCeti.Suzuki.suzukiGroup_le_iff]
    exact ⟨fun a b ↦ h1 (unipotent_mem_unipotentSubgroup m a b), h2⟩

/-- TauCeti's Suzuki carrier is the generated Suzuki group. -/
noncomputable def lieTypeGroupEquivSuzukiGroup {m : ℕ}
    (hv : (TauCeti.LieTypeIndex.suzuki m).Valid) :
    TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.suzuki m, hv⟩ ≃*
      ↥(TauCeti.suzukiGroup m) :=
  (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hv).trans
    (CFSG.BenderSuzuki.Catalog.suzukiGroupEquiv m).symm

end Suzuki

open TauCeti.Suzuki (unipotent_mem_suzukiGroup weyl_mem_suzukiGroup) in
/-- The Suzuki groups `²B₂(2 ^ (2m + 1))` are two-generated. -/
theorem twoGenerated_suzuki (m : ℕ)
    (hv : (TauCeti.LieTypeIndex.suzuki m).Valid)
    [Finite (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.suzuki m, hv⟩)]
    [IsSimpleGroup (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.suzuki m, hv⟩)] :
    TwoGenerated (TauCeti.ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.suzuki m, hv⟩) := by
  have hm : 1 ≤ m :=
    (TauCeti.LieTypeIndex.inStandardRange_iff _).mp ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1
  obtain ⟨κ, hgen, hne⟩ := Suzuki.exists_generator_torusCharacter hm
  refine twoGenerated_of_mulEquiv (Suzuki.lieTypeGroupEquivSuzukiGroup hv) ?_
  exact twoGenerated_subgroup_of_closure_pair_eq (TauCeti.suzukiGroup m) _ _
    (TauCeti.Suzuki.torus_mem_suzukiGroup m κ)
    (Subgroup.mul_mem _ (unipotent_mem_suzukiGroup 1 0) weyl_mem_suzukiGroup)
    (Suzuki.closure_torus_unipotent_mul_weyl hm hgen hne)

end CFSGCorollary
