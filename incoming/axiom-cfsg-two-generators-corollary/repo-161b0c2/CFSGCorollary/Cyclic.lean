module

public import CFSGCorollary.TwoGenerated.Basic
public import Mathlib.Data.ZMod.Defs
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Cyclic groups are two-generated

The cyclic group `Multiplicative (ZMod n)` is generated by a single element, hence is
two-generated. This covers the cyclic groups of prime order in the classification.

## Main results

* `CFSGCorollary.twoGenerated_cyclic`: `Multiplicative (ZMod n)` is two-generated.
-/

@[expose] public section

namespace CFSGCorollary

/-- The cyclic group `Multiplicative (ZMod n)` is two-generated. -/
theorem twoGenerated_cyclic (modulus : ℕ) :
    TwoGenerated (Multiplicative (ZMod modulus)) := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Multiplicative (ZMod modulus))
  refine twoGenerated_of_closure_singleton g ?_
  rw [← Subgroup.zpowers_eq_closure, eq_top_iff]
  exact fun x _ ↦ hg x

end CFSGCorollary
