module

public import Mathlib.GroupTheory.Subgroup.Simple
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# Two-generated groups

A group `G` is *two-generated* if there are `a b : G` with `Subgroup.closure {a, b} = ⊤`. This file
defines the predicate `CFSGCorollary.TwoGenerated` and its basic API: it is transported along
surjective homomorphisms and isomorphisms, it holds for a subgroup generated by two of its
elements, and it holds for commutative simple groups.

## Main definitions

* `CFSGCorollary.TwoGenerated`: the group is generated by two elements.

## Main results

* `CFSGCorollary.twoGenerated_of_surjective`, `CFSGCorollary.twoGenerated_of_mulEquiv`:
  transport along surjections and isomorphisms.
* `CFSGCorollary.twoGenerated_subgroup_of_closure_pair_eq`: a subgroup generated by two of its
  elements is two-generated.
* `CFSGCorollary.center_eq_bot_or_twoGenerated`: a simple group is either noncommutative with
  trivial center, or commutative and two-generated.
-/

@[expose] public section

namespace CFSGCorollary

/-- A group is *two-generated* if it is generated by two elements. -/
def TwoGenerated (G : Type*) [Group G] : Prop :=
  ∃ a b : G, Subgroup.closure {a, b} = ⊤

/-- The image of a two-generated group under a surjective homomorphism is two-generated. -/
theorem twoGenerated_of_surjective {G H : Type*} [Group G] [Group H]
    (hom : G →* H) (surjective : Function.Surjective hom)
    (generated : TwoGenerated G) : TwoGenerated H := by
  obtain ⟨a, b, h⟩ := generated
  refine ⟨hom a, hom b, ?_⟩
  rw [← Set.image_pair, ← MonoidHom.map_closure, h, Subgroup.map_top_of_surjective hom surjective]

/-- Being two-generated is invariant under isomorphism. -/
theorem twoGenerated_of_mulEquiv {G H : Type*} [Group G] [Group H]
    (equivalence : G ≃* H) (generated : TwoGenerated H) : TwoGenerated G :=
  twoGenerated_of_surjective equivalence.symm.toMonoidHom equivalence.symm.surjective generated

/-- A cyclic group is two-generated. -/
theorem twoGenerated_of_closure_singleton {H : Type*} [Group H] (g : H)
    (generated : Subgroup.closure {g} = ⊤) : TwoGenerated H :=
  ⟨g, g, by simpa using generated⟩

/-- If `first, second ∈ K` generate the subgroup `K`, then they generate `K` as a group. -/
theorem closure_pair_mk_eq_top_of_closure_pair_eq {P : Type*} [Group P] (K : Subgroup P)
    (first second : P) (hfirst : first ∈ K) (hsecond : second ∈ K)
    (generated : Subgroup.closure {first, second} = K) :
    Subgroup.closure {(⟨first, hfirst⟩ : K), (⟨second, hsecond⟩ : K)} = ⊤ := by
  apply Subgroup.map_injective K.subtype_injective
  rw [MonoidHom.map_closure, Subgroup.map_top, Subgroup.range_subtype, Set.image_pair,
    Subgroup.coe_subtype]
  exact generated

/-- A subgroup generated by two of its elements is two-generated. -/
theorem twoGenerated_subgroup_of_closure_pair_eq {P : Type*} [Group P] (K : Subgroup P)
    (first second : P) (hfirst : first ∈ K) (hsecond : second ∈ K)
    (generated : Subgroup.closure {first, second} = K) : TwoGenerated K :=
  ⟨⟨first, hfirst⟩, ⟨second, hsecond⟩,
    closure_pair_mk_eq_top_of_closure_pair_eq K first second hfirst hsecond generated⟩

/-- A noncommutative simple group has trivial center. -/
theorem center_eq_bot_of_isSimpleGroup {G : Type*} [Group G] (hG : IsSimpleGroup G)
    (hnc : ¬ ∀ a b : G, a * b = b * a) : Subgroup.center G = ⊥ := by
  rcases (Subgroup.center G).normal_of_characteristic.eq_bot_or_eq_top with h | h
  · exact h
  · exact absurd (fun a b ↦ Subgroup.mem_center_iff.1 (h ▸ Subgroup.mem_top b) a) hnc

/-- A commutative simple group is two-generated (indeed cyclic). -/
theorem twoGenerated_of_isSimpleGroup_of_comm {G : Type*} [Group G] (hG : IsSimpleGroup G)
    (hc : ∀ a b : G, a * b = b * a) : TwoGenerated G := by
  obtain ⟨g, hg⟩ := exists_ne (1 : G)
  refine twoGenerated_of_closure_singleton g ?_
  have : (Subgroup.closure {g}).Normal := ⟨fun n _ h ↦ by
    rwa [show h * n * h⁻¹ = n by rw [hc h n, mul_inv_cancel_right]]⟩
  rcases this.eq_bot_or_eq_top with h | h
  · exact absurd (Subgroup.closure_eq_bot_iff.1 h (Set.mem_singleton g)) hg
  · exact h

/-- A simple group is noncommutative with trivial center, or commutative and two-generated. -/
theorem center_eq_bot_or_twoGenerated {G : Type*} [Group G] (hG : IsSimpleGroup G) :
    (¬ (∀ a b : G, a * b = b * a) ∧ Subgroup.center G = ⊥) ∨
      ((∀ a b : G, a * b = b * a) ∧ TwoGenerated G) := by
  by_cases h : ∀ a b : G, a * b = b * a
  · exact Or.inr ⟨h, twoGenerated_of_isSimpleGroup_of_comm hG h⟩
  · exact Or.inl ⟨h, center_eq_bot_of_isSimpleGroup hG h⟩

end CFSGCorollary
