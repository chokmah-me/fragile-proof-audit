module

public import CFSGCorollary.TwoGenerated.Basic
public import CFSG.Blueprint.NativeSporadic

/-!
# Unit groups of two-generated finite monoids

Most sporadic groups are realised in `CFSG.Blueprint.NativeSporadic` as the unit group of the
matrix monoid `seedMonoid` generated by two matrices over a finite field. If a finite monoid is
generated by `a` and `b`, then its unit group is generated by those of `a, b` that are units: in a
finite monoid a product is a unit only if each factor is.

## Main results

* `CFSGCorollary.twoGenerated_units_of_closure_eq_top`: the unit group of a finite monoid
  generated by two elements is two-generated.
* `CFSGCorollary.twoGenerated_units_seedMonoid`: the unit groups `(seedMonoid p d mode s₁ s₂)ˣ`
  are two-generated.
-/

@[expose] public section

namespace CFSGCorollary

/-- The unit group of a finite monoid generated by two elements is two-generated. -/
theorem twoGenerated_units_of_closure_eq_top {N : Type*} [Monoid N] [Finite N] (a b : N)
    (generated : Submonoid.closure {a, b} = ⊤) : TwoGenerated Nˣ := by
  classical
  let u : Nˣ := if h : IsUnit a then h.unit else 1
  let v : Nˣ := if h : IsUnit b then h.unit else 1
  refine ⟨u, v, eq_top_iff.2 fun x _ ↦ ?_⟩
  have key (y : N) (hy : y ∈ Submonoid.closure {a, b}) (h : IsUnit y) :
      h.unit ∈ Subgroup.closure ({u, v} : Set Nˣ) := by
    induction hy using Submonoid.closure_induction with
    | mem z hz =>
      rcases hz with rfl | rfl
      · rw [show h.unit = u by simp [u, h]]
        exact Subgroup.subset_closure (by simp)
      · rw [show h.unit = v by simp [v, h]]
        exact Subgroup.subset_closure (by simp)
    | one =>
      rw [show h.unit = 1 by ext; simp]
      exact one_mem _
    | mul y z _ _ hy hz =>
      obtain ⟨hy', hz'⟩ := IsUnit.mul_iff.mp h
      rw [show h.unit = hy'.unit * hz'.unit by ext; simp]
      exact mul_mem (hy hy') (hz hz')
  simpa using key (x : N) (by rw [generated]; trivial) x.isUnit

/-- The units of the submonoid generated by two elements of a finite monoid form a two-generated
group. -/
theorem twoGenerated_units_closure_pair {M : Type*} [Monoid M] [Finite M] (A B : M) :
    TwoGenerated (Submonoid.closure ({A, B} : Set M))ˣ := by
  refine twoGenerated_units_of_closure_eq_top
    (⟨A, Submonoid.subset_closure (by simp)⟩ : Submonoid.closure ({A, B} : Set M))
    ⟨B, Submonoid.subset_closure (by simp)⟩ ?_
  rw [eq_top_iff]
  rintro ⟨x, hx⟩ -
  induction hx using Submonoid.closure_induction with
  | mem z hz =>
    rcases hz with rfl | rfl
    · exact Submonoid.subset_closure (by simp)
    · exact Submonoid.subset_closure (by simp)
  | one => exact one_mem _
  | mul y z hy hz ihy ihz => exact mul_mem ihy ihz

/-- The unit group of the matrix monoid `seedMonoid p d mode s₁ s₂` is two-generated. -/
theorem twoGenerated_units_seedMonoid (p d mode : ℕ) (hp : p ≠ 0) (s₁ s₂ : String) :
    TwoGenerated (CFSG.Blueprint.NativeSporadic.seedMonoid p d mode s₁ s₂)ˣ := by
  have : NeZero p := ⟨hp⟩
  exact twoGenerated_units_closure_pair _ _

end CFSGCorollary
