module

public import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Presentation
public import CFSGCorollary.TwoGenerated.Basic
public import CFSG.Blueprint.NativeSporadic
import CFSG.Sporadic.Bridge.Catalogue
import CFSGCorollary.Sporadic.Monster.Presentation
import CFSGCorollary.Sporadic.Monster.Y443
import CFSGCorollary.Sporadic.Units

/-!
# The sporadic groups are two-generated

TauCeti defines each sporadic group `s.Group` by a presentation. For `s ≠ M`, `AxiomMath/CFSG`
identifies `s.Group` with a concrete carrier `CFSG.Blueprint.NativeSporadic.Carrier s`, which is
either a permutation group given by two generating permutations (the Mathieu groups) or the unit
group of a matrix monoid generated by two matrices; both are two-generated. For the Monster,
`s.Group` is isomorphic to the group `CFSG.Sporadic.Bridge.Y443.TCG`
(`TauCeti.Sporadic.Monster.mulEquivPresentedGroupCoxeterAppend`), which is two-generated by
`CFSGCorollary.twoGenerated_tcg`.

## Main results

* `CFSGCorollary.twoGenerated_sporadic`: every sporadic group is two-generated.
-/

@[expose] public section

namespace CFSGCorollary

/-- A subgroup generated by two elements is two-generated. -/
theorem twoGenerated_closure_pair {P : Type*} [Group P] (σ τ : P) :
    TwoGenerated (Subgroup.closure ({σ, τ} : Set P)) :=
  twoGenerated_subgroup_of_closure_pair_eq _ σ τ (Subgroup.subset_closure (by simp))
    (Subgroup.subset_closure (by simp)) rfl

/-- The concrete carrier of each sporadic group other than the Monster is two-generated. -/
theorem twoGenerated_nativeSporadicCarrier (s : TauCeti.SporadicName) (hs : s ≠ .M) :
    TwoGenerated (CFSG.Blueprint.NativeSporadic.Carrier s) := by
  cases s <;> first
    | exact absurd rfl hs
    | exact twoGenerated_closure_pair _ _
    | exact twoGenerated_units_seedMonoid _ _ _ (by norm_num) _ _

/-- Every sporadic group other than the Monster is two-generated. -/
theorem twoGenerated_sporadic_of_ne_monster (s : TauCeti.SporadicName) (hs : s ≠ .M) :
    TwoGenerated s.Group := by
  obtain ⟨equivalence⟩ := CFSG.Sporadic.Bridge.nonempty_carrier_mulEquiv_group s
  exact twoGenerated_of_mulEquiv equivalence.symm (twoGenerated_nativeSporadicCarrier s hs)

/-- The Monster `TauCeti.SporadicName.M.Group` is two-generated. -/
theorem twoGenerated_monster : TwoGenerated TauCeti.SporadicName.M.Group := by
  change TwoGenerated TauCeti.SporadicName.M.presentation.Group
  rw [sporadicName_M_presentation_eq]
  exact twoGenerated_of_mulEquiv TauCeti.Sporadic.Monster.mulEquivPresentedGroupCoxeterAppend
    twoGenerated_tcg

/-- Every sporadic group is two-generated. -/
theorem twoGenerated_sporadic (name : TauCeti.SporadicName) :
    TwoGenerated name.Group := by
  by_cases h : name = .M
  · subst h
    exact twoGenerated_monster
  · exact twoGenerated_sporadic_of_ne_monster name h

end CFSGCorollary
