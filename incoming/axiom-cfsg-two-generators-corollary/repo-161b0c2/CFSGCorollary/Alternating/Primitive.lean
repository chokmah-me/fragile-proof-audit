module

public import CFSGCorollary.Alternating.Generators
public import Mathlib.GroupTheory.GroupAction.Primitive

/-!
# The two generators act primitively

Let `Γ = ⟨a_n, b_n⟩ ≤ Sym(n)` be the subgroup generated by the permutations
`CFSGCorollary.alternatingGeneratorA n` and `CFSGCorollary.alternatingGeneratorB n`, for `n ≥ 5`.
This file shows that `Γ` acts primitively on `Fin n`: it is transitive (powers of `b_n` and `a_n`
move `0` everywhere), and any block containing the base point is trivial. For odd `n` a nontrivial
block containing `0` contains `1` or `2`, hence all multiples of it under the rotation `b_n`; for
even `n` the stabiliser of `n - 1` contains the `(n-1)`-cycle `b_n`.

## Main results

* `CFSGCorollary.isPretransitive_closure_alternatingGenerators`: `Γ` is transitive.
* `CFSGCorollary.isPreprimitive_closure_alternatingGenerators`: `Γ` is primitive.
-/

@[expose] public section

namespace CFSGCorollary

/-- The group generated by `a_n` and `b_n` acts transitively on `Fin n`. -/
theorem isPretransitive_closure_alternatingGenerators (n : ℕ) [NeZero n] (h : 5 ≤ n) :
    MulAction.IsPretransitive
      (Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n}) (Fin n) := by
  have hA : alternatingGeneratorA n ∈
      Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n} :=
    Subgroup.subset_closure (by simp)
  have hB : alternatingGeneratorB n ∈
      Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n} :=
    Subgroup.subset_closure (by simp)
  have key (x : Fin n) : ∃ g : Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n},
      g • (0 : Fin n) = x := by
    rcases Nat.even_or_odd n with hn | hn
    · by_cases hx : x.val ≤ n - 2
      · obtain ⟨-, -, -, -, -, hb⟩ := alternatingGenerator_apply_of_even n h hn
        refine ⟨⟨alternatingGeneratorB n ^ x.val, Subgroup.pow_mem _ hB _⟩, ?_⟩
        change (alternatingGeneratorB n ^ x.val) 0 = x
        rw [hb _ hx, Fin.ofNat_val_eq_self]
      · obtain ⟨ha, -⟩ := alternatingGenerator_apply_of_even n h hn
        refine ⟨⟨alternatingGeneratorA n, hA⟩, ?_⟩
        change alternatingGeneratorA n 0 = x
        rw [ha]
        apply Fin.ext
        rw [val_ofNat_of_lt n (by omega)]
        omega
    · obtain ⟨-, -, -, -, hb⟩ := alternatingGenerator_apply_of_odd n h hn
      refine ⟨⟨alternatingGeneratorB n ^ x.val, Subgroup.pow_mem _ hB _⟩, ?_⟩
      change (alternatingGeneratorB n ^ x.val) 0 = x
      rw [hb, Fin.ofNat_val_eq_self]
  refine ⟨fun x y ↦ ?_⟩
  obtain ⟨g, hg⟩ := key x
  obtain ⟨g', hg'⟩ := key y
  exact ⟨g' * g⁻¹, by rw [← hg', ← hg, mul_smul, inv_smul_smul]⟩

private theorem forall_apply_mem_of_isBlock (n : ℕ) [NeZero n] (B : Set (Fin n))
    (hB : MulAction.IsBlock
      (Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n}) B)
    {g : Equiv.Perm (Fin n)}
    (hg : g ∈ Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n})
    {y : Fin n} (hy : y ∈ B) (hgy : g y ∈ B) : ∀ z ∈ B, g z ∈ B := by
  have h := MulAction.IsBlock.smul_eq_of_mem hB
    (g := (⟨g, hg⟩ : Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n})) hy hgy
  intro z hz
  rw [← h]
  exact Set.smul_mem_smul_set hz

private theorem alternatingGeneratorA_mem_closure (n : ℕ) [NeZero n] :
    alternatingGeneratorA n ∈ Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n} :=
  Subgroup.subset_closure (by simp)

private theorem alternatingGeneratorB_mem_closure (n : ℕ) [NeZero n] :
    alternatingGeneratorB n ∈ Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n} :=
  Subgroup.subset_closure (by simp)

private theorem ofNat_mul_mem_of_odd (n : ℕ) [NeZero n] (h : 5 ≤ n) (hn : Odd n) (B : Set (Fin n))
    (hB : MulAction.IsBlock
      (Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n}) B)
    (h0 : (0 : Fin n) ∈ B) (m : ℕ) (hm : Fin.ofNat n m ∈ B) (k : ℕ) :
    Fin.ofNat n (m * k) ∈ B := by
  obtain ⟨-, -, -, -, hb⟩ := alternatingGenerator_apply_of_odd n h hn
  have hst := forall_apply_mem_of_isBlock n B hB
    (Subgroup.pow_mem _ (alternatingGeneratorB_mem_closure n) m) h0 (by rw [hb]; exact hm)
  induction k with
  | zero => simpa using h0
  | succ k ih =>
    have h1 := hst _ ih
    rwa [← hb (m * k), ← Equiv.Perm.mul_apply, ← pow_add, hb,
      show m + m * k = m * (k + 1) by ring] at h1

private theorem eq_univ_of_isBlock_of_odd (n : ℕ) [NeZero n] (h : 5 ≤ n) (hn : Odd n)
    (B : Set (Fin n))
    (hB : MulAction.IsBlock
      (Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n}) B)
    (h0 : (0 : Fin n) ∈ B) (hns : ¬ B.Subsingleton) : B = Set.univ := by
  obtain ⟨ha0, -, -, ha3, -⟩ := alternatingGenerator_apply_of_odd n h hn
  obtain ⟨x, hxB, hx0⟩ : ∃ x ∈ B, x ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hns fun a ha b hb ↦ by rw [hcon a ha, hcon b hb]
  have key : Fin.ofNat n 1 ∈ B ∨ Fin.ofNat n 2 ∈ B := by
    by_cases hx3 : 3 ≤ x.val
    · right
      have := forall_apply_mem_of_isBlock n B hB (alternatingGeneratorA_mem_closure n) hxB
        (by rw [ha3 x hx3]; exact hxB) 0 h0
      rwa [ha0] at this
    · have hxv : x.val ≠ 0 := fun hh ↦ hx0 (Fin.ext hh)
      rw [← Fin.ofNat_val_eq_self x] at hxB
      rcases (by omega : x.val = 1 ∨ x.val = 2) with e | e
      · exact .inl (e ▸ hxB)
      · exact .inr (e ▸ hxB)
  have hall (m : ℕ) (hm : Fin.ofNat n m ∈ B) (hsurj : ∀ y : Fin n, ∃ k, Fin.ofNat n (m * k) = y) :
      B = Set.univ := by
    refine Set.eq_univ_of_forall fun y ↦ ?_
    obtain ⟨k, rfl⟩ := hsurj y
    exact ofNat_mul_mem_of_odd n h hn B hB h0 m hm k
  rcases key with k1 | k2
  · exact hall 1 k1 fun y ↦ ⟨y.val, by simp⟩
  · refine hall 2 k2 fun y ↦ ⟨y.val * ((n + 1) / 2), ?_⟩
    have hodd := Nat.odd_iff.mp hn
    have e : 2 * ((n + 1) / 2) = n + 1 := by omega
    have e2 : 2 * (y.val * ((n + 1) / 2)) = y.val * n + y.val := by
      calc 2 * (y.val * ((n + 1) / 2)) = y.val * (2 * ((n + 1) / 2)) := by ring
        _ = _ := by rw [e]; ring
    apply Fin.ext
    rw [Fin.val_ofNat, e2, Nat.mul_add_mod_self_right]
    exact Nat.mod_eq_of_lt y.isLt

private theorem eq_univ_of_isBlock_of_even (n : ℕ) [NeZero n] (h : 5 ≤ n) (hn : Even n)
    (B : Set (Fin n))
    (hB : MulAction.IsBlock
      (Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n}) B)
    (hx : Fin.ofNat n (n - 1) ∈ B) (hns : ¬ B.Subsingleton) : B = Set.univ := by
  obtain ⟨-, -, -, -, hfix, hb⟩ := alternatingGenerator_apply_of_even n h hn
  have hv := val_ofNat_of_lt n (k := n - 1) (by omega)
  obtain ⟨x, hxB, hx0⟩ : ∃ x ∈ B, x ≠ Fin.ofNat n (n - 1) := by
    by_contra hcon
    push Not at hcon
    exact hns fun a ha b hb ↦ by rw [hcon a ha, hcon b hb]
  have hxle : x.val ≤ n - 2 := by
    have : x.val ≠ n - 1 := fun hh ↦ hx0 (Fin.ext (by rw [hv]; exact hh))
    have := x.isLt
    omega
  have hxeq : (alternatingGeneratorB n ^ x.val) 0 = x := by rw [hb _ hxle, Fin.ofNat_val_eq_self]
  have fixpow (g : Equiv.Perm (Fin n))
      (hg : g ∈ Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n})
      (hgf : g (Fin.ofNat n (n - 1)) = Fin.ofNat n (n - 1)) : ∀ z ∈ B, g z ∈ B :=
    forall_apply_mem_of_isBlock n B hB hg hx (by rw [hgf]; exact hx)
  have hb' (k : ℕ) :
      (alternatingGeneratorB n ^ k) (Fin.ofNat n (n - 1)) = Fin.ofNat n (n - 1) := by
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ', Equiv.Perm.mul_apply, ih, hfix]
  have h0B : (0 : Fin n) ∈ B := by
    have hg : (alternatingGeneratorB n ^ x.val)⁻¹ ∈
        Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n} :=
      Subgroup.inv_mem _ (Subgroup.pow_mem _ (alternatingGeneratorB_mem_closure n) _)
    have := fixpow _ hg (by rw [Equiv.Perm.inv_eq_iff_eq, hb']) x hxB
    have e : (alternatingGeneratorB n ^ x.val)⁻¹ x = 0 := by
      rw [Equiv.Perm.inv_def, Equiv.symm_apply_eq]
      exact hxeq.symm
    rwa [e] at this
  refine Set.eq_univ_of_forall fun y ↦ ?_
  by_cases hy : y.val ≤ n - 2
  · have := fixpow (alternatingGeneratorB n ^ y.val)
      (Subgroup.pow_mem _ (alternatingGeneratorB_mem_closure n) _) (hb' _) 0 h0B
    rwa [hb _ hy, Fin.ofNat_val_eq_self] at this
  · have : y = Fin.ofNat n (n - 1) := by
      apply Fin.ext
      rw [hv]
      have := y.isLt
      omega
    rwa [this]

/-- A block for `⟨a_n, b_n⟩` containing the base point is trivial. -/
theorem isTrivialBlock_of_isBlock_of_alternatingBasePoint_mem (n : ℕ) [NeZero n] (h : 5 ≤ n)
    (B : Set (Fin n))
    (hB : MulAction.IsBlock
      (Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n}) B)
    (hx : alternatingBasePoint n ∈ B) :
    MulAction.IsTrivialBlock B := by
  by_cases hs : B.Subsingleton
  · exact Or.inl hs
  · right
    unfold alternatingBasePoint at hx
    by_cases hn : Odd n
    · rw [ite_eq_left hn] at hx
      exact eq_univ_of_isBlock_of_odd n h hn B hB hx hs
    · rw [ite_eq_right hn] at hx
      exact eq_univ_of_isBlock_of_even n h (Nat.not_odd_iff_even.mp hn) B hB hx hs

/-- The group generated by `a_n` and `b_n` acts primitively on `Fin n`. -/
theorem isPreprimitive_closure_alternatingGenerators (n : ℕ) [NeZero n] (h : 5 ≤ n) :
    MulAction.IsPreprimitive
      (Subgroup.closure {alternatingGeneratorA n, alternatingGeneratorB n}) (Fin n) := by
  have := isPretransitive_closure_alternatingGenerators n h
  exact MulAction.IsPreprimitive.of_isTrivialBlock_base (alternatingBasePoint n)
    (fun {B} hx hB ↦ isTrivialBlock_of_isBlock_of_alternatingBasePoint_mem n h B hB hx)

end CFSGCorollary
